---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getLocalizedUrl } from '../i18n';
import { getPageSeo } from '../i18n/seo';

interface Props { lang: string; }
const { lang } = Astro.props;
const url = (path: string) => getLocalizedUrl(lang, path);
const seo = getPageSeo('work', lang);

const copy = {
  en: {
    breadcrumb: 'Home', eyebrow: 'Selected work', title: 'Real businesses. Digital work built to be used.',
    lead: 'A selection of live systems and public evidence reviews. QCT Studio responsibilities are stated only where they can be supported.',
    proofTitle: 'Evidence before claims.',
    proofText: 'We publish observable project scope, live outputs and verified responsibilities. Performance figures, awards and client outcomes are shown only when they can be supported.',
    caseStudy: 'Read case study', website: 'Visit live website', related: 'Related capability', review: 'Discuss a similar project',
    labels: { headwear: 'Multilingual e-commerce', misima: 'Live-site observation', ctseg: 'Venture trade platform', phiaderm: 'Public pre-launch status' },
    descriptions: {
      headwear: 'A multilingual store for performance and outdoor products, structured around clear product discovery and mobile shopping.',
      misima: 'An observable cosmetics and B2B website; QCT Studio authorship and project scope remain unverified.',
      ctseg: 'A live multilingual trade platform inside the wider founder-level venture system; agency scope is not claimed.',
      phiaderm: 'A public coming-soon status review; the live page credits RexCode and QCT Studio scope remains unverified.',
    },
  },
  sq: {
    breadcrumb: 'Ballina', eyebrow: 'Punë të përzgjedhura', title: 'Biznese reale. Punë digjitale e ndërtuar për t’u përdorur.',
    lead: 'Një përzgjedhje sistemesh aktive dhe shqyrtimesh publike. Përgjegjësitë e QCT Studio deklarohen vetëm kur mbështeten.',
    proofTitle: 'Dëshmi përpara pretendimeve.',
    proofText: 'Publikojmë vetëm fushën e dukshme të projektit, rezultatet aktive dhe përgjegjësitë e verifikuara. Shifrat, çmimet dhe rezultatet e klientëve paraqiten vetëm kur mund të mbështeten.',
    caseStudy: 'Lexoni studimin e rastit', website: 'Vizitoni faqen aktive', related: 'Aftësi e lidhur', review: 'Diskutoni një projekt të ngjashëm',
    labels: { headwear: 'E-commerce shumëgjuhësh', misima: 'Vëzhgim i faqes aktive', ctseg: 'Platformë tregtie venture', phiaderm: 'Status publik para lansimit' },
    descriptions: {
      headwear: 'Dyqan shumëgjuhësh për produkte performance dhe outdoor, i strukturuar për zbulim të qartë dhe blerje në celular.',
      misima: 'Faqe kozmetike dhe B2B e vëzhgueshme; autorësia dhe fusha e QCT Studio mbeten të paverifikuara.',
      ctseg: 'Platformë aktive shumëgjuhëshe brenda sistemit të sipërmarrjeve; nuk pretendohet fushë agjencie.',
      phiaderm: 'Shqyrtim publik coming-soon; faqja aktive krediton RexCode dhe fusha e QCT Studio mbetet e paverifikuar.',
    },
  },
  mk: {
    breadcrumb: 'Дома', eyebrow: 'Избрани проекти', title: 'Вистински бизниси. Дигитални решенија создадени за употреба.',
    lead: 'Избор од активни системи и јавни evidence reviews. Одговорностите на QCT Studio се наведуваат само кога можат да се поткрепат.',
    proofTitle: 'Докази пред тврдења.',
    proofText: 'Објавуваме видлив опфат на проектот, активни резултати и потврдени одговорности. Бројки, награди и деловни резултати се прикажуваат само кога можат да се поткрепат.',
    caseStudy: 'Прочитајте ја студијата', website: 'Посетете ја активната веб-страница', related: 'Поврзана услуга', review: 'Разговарајте за сличен проект',
    labels: { headwear: 'Повеќејазична е-трговија', misima: 'Live-site observation', ctseg: 'Venture trade platform', phiaderm: 'Јавен pre-launch статус' },
    descriptions: {
      headwear: 'Повеќејазична продавница за performance и outdoor производи, со јасно откривање производи и мобилно купување.',
      misima: 'Видлива cosmetics и B2B страница; QCT Studio authorship и scope остануваат непотврдени.',
      ctseg: 'Активна повеќејазична trade platform во founder-level venture системот; agency scope не се тврди.',
      phiaderm: 'Јавен coming-soon преглед; активната страница го кредитира RexCode, а QCT Studio scope е непотврден.',
    },
  },
  sr: {
    breadcrumb: 'Početna', eyebrow: 'Izabrani projekti', title: 'Pravi biznisi. Digitalni rad napravljen za stvarnu upotrebu.',
    lead: 'Izbor aktivnih sistema i javnih evidence pregleda. Odgovornosti QCT Studija navode se samo kada mogu da se potkrepe.',
    proofTitle: 'Dokazi pre tvrdnji.',
    proofText: 'Objavljujemo vidljiv obim projekta, aktivne rezultate i potvrđene odgovornosti. Brojke, nagrade i poslovni rezultati prikazuju se samo kada mogu da se potkrepe.',
    caseStudy: 'Pročitajte studiju', website: 'Posetite aktivni sajt', related: 'Povezana usluga', review: 'Razgovarajte o sličnom projektu',
    labels: { headwear: 'Višejezični e-commerce', misima: 'Posmatranje aktivnog sajta', ctseg: 'Venture trade platforma', phiaderm: 'Javni status pre lansiranja' },
    descriptions: {
      headwear: 'Višejezična prodavnica za performance i outdoor proizvode, organizovana za jasno otkrivanje proizvoda i mobilnu kupovinu.',
      misima: 'Vidljiv cosmetics i B2B sajt; autorstvo i obim QCT Studija ostaju nepotvrđeni.',
      ctseg: 'Aktivna višejezična trade platforma u founder-level venture sistemu; agency scope se ne tvrdi.',
      phiaderm: 'Javni coming-soon pregled; aktivna stranica kreditira RexCode, a QCT Studio scope nije potvrđen.',
    },
  },
};

const c = copy[lang as keyof typeof copy] ?? copy.en;
const projects = [
  { name: 'HEADWEAR', label: c.labels.headwear, description: c.descriptions.headwear, href: url('/work/headwear/'), external: 'https://www.head-wear.com/', capability: url('/e-commerce/'), featured: true },
  { name: 'CTSEG', label: c.labels.ctseg, description: c.descriptions.ctseg, href: url('/work/ctseg/'), external: 'https://ctseg.com.tr/en/', capability: url('/website-design/') },
  { name: 'Misima Group', label: c.labels.misima, description: c.descriptions.misima, href: url('/work/misima/'), external: 'https://www.misima.com.tr/', capability: url('/website-design/') },
  { name: 'Phiaderm', label: c.labels.phiaderm, description: c.descriptions.phiaderm, href: url('/work/phiaderm/'), external: 'https://www.phiaderm.com.tr/', capability: url('/e-commerce/') },
];
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} pageType="CollectionPage" breadcrumbLabel={c.eyebrow}>
  <Header slot="header" lang={lang} />
  <main class="qct-work">
    <section class="qct-work__hero">
      <div class="container">
        <p class="qct-work__breadcrumb"><a href={url('/')}>{c.breadcrumb}</a> / {c.eyebrow}</p>
        <p class="qct-work__eyebrow">{c.eyebrow}</p>
        <h1>{c.title}</h1>
        <p class="qct-work__lead">{c.lead}</p>
      </div>
    </section>

    <section class="qct-work__proof" aria-labelledby="qct-work-proof-title">
      <div class="container qct-work__proof-grid">
        <p class="qct-work__eyebrow">QCT Studio standard</p>
        <div>
          <h2 id="qct-work-proof-title">{c.proofTitle}</h2>
          <p>{c.proofText}</p>
        </div>
      </div>
    </section>

    <section class="qct-work__projects" aria-label={c.eyebrow}>
      <div class="container qct-work__grid">
        {projects.map((project, index) => (
          <article class:list={['qct-work__card', { 'qct-work__card--featured': project.featured }]}>
            <div class="qct-work__number">0{index + 1}</div>
            <p class="qct-work__label">{project.label}</p>
            <h2><a href={project.href}>{project.name}</a></h2>
            <p class="qct-work__description">{project.description}</p>
            <div class="qct-work__links">
              <a href={project.href}>{c.caseStudy}</a>
              <a href={project.external} target="_blank" rel="noopener">{c.website}</a>
              <a href={project.capability}>{c.related}</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="qct-work__cta">
      <div class="container qct-work__cta-inner">
        <h2>{c.review}</h2>
        <a class="qct-button qct-button--primary" href={`${url('/contact/')}#contact`}>{c.review}</a>
      </div>
    </section>
  </main>
  <Footer slot="footer" lang={lang} />
</BaseLayout>

<style>
  .qct-work { color: #17151a; background: #f4f0e8; }
  .qct-work__hero { padding: clamp(4rem, 7vw, 7rem) 0; border-bottom: 1px solid rgba(23, 21, 26, .14); }
  .qct-work__breadcrumb { margin: 0 0 3rem; font-weight: 700; }
  .qct-work__breadcrumb a { color: inherit; }
  .qct-work__eyebrow, .qct-work__label { color: #e75757; font-size: .78rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  .qct-work h1 { max-width: 900px; margin: .9rem 0 1.3rem; font-size: clamp(2.75rem, 5vw, 5.1rem); line-height: .98; letter-spacing: -.045em; }
  .qct-work__lead { max-width: 760px; margin: 0; color: #656066; font-size: clamp(1rem, 1.35vw, 1.2rem); line-height: 1.65; }
  .qct-work__proof { padding: clamp(2.6rem, 5vw, 4.8rem) 0; border-bottom: 1px solid rgba(23, 21, 26, .14); }
  .qct-work__proof-grid { display: grid; gap: 2rem; grid-template-columns: minmax(180px, .4fr) minmax(0, 1.6fr); }
  .qct-work__proof h2 { font-size: clamp(2rem, 4vw, 3.5rem); letter-spacing: -.04em; line-height: 1; margin: 0 0 1rem; }
  .qct-work__proof p { color: #656066; line-height: 1.7; margin: 0; max-width: 760px; }
  .qct-work__projects { padding: clamp(3rem, 5vw, 4.5rem) 0; background: #17151a; }
  .qct-work__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; padding: 1px; background: rgba(248, 245, 239, .16); }
  .qct-work__card { min-height: 320px; padding: clamp(1.5rem, 2.4vw, 2.25rem); color: #f8f5ef; background: #1d1a20; }
  .qct-work__card--featured { background: #251b29; }
  .qct-work__number { margin-bottom: 2.5rem; color: rgba(248, 245, 239, .38); font-weight: 800; }
  .qct-work__card h2 { margin: .75rem 0 1rem; font-size: clamp(1.75rem, 2.5vw, 2.5rem); line-height: 1; letter-spacing: -.035em; }
  .qct-work__card h2 a { color: inherit; text-decoration: none; }
  .qct-work__description { max-width: 520px; color: rgba(248, 245, 239, .68); line-height: 1.65; }
  .qct-work__links { display: flex; flex-wrap: wrap; gap: 1.1rem; margin-top: 1.5rem; }
  .qct-work__links a { color: #f8f5ef; font-weight: 750; text-underline-offset: .25rem; }
  .qct-work__cta { padding: clamp(3.5rem, 7vw, 6rem) 0; }
  .qct-work__cta-inner { align-items: center; display: flex; gap: 2rem; justify-content: space-between; }
  .qct-work__cta h2 { font-size: clamp(2rem, 4vw, 3.5rem); letter-spacing: -.04em; line-height: 1; margin: 0; max-width: 700px; }
  @media (max-width: 760px) {
    .qct-work__hero { padding: 3.5rem 0; }
    .qct-work__breadcrumb { margin-bottom: 2rem; }
    .qct-work h1 { font-size: clamp(2.35rem, 11vw, 3.15rem); }
    .qct-work__proof-grid, .qct-work__grid { grid-template-columns: 1fr; }
    .qct-work__card { min-height: auto; padding: 1.5rem; }
    .qct-work__number { margin-bottom: 2rem; }
    .qct-work__cta-inner { align-items: stretch; flex-direction: column; }
  }
</style>
