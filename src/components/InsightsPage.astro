---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getLocalizedUrl } from '../i18n';
import { insights, insightLabels, type InsightLocale } from '../data/insights';

interface Props { lang: InsightLocale; }
const { lang } = Astro.props;
const labels = insightLabels[lang];
const descriptions: Record<InsightLocale, string> = {
  en: 'Practical QCT Studio insights on websites, e-commerce, SEO, GEO, AI search visibility and digital growth across Balkan markets.',
  sq: 'Analiza praktike nga QCT Studio për faqe web, e-commerce, SEO, GEO, kërkim me AI dhe rritje digjitale në tregjet e Ballkanit.',
  mk: 'Практични анализи од QCT Studio за веб-страници, е-трговија, SEO, GEO, AI пребарување и дигитален раст на балканските пазари.',
  sr: 'Praktični QCT Studio uvidi o sajtovima, e-commerceu, SEO-u, GEO-u, AI pretrazi i digitalnom rastu na balkanskim tržištima.',
  ro: 'Analize practice QCT Studio despre website-uri, e-commerce, SEO, GEO, vizibilitate în căutarea AI și creștere digitală pe piețele din Balcani.',
  bg: 'Практични анализи от QCT Studio за сайтове, e-commerce, SEO, GEO, AI search visibility и дигитален растеж на балканските пазари.',
};
const intro: Record<InsightLocale, string> = {
  en: 'Practical perspectives on websites, visibility and digital systems for businesses across the Balkans.',
  sq: 'Perspektiva praktike për faqe interneti, dukshmëri dhe sisteme digjitale për bizneset në Ballkan.',
  mk: 'Практични перспективи за веб-страници, видливост и дигитални системи за бизнисите на Балканот.',
  sr: 'Praktične perspektive o sajtovima, vidljivosti i digitalnim sistemima za kompanije na Balkanu.',
  ro: 'Perspective practice despre website-uri, vizibilitate și sisteme digitale pentru afaceri din Balcani.',
  bg: 'Практични гледни точки за сайтове, видимост и дигитални системи за бизнеси на Балканите.',
};
const url = (path: string) => getLocalizedUrl(lang, path);
---
<BaseLayout title={`${labels.journal} — QCT Studio`} description={descriptions[lang]} lang={lang} pageType="CollectionPage">
  <Header slot="header" lang={lang} languagePath="/insights/" />
  
  <main class="insights-page">
    <div class="insights-glow" aria-hidden="true"></div>

    <section class="insights-hero" aria-labelledby="insights-title">
      <div class="container">
        <div class="insights-badge">
          <span class="insights-badge-dot"></span>
          <span>{labels.journal}</span>
        </div>
        <h1 id="insights-title" class="insights-title">{labels.section}</h1>
        <p class="insights-lead">{labels.latest}. {intro[lang]}</p>
      </div>
    </section>

    <section class="insights-list container" aria-labelledby="insights-list-title">
      <h2 id="insights-list-title" class="screen-reader-text">{labels.latest}</h2>
      <div class="insights-cards-grid">
        {insights.map((article) => (
          <article class="insight-card">
            <div class="insight-card__meta">
              <span class="meta-tag">{article.category}</span>
              <span class="meta-sep">/</span>
              <time datetime={article.publishedAt}>{article.publishedAt}</time>
              <span class="meta-sep">/</span>
              <span>{article.readTime}</span>
            </div>
            <div class="insight-card__body">
              <h2 class="insight-card__title">
                <a href={url(`/insights/${article.slug}/`)}>{article.title[lang]}</a>
              </h2>
              <p class="insight-card__desc">{article.excerpt[lang]}</p>
            </div>
            <a class="insight-card__arrow" href={url(`/insights/${article.slug}/`)} aria-label={`${article.title[lang]} →`}>
              <span>Read article</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>
  
  <Footer slot="footer" lang={lang} />
</BaseLayout>

<style>
  .insights-page {
    background: #07080b !important;
    color: #f3f4f6;
    min-height: 80vh;
    position: relative;
    overflow: hidden;
  }

  .insights-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(1000px, 92vw);
    height: 480px;
    background: radial-gradient(circle at 50% 20%, rgba(0, 245, 160, 0.05), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .insights-hero {
    position: relative;
    z-index: 1;
    padding: clamp(6.5rem, 10vw, 8.5rem) 0 clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .insights-hero .container {
    max-width: 900px;
    text-align: center;
  }

  .insights-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    border-radius: 999px;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    font-weight: 750;
    color: #9ca3af;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .insights-badge-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #00f5a0;
    box-shadow: 0 0 6px #00f5a0;
  }

  .insights-title {
    margin: 0 0 1rem;
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: #ffffff;
  }

  .insights-lead {
    max-width: 600px;
    margin: 0 auto;
    color: #9ca3af;
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    line-height: 1.65;
  }

  .insights-list {
    position: relative;
    z-index: 1;
    max-width: 1040px;
    padding-block: 3.5rem 8rem;
  }

  .insights-cards-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .insight-card {
    background: #0d0f15;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .insight-card:hover {
    border-color: rgba(0, 245, 160, 0.35);
    transform: translateY(-2px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(0, 245, 160, 0.08);
  }

  .insight-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    color: #64748b;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .meta-tag {
    color: #00f5a0;
    font-weight: 750;
  }

  .meta-sep {
    color: rgba(255, 255, 255, 0.15);
  }

  .insight-card__title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 750;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .insight-card__title a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .insight-card:hover .insight-card__title a {
    color: #00f5a0;
  }

  .insight-card__desc {
    margin: 0;
    color: #94a3b8;
    font-size: 0.98rem;
    line-height: 1.65;
    max-width: 820px;
  }

  .insight-card__arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #00f5a0;
    font-family: ui-monospace, monospace;
    font-size: 0.74rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: all 0.2s ease;
    margin-top: 0.25rem;
    width: fit-content;
  }

  .insight-card__arrow:hover {
    gap: 0.65rem;
    color: #26fbb1;
  }
</style>
