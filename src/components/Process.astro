---
import { useTranslations } from '../i18n';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  { number: "01", title: t("Understand"), text: t("We learn about your business, your customers and your goals before anything is designed.") },
  { number: "02", title: t("Plan"), text: t("We organise the structure, content and user journey before development begins.") },
  { number: "03", title: t("Design"), text: t("Every page is designed around clarity, trust and ease of use.") },
  { number: "04", title: t("Build"), text: t("Fast, responsive and carefully developed for every screen size.") },
  { number: "05", title: t("Launch"), text: t("After testing everything, your new website goes live with a smooth handover.") },
];
---
<section id="process" class="qct-section qct-process" aria-labelledby="qct-process-title">
<div class="container">
<div class="qct-section__header">
<p class="qct-section__eyebrow">{t('OUR PROCESS')}</p>
<h2 id="qct-process-title" class="qct-section__title">
{t('A straightforward process from the first conversation to launch.')}
</h2>
<p class="qct-section__lead">
{t('We keep things simple.')} {t("You'll always know what we're working on, what's coming next and why every decision is being made.")}
</p>
</div>

<div class="qct-process__grid">
{steps.map((step) => (
<article class="qct-process-card">
<span class="qct-process-card__number">{step.number}</span>
<h3>{step.title}</h3>
<p>{step.text}</p>
</article>
))}
</div>

<p class="qct-section__lead qct-process__footnote">
{t('No unnecessary complexity. Just a process that works.')}
</p>
</div>
</section>

<style>
.qct-process {
padding-block: var(--qct-home-section-space, 5rem);
border-top: 1px solid rgba(255, 255, 255, 0.08);
}
.qct-section__header {
max-width: 640px;
margin-bottom: 3rem;
}
.qct-section__eyebrow {
color: var(--qct-accent);
font-size: 0.85rem;
font-weight: 700;
letter-spacing: 0.08em;
text-transform: uppercase;
margin-bottom: 0.75rem;
}
.qct-section__title {
font-size: clamp(1.75rem, 3.5vw, 2.5rem);
line-height: 1.2;
margin-bottom: 1rem;
}
.qct-section__lead {
opacity: 0.75;
line-height: 1.6;
}
.qct-process__grid {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
gap: 1.5rem;
}
.qct-process-card {
padding: 1.75rem 1.5rem;
border: 1px solid rgba(255, 255, 255, 0.08);
border-radius: 16px;
background: rgba(255, 255, 255, 0.02);
}
.qct-process-card__number {
display: block;
font-size: 1.5rem;
font-weight: 700;
color: var(--qct-accent);
margin-bottom: 0.75rem;
}
.qct-process-card h3 {
font-size: 1.1rem;
margin-bottom: 0.5rem;
}
.qct-process-card p {
opacity: 0.75;
font-size: 0.92rem;
line-height: 1.5;
}
.qct-process__footnote {
margin-top: 2.5rem;
}
</style>
