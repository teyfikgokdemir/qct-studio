---
{copy && (
<section class="qct-estimator" id="project-estimator" aria-labelledby="project-estimator-title">
  <div class="container qct-estimator__grid">
    <div class="qct-estimator__intro">
      <div class="qct-estimator__badge"><span></span>{copy.availability}</div>
      <p class="qct-estimator__eyebrow">{copy.eyebrow}</p>
      <h2 id="project-estimator-title">{copy.title}</h2>
      <p>{copy.lead}</p>
      <div class="qct-estimator__offer">
        <strong>-50%</strong>
        <span>{copy.note}</span>
      </div>
      <small>{copy.qualifier}</small>
    </div>

    <div class="qct-estimator__panel" data-project-estimator data-services={JSON.stringify(copy.services)} data-scopes={JSON.stringify(copy.scopes)} data-monthly-label={copy.monthly} data-campaign-default={copy.campaign}>
      <label>
        <span>{copy.project}</span>
        <select data-estimator-service>
          {copy.services.map(([name], index) => <option value={index}>{name}</option>)}
        </select>
      </label>
      <label>
        <span>{copy.scope}</span>
        <select data-estimator-scope>
          {copy.scopes.map(([name], index) => <option value={index}>{name}</option>)}
        </select>
      </label>

      <div class="qct-estimator__result">
        <div><span>{copy.standard}</span><strong data-standard-price>€1,490</strong></div>
        <div class="qct-estimator__campaign"><span data-campaign-label>{copy.campaign}</span><strong data-campaign-price>€745</strong></div>
        <div><span>{copy.saving}</span><strong data-saving>€745</strong></div>
      </div>

      <a class="qct-estimator__cta" href={contactUrl} data-qct-cta="contact" data-cta-location="homepage-estimator">{copy.cta}</a>
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('[data-project-estimator]').forEach((root) => {
      const services = JSON.parse(root.dataset.services || '[]');
      const scopes = JSON.parse(root.dataset.scopes || '[]');
      const service = root.querySelector('[data-estimator-service]');
      const scope = root.querySelector('[data-estimator-scope]');
      const standard = root.querySelector('[data-standard-price]');
      const campaign = root.querySelector('[data-campaign-price]');
      const saving = root.querySelector('[data-saving]');
      const campaignLabel = root.querySelector('[data-campaign-label]');
      const euro = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
      const update = () => {
        const base = Number(services[Number(service.value)]?.[1] || 0);
        const multiplier = Number(scopes[Number(scope.value)]?.[1] || 1);
        const total = Math.round(base * multiplier / 10) * 10;
        const mode = services[Number(service.value)]?.[2] || 'project';
        const recurring = mode === 'monthly';
        const offer = recurring ? total : Math.round((total * 0.5) / 10) * 10;
        root.classList.toggle('is-recurring', recurring);
        standard.textContent = euro.format(total);
        campaign.textContent = recurring ? euro.format(total) + ' / mo' : euro.format(offer);
        campaignLabel.textContent = recurring ? (root.dataset.monthlyLabel || 'Monthly service') : (root.dataset.campaignDefault || 'Limited launch offer');
        saving.textContent = recurring ? '—' : euro.format(total - offer);
      };
      service.addEventListener('change', update);
      scope.addEventListener('change', update);
      update();
    });
  </script>
</section>
)}

<style>
.qct-estimator{padding:clamp(4rem,7vw,7rem) 0;border-block:1px solid rgba(23,21,26,.08);background:linear-gradient(180deg,rgba(231,87,87,.035),rgba(255,255,255,0))}
.qct-estimator__grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(420px,1.1fr);gap:clamp(2rem,6vw,6rem);align-items:center}
.qct-estimator__badge{display:inline-flex;align-items:center;gap:.5rem;padding:.45rem .7rem;border:1px solid rgba(23,21,26,.1);border-radius:999px;font-size:.7rem;font-weight:750;margin-bottom:1.2rem}
.qct-estimator__badge span{width:.45rem;height:.45rem;border-radius:50%;background:#e75757;box-shadow:0 0 0 4px rgba(231,87,87,.11)}
.qct-estimator__eyebrow{font-size:.72rem;letter-spacing:.16em;font-weight:800;color:#e75757;margin:0 0 .8rem}
.qct-estimator__intro h2{font-size:clamp(2.4rem,5vw,4.8rem);line-height:.98;letter-spacing:-.045em;max-width:11ch;margin:0}
.qct-estimator__intro>p{max-width:620px;line-height:1.7;opacity:.72;margin:1.4rem 0}
.qct-estimator__offer{display:flex;align-items:center;gap:1rem;padding:1rem 1.1rem;border-radius:16px;background:#17151a;color:#fff;max-width:580px}
.qct-estimator__offer strong{font-size:1.7rem;color:#ff6262}
.qct-estimator__offer span{font-size:.9rem;line-height:1.45}
.qct-estimator__intro small{display:block;max-width:620px;line-height:1.5;opacity:.55;margin-top:.8rem}
.qct-estimator__panel{padding:clamp(1.4rem,3vw,2.2rem);border:1px solid rgba(23,21,26,.09);border-radius:24px;background:rgba(255,255,255,.6);box-shadow:0 24px 80px rgba(28,16,34,.08)}
.qct-estimator__panel label{display:grid;gap:.5rem;margin-bottom:1rem;font-size:.76rem;font-weight:800;letter-spacing:.03em}
.qct-estimator__panel select{width:100%;min-height:52px;padding:0 1rem;border:1px solid rgba(23,21,26,.14);border-radius:12px;background:#fff;color:#17151a;font:inherit}
.qct-estimator__result{display:grid;gap:.65rem;margin:1.3rem 0}
.qct-estimator__result>div{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1rem;border-radius:13px;background:rgba(23,21,26,.035)}
.qct-estimator__result span{font-size:.77rem;opacity:.65}.qct-estimator__result strong{font-size:1.1rem}
.qct-estimator__campaign{background:#17151a!important;color:#fff}.qct-estimator__campaign strong{font-size:1.6rem;color:#ff6262}
.qct-estimator__cta{display:flex;justify-content:center;align-items:center;min-height:50px;border-radius:999px;background:#9f3030;color:#fff;text-decoration:none;font-weight:800}
@media(max-width:900px){.qct-estimator__grid{grid-template-columns:1fr}.qct-estimator__intro h2{max-width:15ch}}
@media(max-width:560px){.qct-estimator{padding:3.2rem 0}.qct-estimator__panel{padding:1.15rem;border-radius:18px}.qct-estimator__offer{align-items:flex-start;flex-direction:column;gap:.35rem}.qct-estimator__result>div{align-items:flex-end}.qct-estimator__result span{max-width:56%}}
</style>

<style>
.qct-estimator__panel.is-recurring .qct-estimator__result>div:first-child,
.qct-estimator__panel.is-recurring .qct-estimator__result>div:last-child{display:none}
.qct-estimator__panel.is-recurring .qct-estimator__campaign{margin-top:.35rem}
</style>
