---
{copy && (
<section class="qct-estimator-elite" id="project-estimator" aria-labelledby="project-estimator-title">
  <div class="container qct-estimator-elite__grid">
    <div class="qct-estimator-elite__intro">
      <div class="qct-estimator-elite__badge">
        <span class="badge-pulse"></span>
        {copy.availability}
      </div>
      <p class="qct-estimator-elite__eyebrow">{copy.eyebrow}</p>
      <h2 id="project-estimator-title" class="qct-estimator-elite__title">{copy.title}</h2>
      <p class="qct-estimator-elite__lead">{copy.lead}</p>
      
      <div class="qct-estimator-elite__guarantee">
        <div class="guarantee-icon" aria-hidden="true">⚡</div>
        <div class="guarantee-text">
          <strong>{copy.guaranteeTitle}</strong>
          <span>{copy.note}</span>
        </div>
      </div>
      
      <small class="qct-estimator-elite__qualifier">{copy.qualifier}</small>
    </div>

    <div class="qct-estimator-elite__panel" data-project-estimator data-services={JSON.stringify(copy.services)} data-scopes={JSON.stringify(copy.scopes)} data-monthly-label={copy.monthly} data-monthly-suffix={copy.monthlySuffix} data-campaign-default={copy.campaign}>
      <label class="form-group">
        <span class="form-label">{copy.project}</span>
        <div class="select-wrapper">
          <select data-estimator-service class="form-select">
            {copy.services.map(([name], index) => <option value={index}>{name}</option>)}
          </select>
        </div>
      </label>

      <label class="form-group">
        <span class="form-label">{copy.scope}</span>
        <div class="select-wrapper">
          <select data-estimator-scope class="form-select">
            {copy.scopes.map(([name], index) => <option value={index}>{name}</option>)}
          </select>
        </div>
      </label>

      <div class="qct-estimator-elite__result">
        <div class="result-box result-box--standard">
          <span>{copy.standard}</span>
          <strong data-standard-price>€990</strong>
        </div>
        <div class="result-box result-box--highlight">
          <span data-campaign-label>{copy.campaign}</span>
          <strong data-campaign-price class="text-emerald">€990</strong>
        </div>
      </div>

      <a class="btn-estimator-cta" href={contactUrl} data-qct-cta="contact" data-cta-location="homepage-estimator">
        <span>{copy.cta}</span>
      </a>
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('[data-project-estimator]').forEach((root) => {
      const services = JSON.parse(root.dataset.services || '[]');
      const scopes = JSON.parse(root.dataset.scopes || '[]');
      const service = root.querySelector('[data-estimator-service]');
      const scope = root.querySelector('[data-estimator-scope]');
      const standard = root.querySelector('[data-standard-price]');
      const campaign = root.querySelector('[data-campaign-price]');
      const campaignLabel = root.querySelector('[data-campaign-label]');
      const eur = new Intl.NumberFormat('en-IE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
      
      const update = () => {
        const base = Number(services[Number(service.value)]?.[1] || 0);
        const multiplier = Number(scopes[Number(scope.value)]?.[1] || 1);
        const total = Math.round(base * multiplier / 10) * 10;
        const mode = services[Number(service.value)]?.[2] || 'project';
        const recurring = mode === 'monthly';
        root.classList.toggle('is-recurring', recurring);
        standard.textContent = eur.format(total);
        campaign.textContent = recurring ? eur.format(total) + (root.dataset.monthlySuffix || ' / mo') : eur.format(total);
        campaignLabel.textContent = recurring ? (root.dataset.monthlyLabel || 'Monthly Retainer') : (root.dataset.campaignDefault || 'Verified Sprint Rate');
      };
      service.addEventListener('change', update);
      scope.addEventListener('change', update);
      update();
    });
  </script>
</section>
)}

<style>
