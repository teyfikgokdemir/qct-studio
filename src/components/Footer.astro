---
import { useTranslations, getLocalizedUrl } from '../i18n';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---
<footer class="qct-footer">
<div class="container qct-footer__inner">
<p>{t('&copy; 2026 QCT Studio')}. {t('All rights reserved.')}</p>
<div class="qct-footer__links">
<a href={getLocalizedUrl(lang, '/services/')}>{t('Services')}</a>
<a href={getLocalizedUrl(lang, '/about/')}>{t('About')}</a>
<a href={getLocalizedUrl(lang, '/careers/')}>{t('Careers')}</a>
<a href={getLocalizedUrl(lang, '/contact/')}>{t('Contact')}</a>
<a href={getLocalizedUrl(lang, '/privacy-policy/')}>{t('Privacy Policy')}</a>
<a href={getLocalizedUrl(lang, '/cookie-policy/')}>{t('Cookie Policy')}</a>
<a href={getLocalizedUrl(lang, '/terms-conditions/')}>{t('Terms & Conditions')}</a>
</div>
</div>
</footer>

<style>
.qct-footer {
border-top: 1px solid rgba(255, 255, 255, 0.08);
padding-block: 2rem;
margin-top: 4rem;
}
.qct-footer__inner {
display: flex;
align-items: center;
justify-content: space-between;
flex-wrap: wrap;
gap: 1rem;
font-size: 0.9rem;
opacity: 0.7;
}
.qct-footer__links {
display: flex;
flex-wrap: wrap;
gap: 1.25rem;
}
.qct-footer__links a {
color: var(--qct-fg);
text-decoration: none;
}
.qct-footer__links a:hover {
color: var(--qct-accent);
}
</style>
