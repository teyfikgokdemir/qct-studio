const url=(path:string)=>getLocalizedUrl(lang,path);
const schema={
  '@context':'https://schema.org','@type':'Service',
  name: copy.eyebrow, description: copy.description,
  provider:{'@id':'https://qctstudio.com/#organization'},
  areaServed:['Albania','North Macedonia','Kosovo','Serbia','Romania','Bulgaria'],
  url:new URL(url('/dynamic-seo/'),'https://qctstudio.com').toString(),
};
---
<BaseLayout title={copy.title} description={copy.description} lang={lang} pageType="WebPage" breadcrumbLabel={copy.eyebrow} service={{name:copy.eyebrow,description:copy.description}}>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Header slot="header" lang={lang} languagePath="/dynamic-seo/" />
  <section class="dseo-hero container">
    <p class="dseo-eyebrow">{copy.eyebrow}</p>
    <h1>{copy.h1}</h1>
    <p class="dseo-lead">{copy.lead}</p>
    <a class="dseo-cta" href={url('/contact/')}>{copy.cta}</a>
  </section>

  <section class="dseo-section container">
    <div class="dseo-copy"><p class="dseo-eyebrow">WHY NOW</p><h2>{copy.problemTitle}</h2><p>{copy.problem}</p></div>
  </section>

  <section class="dseo-section dseo-soft">
    <div class="container">
      <div class="dseo-heading"><p class="dseo-eyebrow">SEO · GEO · AEO · AIO</p><h2>{copy.systemTitle}</h2></div>
      <div class="dseo-grid">{copy.system.map(([name,text])=><article><h3>{name}</h3><p>{text}</p></article>)}</div>
    </div>
  </section>

  <section class="dseo-section container">
    <div class="dseo-heading"><p class="dseo-eyebrow">MONTHLY SYSTEM</p><h2>{copy.rhythmTitle}</h2></div>
    <div class="dseo-rhythm">{copy.rhythm.map((item)=><span>{item}</span>)}</div>
  </section>

  <section class="dseo-section dseo-soft">
    <div class="container">
      <div class="dseo-heading"><p class="dseo-eyebrow">PLANS</p><h2>{copy.plansTitle}</h2></div>
      <div class="dseo-plans">{copy.plans.map(([name,price,text],i)=><article class:list={{featured:i===1}}><h3>{name}</h3><strong>{price}</strong><p>{text}</p><a href={url('/contact/')}>{copy.cta} →</a></article>)}</div>
    </div>
  </section>

  <section class="dseo-section container">
    <div class="dseo-heading"><p class="dseo-eyebrow">FAQ</p><h2>{copy.faqTitle}</h2></div>
    <div class="dseo-faq">{copy.faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>

  <section class="dseo-final container"><p class="dseo-eyebrow">{copy.eyebrow}</p><h2>{copy.ctaTitle}</h2><a class="dseo-cta" href={url('/contact/')}>{copy.cta}</a></section>
  <Footer slot="footer" lang={lang} />
</BaseLayout>

