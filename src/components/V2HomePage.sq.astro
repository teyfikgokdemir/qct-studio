---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalizedUrl, languages, languageNames } from '../i18n';

export interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const url = (path: string) => getLocalizedUrl(lang, path);
const title = 'QCT Studio — Sisteme rritjeje digjitale për bizneset e Ballkanit';
const description = 'QCT Studio lidh faqet shumëgjuhëshe, tregtinë digjitale, dukshmërinë në kërkim, CRM-në dhe AI-në praktike për biznese të konsoliduara në Shqipëri, Maqedoninë e Veriut, Kosovë dhe Serbi.';

const markets = [
  {
    id: 'albania', slug: 'albania', local: 'Shqipëri', name: 'Shqipëri',
    signal: 'Dukshmëria sociale është e lartë. Infrastruktura e zotëruar për konvertim nuk është.',
    metric: '83.1% përdorin rrjete sociale · 57.7% kanë faqe interneti',
    source: 'Anketa e INSTAT për TIK në ndërmarrje, 2024',
    sourceUrl: 'https://www.instat.gov.al/en/themes/science-technology-and-innovation/information-and-communication-technologies-in-enterprises/',
    need: 'Zhvendosni kërkesën nga Instagram, Facebook dhe WhatsApp në një sistem shitjeje dygjuhësh dhe të matshëm.',
    playbook: ['Mikpritje dhe kërkesë direkte', 'Retail dhe tregti me asistencë', 'Faqe B2B gati për eksport'],
  },
  {
    id: 'macedonia', slug: 'north-macedonia', local: 'Северна Македонија', name: 'Maqedonia e Veriut',
    signal: 'Lidhshmëria është e pjekur. E-shitjet e ndërmarrjeve ende mbeten pas BE-së.',
    metric: '8.3% e ndërmarrjeve realizuan e-shitje',
    source: 'Raporti i E-commerce për Ballkanin Perëndimor, 2024 (të dhëna 2022)',
    sourceUrl: 'https://ecommerce.mk/en/western-balkan-ecommerce-report-2024/',
    need: 'Ndërtoni besim, konvertim shumëgjuhësh dhe operacione tregtie me ngarkesë të ulët për SME të konsoliduara.',
    playbook: ['Tregti me besim të verifikuar', 'Sisteme shumëgjuhëshe lead-esh', 'Arkitekturë RFQ për eksportues'],
  },
  {
    id: 'kosovo', slug: 'kosovo', local: 'Kosovë', name: 'Kosovë',
    signal: 'Bizneset janë të lidhura dhe me qasje social-first, por shitja online mbetet e kufizuar.',
    metric: '76.1% përdorin rrjete sociale · 4.8% raportojnë shitje online',
    source: 'OECD Digital Society / të dhëna ndërmarrjesh, 2022',
    sourceUrl: 'https://www.oecd.org/en/publications/western-balkans-competitiveness-outlook-2024-kosovo_ff74ae0e-en/full-report/component-15.html',
    need: 'Ruani lehtësinë e komunikimit me mesazhe, duke shtuar përmbajtje të zotëruar, kapje në CRM dhe ndjekje të strukturuar.',
    playbook: ['Tregti nga social në kanale të zotëruara', 'Funnel-e kërkese nga diaspora', 'Kapje lead-esh mobile-first'],
  },
  {
    id: 'serbia', slug: 'serbia', local: 'Srbija', name: 'Serbi',
    signal: 'Shumica e firmave tashmë kanë faqe interneti. Hendeku është pjekuria transaksionale.',
    metric: '85.0% kanë faqe interneti · 28.4% kanë shitur online',
    source: 'Zyra Statistikore e Republikës së Serbisë, 2024',
    sourceUrl: 'https://publikacije.stat.gov.rs/G2024/PdfE/G202416019.pdf',
    need: 'Kthejeni praninë ekzistuese online në shitje të matshme, pagesa lokale, CRM dhe automatizim operacional.',
    playbook: ['Modernizim tregtie digjitale', 'Ridizajnim i drejtuar nga konvertimi', 'Procese praktike pune me AI'],
  },
];

const systems = [
  { id: 'acquire', number: '01', label: 'Tërhiq', title: 'Bëhuni të gjetshëm për problemin që zgjidhni realisht.', copy: 'Faqe shërbimesh sipas tregut, SEO teknike, përmbajtje answer-first dhe landing page për fushata me pagesë, të ndërtuara mbi intent real lokal—jo mbi lista fjalësh kyçe të përkthyera.', image: '/images/v2/hero-network.webp', items: ['Arkitekturë intent-i në gjuhën lokale', 'SEO + përmbajtje për answer engines', 'Sisteme landing page-sh për fushata me pagesë'] },
  { id: 'convert', number: '02', label: 'Konverto', title: 'Kthejeni vëmendjen në veprim tregtar të gjurmueshëm.', copy: 'Faqe premium dhe rrugëtime tregtie që ndërthurin besimin, realitetet e pagesave lokale, asistencën në WhatsApp, politika të qarta dhe matje në nivel event-i.', image: '/images/v2/commerce-system.webp', items: ['Faqe interneti të drejtuara nga konvertimi', 'E-commerce dhe checkout me asistencë', 'Formularë, rezervime dhe drejtim përmes WhatsApp'] },
  { id: 'operate', number: '03', label: 'Opero', title: 'Bëjeni çdo lead të dukshëm, të zotëruar dhe të veprueshëm.', copy: 'Pipeline-e të lehta CRM, logjikë follow-up-i, raportim dhe procese pune me AI të rishikuara nga njerëzit, që ulin humbjet manuale pa shtuar kompleksitet të nivelit enterprise.', image: '/images/v2/growth-operations.webp', items: ['CRM dhe atribuim burimi', 'Drejtim lead-esh dhe SLA përgjigjeje', 'Operacione të kontrolluara me asistencë AI'] },
];

const sectors = [
  ['Mikpritje dhe turizëm', 'Rezervime direkte, zbulueshmëri shumëgjuhëshe, reputacion dhe kërkesë sezonale'],
  ['Retail dhe tregti', 'Katalogë, checkout, shitje me asistencë, dorëzim dhe cikël jete i klientit'],
  ['B2B dhe eksportues', 'Autoritet, prova teknike, RFQ, distributorë dhe lead-e ndërkombëtare'],
  ['Klinika dhe shërbime', 'Besim, ekspertizë, takime, zbulueshmëri lokale dhe kapje me respektim të pëlqimit'],
  ['Pasuri të paluajtshme dhe ndërtim', 'Prova projektesh, kërkesë nga diaspora, kualifikim dhe pipeline-e shitjesh'],
  ['ICT dhe firma profesionale', 'Pozicionim për eksport, raste, faqe account-based dhe follow-up në CRM'],
];

const faqs = [
  ['A është ky thjesht një tjetër paketë web-design?', 'Jo. Faqja e internetit është vetëm një shtresë e një sistemi tregtar. Ne përcaktojmë së bashku tregun, ofertën, provat e besimit, faqet e akuzicionit, event-et e konvertimit, dorëzimin në CRM dhe matjen pas lançimit.'],
  ['A mund të garantoni renditje në Google ose citime nga AI?', 'Jo, asnjë partner serioz nuk mundet. Ne ndërtojmë bazën teknike, editoriale dhe të evidencës që nevojitet për indeksim, rikthim informacioni dhe besim; më pas masim dukshmërinë dhe rezultatet e kualifikuara sipas tregut.'],
  ['A na duhet e-commerce i plotë që në ditën e parë?', 'Jo gjithmonë. Në varësi të pagesave, përmbushjes, katalogut dhe pjekurisë së ekipit, lançimi i parë i duhur mund të jetë një dyqan, një katalog me porositje të asistuar, një rrjedhë RFQ ose një sistem rezervimesh.'],
  ['Si i menaxhoni katër tregje dhe gjuhë?', 'Çdo gjuhë merr hartën e vet të intent-it, rishikim nga folës vendas, URL të qëndrueshme, canonical dhe cluster hreflang reciprok. Ne nuk gjenerojmë faqe të holla qytetesh dhe nuk e përkthejmë mekanikisht të njëjtin pitch.'],
  ['Ku hyn AI?', 'Pasi procesi bazë të jetë i qëndrueshëm. Përdorim procese pune të kufizuara dhe të rishikueshme për klasifikim lead-esh, përmbledhje, mbështetje përmbajtjeje ose njohuri të brendshme—jo premtime autonome apo zëvendësim të stafit me black-box.'],
];

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
};
---
<BaseLayout title={title} description={description} image="/images/v2/hero-network.webp" lang={lang} isHome={true} v2Home={true}>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <header slot="header" class="v2-header" data-v2-header>
    <a class="v2-brand" href="#top" aria-label="Faqja kryesore e QCT Studio"><i></i>QCT <b>Studio</b></a>
    <nav data-v2-nav aria-label="Navigimi kryesor">
      <a href="#system">Sistemi</a><a href="#markets">Tregjet</a><a href="#sectors">Sektorët</a><a href="#proof">Provat</a><a href="#method">Metoda</a>
    </nav>
    <div class="v2-header-actions">
      <div class="v2-languages" aria-label="Zgjedhësi i gjuhës">
        <span class="v2-languages-label">Gjuha</span>
        <div class="v2-languages-list">
          {Object.entries(languages).map(([code, label]) => <a class:list={{ active: code === lang }} href={getLocalizedUrl(code, '/')} hreflang={code} lang={code} aria-current={code === lang ? 'page' : undefined} aria-label={languageNames[code as keyof typeof languageNames]}>{label}</a>)}
        </div>
      </div>
      <a class="v2-header-cta" href={url('/contact/')}>Nisni një projekt <span>→</span></a>
      <button class="v2-menu-button" type="button" data-v2-menu aria-expanded="false" aria-controls="v2-navigation"><span></span><span></span><span class="screen-reader-text">Hap menunë</span></button>
    </div>
  </header>

  <div id="top" class="v2-shell" data-v2-home>
    <div class="v2-scroll-progress" data-v2-progress></div>
    <section class="hero">
      <div class="hero-media" aria-hidden="true"><img src="/images/v2/hero-network.webp" width="2200" height="943" fetchpriority="high" alt="" /><div class="hero-wash"></div></div>
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-content">
        <div class="hero-kicker">● Sisteme rritjeje digjitale për bizneset e Ballkanit</div>
        <h1>Kthejeni kërkesën rajonale në një <em>sistem rritjeje të zotëruar.</em></h1>
        <div class="hero-bottom"><p>Ne lidhim kërkimin e tregut, faqet shumëgjuhëshe, tregtinë digjitale, dukshmërinë në kërkim, CRM-në dhe AI-në praktike—që bizneset e konsoliduara të tërheqin, konvertojnë dhe operojnë me qartësi.</p><div class="hero-actions"><a class="v2-button primary" href={url('/regional-growth-diagnostic/')}>Hartoni sistemin tim të rritjes <span>→</span></a><a class="v2-button ghost" href="#markets">Eksploroni kërkesën e tregut <span>↘</span></a></div></div>
        <div class="hero-status"><span><i></i>Në shërbim të Shqipërisë · Maqedonisë së Veriut · Kosovës · Serbisë</span><span>EN · SQ · MK · SR</span><span>Nga strategjia te operimi</span></div>
      </div>
    </section>

    <section class="statement section-pad" data-reveal><div class="section-label"><i></i><b>Ndryshimi</b></div><div class="statement-grid"><h2>Tregu juaj nuk ka nevojë për <em>edhe një homepage të bukur.</em></h2><div><p>Ka nevojë për një sistem që kupton si zbulojnë, verifikojnë, shkruajnë, blejnë dhe ndjekin më tej blerësit lokalë.</p><p class="muted">Puna jonë nis nga fërkimi tregtar—jo nga layout-et. Identifikojmë ku rrjedh kërkesa, pastaj ndërtojmë sistemin më të vogël të besueshëm që e rregullon.</p></div></div></section>

    <section id="markets" class="markets section-pad">
      <div data-reveal><div class="section-label"><i></i><b>Inteligjencë tregu</b></div><div class="section-heading"><h2>Një rajon.<br /><em>Katër hendeqe digjitale të ndryshme.</em></h2><p>Kërkesa lokale ndryshon arkitekturën. Zgjidhni një treg për të parë hendekun tregtar që sistemi ynë është ndërtuar të mbyllë.</p></div></div>
      <div class="market-interface">
        <div class="market-tabs" role="tablist" aria-label="Tregjet e synuara">{markets.map((market, index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-market-tab={market.id}><span>0{index + 1}</span><b>{market.local}</b><small>{market.name}</small><i>→</i></button>)}</div>
        <div class="market-panels">{markets.map((market, index) => <article class:list={['market-panel', { 'is-active': index === 0 }]} data-market-panel={market.id} role="tabpanel"><div class="market-panel-top"><span>Sinjal tregu i verifikuar</span><b>TË DHËNA</b></div><h3>{market.signal}</h3><div class="market-metric"><strong>{market.metric}</strong><a href={market.sourceUrl} target="_blank" rel="noopener noreferrer">{market.source} ↗</a></div><p>{market.need}</p><div class="market-playbook">{market.playbook.map((item) => <span>✓ {item}</span>)}</div><a class="text-link" href={url(`/markets/${market.slug}/`)}>Eksploroni sistemin e tregut: {market.name} <span>→</span></a></article>)}</div>
      </div>
    </section>

    <section id="system" class="system-section section-pad">
      <div class="section-label"><i></i><b>Sistemi i rritjes QCT</b></div><div class="section-heading wide"><h2>Tri shtresa.<br /><em>Një sistem i përgjegjshëm.</em></h2><p>Pa teatër kanalesh. Çdo shtresë ka rol, pronar dhe dorëzim të matshëm të përcaktuar.</p></div>
      <div class="system-tabs" role="tablist">{systems.map((item, index) => <button type="button" role="tab" aria-selected={index === 1 ? 'true' : 'false'} class:list={{ active: index === 1 }} data-system-tab={item.id}><span>{item.number}</span><b>{item.label}</b></button>)}</div>
      <div class="system-panels">{systems.map((item, index) => <article class:list={['system-stage', { 'is-active': index === 1 }]} data-system-panel={item.id}><div class="system-copy"><div class="system-chip">Shtresa {item.number}</div><h3>{item.title}</h3><p>{item.copy}</p><ul>{item.items.map((entry) => <li>✓ {entry}</li>)}</ul><a class="text-link" href={url('/contact/')}>Dizenjoni këtë shtresë <span>→</span></a></div><div class="system-visual"><img src={item.image} width={item.id === 'acquire' ? 2200 : 1440} height={item.id === 'acquire' ? 943 : 1080} loading="lazy" decoding="async" alt="" /><div class="system-readout"><i></i><span>Statusi i sistemit</span><b>I lidhur</b></div></div></article>)}</div>
    </section>

    <section id="sectors" class="sectors section-pad"><div class="section-label"><i></i><b>Playbook-e sipas sektorit</b></div><div class="section-heading"><h2>Ndërtuar mbi <em>realitetin tregtar.</em></h2><p>Fokusohemi te sektorët ku besimi, kërkesa shumëgjuhëshe, blerja me asistencë ose kompleksiteti operacional krijojnë një rast real kthimi.</p></div><div class="sector-list">{sectors.map(([name, value], index) => <article data-reveal><span>0{index + 1}</span><b>{name}</b><p>{value}</p><i>↘</i></article>)}</div></section>

    <section id="proof" class="proof section-pad"><div class="section-label"><i></i><b>Arkitektura e provave</b></div><div class="section-heading wide"><h2>Evidencë përpara <em>pretendimeve të agjencisë.</em></h2><p>Ne nuk publikojmë rezultate të shpikura. Çdo rast duhet të tregojë problemin fillestar, scope-in e saktë, gjendjen në lançim dhe dritaren e rezultateve të atribuueshme.</p></div><div class="proof-grid"><a class="proof-feature" href="https://ctseg.com.tr/" target="_blank" rel="noopener noreferrer"><div class="proof-art art-one"><span>CTSEG</span><i></i></div><div class="proof-copy"><small>Tregti ndërkombëtare / Platformë B2B</small><h3>Kërkesat komplekse të sourcing-ut u kthyen në një rrugë tregtare të verifikueshme.</h3><p>Arkitekturë shumëgjuhëshe shërbimesh, vlerësim furnitorësh, zbulim produktesh dhe rrugëtime vlerësimi të kualifikuara.</p></div></a><a class="proof-card" href={url('/work/phiaderm/')}><div class="proof-art art-two"><span>PHIADERM</span></div><div class="proof-copy"><small>Tregti digjitale / Zbulim produktesh</small><h3>Storytelling premium produkti me një rrugë shitjeje të përdorshme.</h3><p>Katalog i strukturuar, edukim, siguri dhe konvertim.</p></div></a><a class="proof-card" href={url('/work/misima/')}><div class="proof-art art-three"><span>MISIMA</span></div><div class="proof-copy"><small>Prodhim / Eksport</small><h3>Kapacitetet u përkthyen në evidencë gati për distributorë.</h3><p>Arkitekturë shërbimesh, prova prodhimi dhe rrugëtime RFQ.</p></div></a></div><p class="proof-note">✓ Rezultatet tregtare publikohen vetëm kur të dhënat burimore dhe leja e klientit janë të disponueshme.</p></section>

    <section class="visibility section-pad"><div class="section-label"><i></i><b>SEO · AEO · GEO · Dukshmëri AI</b></div><div class="visibility-grid"><div class="visibility-title"><h2>Jo markup sekret.<br /><em>Një sistem njohurie i qeverisur.</em></h2><p>Dukshmëria në kërkim dhe AI ndajnë të njëjtën bazë: përmbajtje e aksesueshme, entitete të qarta, lidhje të forta të brendshme, të dhëna të strukturuara të vërteta dhe evidencë e dobishme.</p></div><div class="visibility-map" aria-label="Grafi i entiteteve QCT"><div class="core-node"><b>QCT</b><span>Entitet</span></div>{['Shërbime','Tregje','Evidencë','Udhëzues','Njerëz','Politika'].map((node, index) => <div class={`orbit-node node-${index + 1}`}>{node}</div>)}</div></div><div class="principles"><article><b>Së pari i indeksueshëm</b><p>Përgjigjet kryesore jetojnë në tekst të renderuar në server dhe URL të qëndrueshme, të crawl-ueshme.</p></article><article><b>Lokalizim real</b><p>Faqe locale me self-canonical, hreflang reciprok dhe rishikim nga folës vendas.</p></article><article><b>Qartësi për rikthim nga AI</b><p>Pasazhe answer-first, burime, autorësi, data dhe pretendime të qarta.</p></article><article><b>Matur sipas tregut</b><p>Dukshmëri, vizita të kualifikuara, lead-e dhe të ardhura—jo prompt-e anekdotike.</p></article></div></section>

    <section id="method" class="method section-pad"><div class="section-label"><i></i><b>Si ndërtojmë</b></div><div class="section-heading"><h2>Nga evidenca në <em>sistem operimi.</em></h2><p>Një ndërtim me faza që mbron buxhetin, vërteton supozimet dhe e mban pronësinë të qartë.</p></div><ol class="method-list">{[
      ['Diagnostiko','Auditim tregu, oferte, të dhënash dhe rrjedhjeje kërkese','Vendosim faktet, kufizimet, event-et bazë dhe prioritetet tregtare përpara dizajnimit.'],
      ['Arkitekto','Model informacioni, konvertimi dhe matjeje','Përcaktojmë URL-të gjuhë-treg, rolet e faqeve, provat e besimit, veprimet e konvertimit dhe dorëzimet në CRM.'],
      ['Ndërto','Eksperiencë shumëgjuhëshe e shpejtë dhe integrime','Dorëzojmë me release të testuara, me porta aksesueshmërie, performance dhe structured data.'],
      ['Opero','Matni, mësoni dhe automatizoni atë që është e qëndrueshme','Monitorojmë rezultatet, përmirësojmë rrugëtimet prioritare dhe shtojmë automatizim të kontrolluar vetëm aty ku ia vlen.'],
    ].map(([label, heading, copy], index) => <li><span>0{index + 1}</span><b>{label}</b><h3>{heading}</h3><p>{copy}</p></li>)}</ol></section>

    <section class="faq section-pad"><div class="section-label"><i></i><b>Dhoma e vendimit</b></div><div class="faq-layout"><div><h2>Pyetjet që blerësit seriozë <em>duhet të bëjnë.</em></h2><p>Përgjigje të qarta përpara propozimit. Pa black boxes, pa renditje të garantuara dhe pa varësi të fshehtë nga platforma.</p></div><div class="faq-list">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>0{index + 1}</span><b>{question}</b><i>⌄</i></summary><p>{answer}</p></details>)}</div></div></section>

    <section id="contact" class="contact section-pad"><div class="contact-grid"><div><div class="section-label"><i></i><b>Nisni nga hendeku</b></div><h2>Na tregoni ku <em>thyhet aktualisht rritja.</em></h2></div><div class="contact-card"><p>Nuk jeni të sigurt nëse ju duhet një faqe e re, rindërtim tregtie digjitale, sistem SEO apo CRM? Mirë. Nisni nga problemi i biznesit.</p><a class="v2-button light" href={url('/contact/')}>Rezervoni një telefonatë për hartëzimin e sistemit <span>→</span></a><div><span>✓ Scope i qartë</span><span>✓ Pronësi me shkrim</span><span>✓ Pa garanci renditjeje</span></div></div></div></section>
  </div>

  <footer slot="footer" class="v2-footer"><div class="footer-top"><a class="v2-brand" href="#top"><i></i>QCT <b>Studio</b></a><p>Sisteme rritjeje digjitale për biznese të konsoliduara në Ballkan.</p><a href="#top">Kthehu në krye →</a></div><div class="footer-grid"><div><b>Tregjet</b><a href="#markets">Shqipëri</a><a href="#markets">Maqedonia e Veriut</a><a href="#markets">Kosovë</a><a href="#markets">Serbi</a></div><div><b>Sistemi</b><a href="#system">Tërhiq</a><a href="#system">Konverto</a><a href="#system">Opero</a></div><div><b>Kompania</b><a href={url('/work/')}>Punë</a><a href={url('/about/')}>Rreth nesh</a><a href={url('/contact/')}>Kontakt</a></div><div><b>Ligjore</b><a href={url('/privacy-policy/')}>Privatësia</a><a href={url('/cookie-policy/')}>Cookies</a><a href={url('/terms-conditions/')}>Kushtet</a></div></div><div class="footer-bottom"><span>© 2026 QCT Studio</span><span>EN · SQ · MK · SR</span><span>Stamboll · Ballkani Perëndimor</span></div></footer>
</BaseLayout>
