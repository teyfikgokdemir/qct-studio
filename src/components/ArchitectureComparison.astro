const c = copy[lang] ?? copy.en;
---

<section id="architecture" class="benchmark-section" aria-labelledby="benchmark-title">
  <div class="container">
    <div class="benchmark-header">
      <div class="benchmark-tag">
        <span class="benchmark-tag__dot"></span>
        <span>{c.tag}</span>
      </div>
      <h2 id="benchmark-title" class="benchmark-title">
        {c.titleBefore}<span class="text-emerald">{c.titleHighlight}</span>
      </h2>
      <p class="benchmark-lead">
        {c.lead}
      </p>
    </div>

    <div class="benchmark-grid">
      <!-- Legacy Column -->
      <div class="benchmark-card benchmark-card--legacy">
        <div class="benchmark-card__header">
          <div class="badge-legacy">{c.legacyBadge}</div>
          <h3 class="benchmark-card__name">{c.legacyName}</h3>
          <p class="benchmark-card__desc">{c.legacyDesc}</p>
        </div>

        <ul class="benchmark-metrics">
          <li class="metric-row">
            <span class="metric-row__label">{c.labels.loadTime}</span>
            <span class="metric-row__val metric-row__val--bad">{c.legacyValues.loadTime}</span>
          </li>
          <li class="metric-row">
            <span class="metric-row__label">{c.labels.coreWebVitals}</span>
            <span class="metric-row__val metric-row__val--bad">{c.legacyValues.coreWebVitals}</span>
          </li>
          <li class="metric-row">
            <span class="metric-row__label">{c.labels.runtimeJs}</span>
            <span class="metric-row__val metric-row__val--bad">{c.legacyValues.runtimeJs}</span>
          </li>
          <li class="metric-row">
            <span class="metric-row__label">{c.labels.serverOverhead}</span>
            <span class="metric-row__val metric-row__val--bad">{c.legacyValues.serverOverhead}</span>
          </li>
          <li class="metric-row">
            <span class="metric-row__label">{c.labels.attackSurface}</span>
            <span class="metric-row__val metric-row__val--bad">{c.legacyValues.attackSurface}</span>
          </li>
          <li class="metric-row">
            <span class="metric-row__label">{c.labels.aiIndexing}</span>
            <span class="metric-row__val metric-row__val--bad">{c.legacyValues.aiIndexing}</span>
          </li>
        </ul>

        <div class="benchmark-card__footer">
          <span class="footer-impact">{c.legacyValues.impactLabel} <strong>{c.legacyValues.impactVal}</strong></span>
        </div>
      </div>

      <!-- QCT Studio Column -->
      <div class="benchmark-card benchmark-card--qct">
        <div class="benchmark-card__header">
          <div class="badge-qct">
            <span class="badge-qct__pulse"></span>
            {c.qctBadge}
          </div>
          <h3 class="benchmark-card__name">{c.qctName}</h3>
          <p class="benchmark-card__desc">{c.qctDesc}</p>
        </div>

        <ul class="benchmark-metrics">
          <li class="metric-row">
            <span class="metric-row__label">{c.labels.loadTime}</span>
            <span class="metric-row__val metric-row__val--good">{c.qctValues.loadTime}</span>
          </li>
          <li class="metric-row">
            <span class="metric-row__label">{c.labels.coreWebVitals}</span>
            <span class="metric-row__val metric-row__val--good">{c.qctValues.coreWebVitals}</span>
          </li>
          <li class="metric-row">
            <span class="metric-row__label">{c.labels.runtimeJs}</span>
            <span class="metric-row__val metric-row__val--good">{c.qctValues.runtimeJs}</span>
          </li>
          <li class="metric-row">
            <span class="metric-row__label">{c.labels.serverOverhead}</span>
            <span class="metric-row__val metric-row__val--good">{c.qctValues.serverOverhead}</span>
          </li>
          <li class="metric-row">
            <span class="metric-row__label">{c.labels.attackSurface}</span>
            <span class="metric-row__val metric-row__val--good">{c.qctValues.attackSurface}</span>
          </li>
          <li class="metric-row">
            <span class="metric-row__label">{c.labels.aiIndexing}</span>
            <span class="metric-row__val metric-row__val--good">{c.qctValues.aiIndexing}</span>
          </li>
        </ul>

        <div class="benchmark-card__footer benchmark-card__footer--good">
          <span class="footer-impact">{c.qctValues.impactLabel} <strong>{c.qctValues.impactVal}</strong></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.benchmark-section {
  padding: clamp(4.5rem, 7vw, 6.5rem) 0;
  background: #08090e;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  position: relative;
}

.benchmark-header {
  text-align: center;
  max-width: 820px;
  margin: 0 auto clamp(2.5rem, 5vw, 4rem);
}

.benchmark-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: 0.65rem;
  letter-spacing: 0.14em;
  font-weight: 700;
  color: #9ca3af;
  padding: 0.3rem 0.75rem;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 999px;
  margin-bottom: 1.25rem;
}

.benchmark-tag__dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #38bdf8;
}

.benchmark-title {
  font-size: clamp(2rem, 3.8vw, 3.2rem);
  font-weight: 850;
  line-height: 1.15;
  letter-spacing: -0.035em;
  color: #ffffff;
  margin: 0 0 1rem;
  text-wrap: balance;
}

.text-emerald {
  color: #00f5a0;
  background: linear-gradient(135deg, #00f5a0 0%, #38bdf8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.benchmark-lead {
  font-size: 1.05rem;
  line-height: 1.6;
  color: #9ca3af;
  margin: 0;
  text-wrap: balance;
}

/* Grid */
.benchmark-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  max-width: 1100px;
  margin: 0 auto;
}

.benchmark-card {
  border-radius: 12px;
  padding: 2rem;
  position: relative;
  display: flex;
  flex-direction: column;
}

.benchmark-card--legacy {
  background: rgba(239, 68, 68, 0.02);
  border: 1px solid rgba(239, 68, 68, 0.15);
}

.benchmark-card--qct {
  background: rgba(0, 245, 160, 0.03);
  border: 1px solid rgba(0, 245, 160, 0.35);
  box-shadow: 0 16px 40px rgba(0, 245, 160, 0.07);
}

.badge-legacy {
  display: inline-block;
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: #ef4444;
  background: rgba(239, 68, 68, 0.1);
  padding: 0.25rem 0.65rem;
  border-radius: 4px;
  margin-bottom: 0.75rem;
}

.badge-qct {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: #00f5a0;
  background: rgba(0, 245, 160, 0.12);
  padding: 0.25rem 0.65rem;
  border-radius: 4px;
  margin-bottom: 0.75rem;
}

.badge-qct__pulse {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #00f5a0;
  box-shadow: 0 0 6px #00f5a0;
}

.benchmark-card__name {
  font-size: 1.45rem;
  font-weight: 800;
  color: #ffffff;
  margin: 0 0 0.45rem;
  letter-spacing: -0.02em;
}

.benchmark-card__desc {
  font-size: 0.85rem;
  color: #9ca3af;
  margin: 0 0 1.5rem;
  line-height: 1.45;
}

/* Metric Rows */
.benchmark-metrics {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  flex: 1;
}

.metric-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  font-size: 0.88rem;
}

.metric-row__label {
  color: #9ca3af;
  font-weight: 500;
}

.metric-row__val {
