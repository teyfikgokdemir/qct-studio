    serverOverhead: string;
    attackSurface: string;
    aiIndexing: string;
  };
  legacyValues: {
    loadTime: string;
    coreWebVitals: string;
    runtimeJs: string;
    serverOverhead: string;
    attackSurface: string;
    aiIndexing: string;
    impactLabel: string;
    impactVal: string;
