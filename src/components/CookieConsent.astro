---
import { analyticsDisclosure } from "../lib/analytics-disclosure";
interface Props {
  lang: string;
}

const { lang } = Astro.props;

const copy = {
  en: {
    label: 'Cookie preferences',
    text: 'We use optional analytics cookies to understand how the website is used. Analytics only starts if you accept.',
    accept: 'Accept',
    reject: 'Reject',
    settings: 'Cookie settings',
    policy: 'Cookie Policy',
  },
  sq: {
    label: 'Preferencat e cookies',
    text: 'Përdorim cookies opsionale analitike për të kuptuar si përdoret faqja. Analitika aktivizohet vetëm nëse pranoni.',
    accept: 'Prano',
    reject: 'Refuzo',
    settings: 'Cilësimet e cookies',
    policy: 'Politika e Cookies',
  },
  mk: {
    label: 'Поставки за колачиња',
    text: 'Користиме изборни аналитички колачиња за да разбереме како се користи веб-страницата. Аналитиката се активира само со ваша согласност.',
    accept: 'Прифати',
    reject: 'Одбиј',
    settings: 'Поставки за колачиња',
    policy: 'Политика за колачиња',
  },
  sr: {
    label: 'Podešavanja kolačića',
    text: 'Koristimo opcione analitičke kolačiće da bismo razumeli kako se sajt koristi. Analitika se pokreće samo ako prihvatite.',
    accept: 'Prihvati',
    reject: 'Odbij',
    settings: 'Podešavanja kolačića',
    policy: 'Politika kolačića',
  },
  ro: {
    label: 'Preferințe cookie',
    text: 'Folosim cookie-uri analitice opționale pentru a înțelege cum este utilizat site-ul.',
    accept: 'Acceptă',
    reject: 'Refuză',
    settings: 'Setări cookie',
    policy: 'Politica de cookie-uri',
  },
  bg: {
    label: 'Настройки за бисквитки',
    text: 'Използваме незадължителни аналитични бисквитки, за да разберем как се използва сайтът.',
    accept: 'Приеми',
    reject: 'Откажи',
    settings: 'Настройки за бисквитки',
    policy: 'Политика за бисквитки',
  },
};

const c = copy[lang as keyof typeof copy] ?? copy.en;
const policyUrl = lang === 'en' ? '/cookie-policy/' : `/${lang}/cookie-policy/`;
---

<div
  class="qct-cookie-consent"
  data-cookie-consent
  role="region"
  aria-label={c.label}
  hidden
>
  <div class="qct-cookie-consent__copy">
    <strong>{c.label}</strong>
    <p>{c.text} <a href={policyUrl}>{c.policy}</a></p>
  </div>

  <div class="qct-cookie-consent__actions">
    <button type="button" data-cookie-reject>{c.reject}</button>
    <button type="button" class="is-primary" data-cookie-accept>{c.accept}</button>
  </div>
</div>

<button
  class="qct-cookie-settings"
  type="button"
  data-cookie-settings
  aria-label={c.settings}
  hidden
>
  {c.settings}
</button>

<script>
  import { createAnalytics } from '../lib/analytics-stack';
  import { analyticsConfig } from '../lib/analytics-config';
  const analytics = createAnalytics(analyticsConfig);
  const w = window as any;
  w.qctTrackEvent = analytics.track;
  const key = 'qct-analytics-consent';
  const banner = document.querySelector<HTMLElement>('[data-cookie-consent]');
  const settings = document.querySelector<HTMLElement>('[data-cookie-settings]');
  const show = (open: boolean) => { if (banner) banner.hidden = !open; if (settings) settings.hidden = open; };
  let saved: string | null = null;
  try { saved = localStorage.getItem(key); } catch {}
  let recording = false;
  try { recording = localStorage.getItem('qct-recording-consent-v1') === 'granted'; } catch {}
  const ANALYTICS_TEST_MODE = true;
  analytics.setConsent({ analytics: ANALYTICS_TEST_MODE ? true : saved === 'granted', recording: ANALYTICS_TEST_MODE ? true : recording });
  show(!['granted', 'denied'].includes(saved || '') || (saved === 'granted' && !!analyticsConfig.clarity && !recording));
  const choose = (state: string) => {
    try { localStorage.setItem(key, state); localStorage.setItem('qct-recording-consent-v1', state); } catch {}
    analytics.setConsent({ analytics: ANALYTICS_TEST_MODE ? true : state === 'granted', recording: ANALYTICS_TEST_MODE ? true : state === 'granted' });
    show(false);
  };
  document.querySelector('[data-cookie-accept]')?.addEventListener('click', () => choose('granted'));
  document.querySelector('[data-cookie-reject]')?.addEventListener('click', () => choose('denied'));
  settings?.addEventListener('click', () => show(true));
</script>

<style>
  .qct-cookie-consent {
    position:fixed;
    z-index:9999;
    right:0;
    bottom:0;
    left:0;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:1rem;
    width:100%;
    margin:0;
    padding:.48rem clamp(1rem,3vw,2rem);
    color:#f8f5ef;
    background:rgba(28,24,31,.98);
    border:0;
    border-top:1px solid rgba(255,255,255,.14);
    border-radius:0;
    box-shadow:0 -10px 30px rgba(23,21,26,.24);
    backdrop-filter:blur(14px);
  }
  .qct-cookie-consent[hidden],.qct-cookie-settings[hidden]{display:none}
  .qct-cookie-consent__copy{min-width:0;display:flex;align-items:baseline;gap:.85rem;white-space:nowrap}
  .qct-cookie-consent strong{flex:0 0 auto;color:#fff;font-size:.76rem;line-height:1.2;font-weight:800}
  .qct-cookie-consent p{min-width:0;margin:0;color:rgba(248,245,239,.72);font-size:.75rem;line-height:1.25;overflow:hidden;text-overflow:ellipsis}
  .qct-cookie-consent a{color:#ff8b78;text-decoration:underline;text-underline-offset:3px}
  .qct-cookie-consent__actions{display:flex;flex:0 0 auto;align-items:center;gap:.5rem}
  .qct-cookie-consent button,.qct-cookie-settings{min-height:32px;padding:.38rem .78rem;font:inherit;font-size:.8rem;font-weight:800;cursor:pointer;color:#f8f5ef;background:transparent;border:1px solid rgba(255,255,255,.18);border-radius:999px}
  .qct-cookie-consent button.is-primary{color:#17151a;background:#e75757;border-color:#e75757;box-shadow:none}
  .qct-cookie-consent button:hover{border-color:#ff8b78}
  .qct-cookie-settings{position:fixed;bottom:.7rem;left:.7rem;z-index:9998;min-height:30px;padding:.34rem .62rem;background:rgba(28,24,31,.94);font-size:.7rem;backdrop-filter:blur(10px)}
  .qct-cookie-consent button:focus-visible,.qct-cookie-settings:focus-visible,.qct-cookie-consent a:focus-visible{outline:3px solid #fff;outline-offset:3px}
  @media(max-width:720px){
    .qct-cookie-consent{align-items:stretch;flex-direction:column;gap:.55rem;padding:.58rem .7rem}
    .qct-cookie-consent__copy{display:block;white-space:normal}
    .qct-cookie-consent strong{display:block;margin-bottom:.18rem;font-size:.86rem}
    .qct-cookie-consent p{overflow:visible;text-overflow:clip;font-size:.76rem;line-height:1.35}
    .qct-cookie-consent__actions{width:100%;gap:.45rem}
    .qct-cookie-consent button{flex:1;min-height:34px;padding:.42rem .65rem;font-size:.8rem}
  }
</style>