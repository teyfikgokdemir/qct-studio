  ],
  bg: [
    'АРХИТЕКТУРА ASTRO 7 EDGE',
    'ДИНАМИЧНО SEO & GEO СИТИРАНЕ',
    '100/100 CORE WEB VITALS',
    'ПОД 30MS ГЛОБАЛЕН TTFB',
    'HEADLESS ТЪРГОВИЯ & WHATSAPP',
    'СТАТИЧНИ ОСТРОВИ БЕЗ ИЗЛИШЕН КОД',
    'АВТОМАТИЗАЦИЯ НА ПРОЦЕСИ С AI',
    'ENTERPRISE СХЕМА ГРАФОВЕ',
  ],
  mk: [
    'АРХИТЕКТУРА ASTRO 7 EDGE',
    'ДИНАМИЧКО SEO & GEO ЦИТИРАЊЕ',
    '100/100 CORE WEB VITALS',
    'ПОД 30MS ГЛОБАЛЕН TTFB',
    'HEADLESS Е-ТРГОВИЈА & WHATSAPP',
    'СТАТИЧКИ ОСТРОВИ БЕЗ ИЗЛИШЕН КОД',
    'АВТОМАТИЗАЦИЈА НА ПРОЦЕСИ СО AI',
    'ENTERPRISE ШЕМА ГРАФОВИ',
  ],
  sr: [
    'ASTRO 7 EDGE ARHITEKTURA',
    'DINAMIČKI SEO & GEO CITIRANJE',
    '100/100 CORE WEB VITALS',
    'ISPOD 30MS GLOBALNI TTFB',
    'HEADLESS E-COMMERCE & WHATSAPP',
    'STATIČKA OSTRVA BEZ SUVIŠNOG KODA',
    'AI AUTOMATIZACIJA PROCESA',
    'ENTERPRISE SCHEMA GRAFOVI',
  ],
  sq: [
    'ARKITEKTURË ASTRO 7 EDGE',
    'SEO DINAMIKE & CITIM GEO',
    '100/100 CORE WEB VITALS',
    'NËN 30MS TTFB GLOBALE',
    'HEADLESS COMMERCE & WHATSAPP',
    'ISHUJ STATIKË PA NGARKESË KODI',
    'AUTOMATIZIM I PROCESEVE ME AI',
    'GRAFE SKEME ENTERPRISE',
  ],
  ro: [
