---
import { useTranslations } from '../i18n';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="qct-section qct-final-cta">
<div class="container qct-final-cta__panel">
<p class="qct-section__eyebrow">{t('Ready to talk?')}</p>
<h2 class="qct-section__title">{t("Let's build something your business will be proud of.")}</h2>
<p class="qct-section__lead">
{t("Whether you need a new website, an online store or a complete digital presence, we're ready to talk.")}
</p>
<div class="qct-final-cta__actions">
<a class="qct-btn qct-btn--primary" href="#contact">{t('Start Your Project')}</a>
<a class="qct-btn qct-btn--secondary" href="mailto:info@qctstudio.com">{t('Contact Us')}</a>
</div>
</div>
</section>

<style>
.qct-final-cta {
padding-block: var(--qct-home-section-space, 5rem);
}
.qct-final-cta__panel {
text-align: center;
max-width: 700px;
margin: 0 auto;
padding: 3rem 2rem;
border: 1px solid rgba(255, 255, 255, 0.1);
border-radius: 20px;
background: rgba(255, 255, 255, 0.03);
}
.qct-section__eyebrow {
color: var(--qct-accent);
font-size: 0.85rem;
font-weight: 700;
letter-spacing: 0.08em;
text-transform: uppercase;
margin-bottom: 0.75rem;
}
.qct-section__title {
font-size: clamp(1.6rem, 3.2vw, 2.2rem);
margin-bottom: 1rem;
}
.qct-section__lead {
opacity: 0.75;
line-height: 1.6;
margin-bottom: 2rem;
}
.qct-final-cta__actions {
display: flex;
justify-content: center;
gap: 1rem;
flex-wrap: wrap;
}
.qct-btn {
padding: 0.75rem 1.75rem;
border-radius: 999px;
text-decoration: none;
font-weight: 600;
font-size: 0.95rem;
}
.qct-btn--primary {
background: var(--qct-accent);
color: #0d0d0d;
}
.qct-btn--secondary {
border: 1px solid rgba(255, 255, 255, 0.25);
color: var(--qct-fg);
}
</style>
