---
import { useTranslations, getLocalizedUrl } from '../i18n';

interface Props {
	lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const url = (path: string) => getLocalizedUrl(lang, path);

const services = [
	{
		badge: 'HEADLESS ARCHITECTURE',
		image: 'astro-headless-hero.jpg',
		href: url('/#architecture'),
		kicker: t('Website Design'),
		title: t('Premium websites'),
		text: t('Clear positioning, sharp visuals and conversion-focused structure from the first screen.'),
		cta: t('Explore Website Design'),
	},
	{
		badge: 'EDGE STOREFRONT',
		image: 'ecommerce-store-elite.jpg',
		href: url('/#project-estimator'),
		kicker: t('E-commerce'),
		title: t('E-commerce stores'),
		text: t('Product pages, mobile checkout and order flows built for serious online selling.'),
		cta: t('Explore E-commerce'),
	},
	{
		badge: 'CONVERSATIONAL COMMERCE',
		image: 'whatsapp-commerce-elite.jpg',
		href: url('/#contact'),
		kicker: t('WhatsApp Commerce'),
		title: t('Sell inside the conversation'),
		text: t('Turn customer questions into catalog views, order summaries and follow-up flows inside WhatsApp.'),
		cta: t('Explore WhatsApp Commerce'),
	},
	{
		badge: 'DYNAMIC SEO & GEO',
		image: 'geo-ai-graph.jpg',
		href: url('/dynamic-seo/'),
		kicker: t('SEO & Performance'),
		title: t('Fast, visible and measurable'),
		text: t('Technical SEO, Core Web Vitals and semantic structure for long-term visibility.'),
		cta: t('Explore SEO & GEO Performance'),
	},
	{
		badge: 'AUTONOMOUS WORKFLOWS',
		image: 'ai-automation-elite.jpg',
		href: url('/#project-estimator'),
		kicker: t('AI Automation'),
		title: t('AI automation'),
		text: t('Automations that save time, reduce repetitive work and improve everyday operations.'),
		cta: t('Explore AI Automation'),
	},
];
---
<section id="services" class="qct-section qct-services qct-services-elite" aria-labelledby="qct-services-title">
	<div class="container">
		<div class="qct-section__header elite-header">
			<div class="elite-pill">
				<span class="elite-pill-dot"></span>
				<span>ENGINEERING CAPABILITIES</span>
			</div>
			<h2 id="qct-services-title" class="qct-section__title elite-title">
				{t('Digital systems built for Balkan businesses ready to look premium.')}
			</h2>
			<p class="qct-section__lead elite-lead">
				{t('Each service is designed to improve trust, speed and conversion before you spend more on ads.')}
			</p>
		</div>

		<!-- Elite Compact 3+2 Capabilities Grid -->
		<div class="elite-services-grid">
			{services.map((service) => (
				<article class="elite-service-card">
					<div class="service-card-media">
						<img 
							src={`/images/services/${service.image}`} 
							width="800" 
							height="450" 
							loading="lazy" 
							decoding="async" 
							alt={`${service.kicker}: ${service.title}`} 
						/>
						<div class="media-overlay"></div>
					</div>

					<div class="service-card-content">
						<div class="card-meta">
							<span class="service-badge-pill">{service.badge}</span>
							<span class="service-kicker-text">{service.kicker}</span>
						</div>

						<h3 class="service-card-heading">{service.title}</h3>
						<p class="service-card-desc">{service.text}</p>

						<a class="service-card-cta" href={service.href}>
							<span>{service.cta}</span>
							<svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
								<path d="M2.5 7H11.5M11.5 7L7.5 3M11.5 7L7.5 11" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
.qct-services-elite {
	background: #07080b !important;
	padding: clamp(5rem, 8vw, 7rem) 0;
	position: relative;
	border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.elite-header {
	max-width: 1240px;
	margin-inline: auto;
	text-align: center;
	margin-bottom: 3rem;
}

.elite-pill {
	display: inline-flex;
	align-items: center;
	gap: 0.5rem;
	padding: 0.35rem 0.85rem;
	border: 1px solid rgba(255, 255, 255, 0.1);
	background: rgba(255, 255, 255, 0.04);
	border-radius: 999px;
	font-family: ui-monospace, SFMono-Regular, monospace;
	font-size: 0.65rem;
	letter-spacing: 0.14em;
	font-weight: 750;
	color: #9ca3af;
	margin-bottom: 1.15rem;
}

.elite-pill-dot {
	width: 5px;
	height: 5px;
	border-radius: 50%;
	background: #00f5a0;
	box-shadow: 0 0 6px #00f5a0;
}

/* Single line heading on desktop, fluid on mobile */
.elite-title {
	font-size: clamp(1.4rem, 2.3vw, 2.25rem) !important;
	font-weight: 800 !important;
	line-height: 1.25 !important;
	letter-spacing: -0.025em !important;
	color: #ffffff !important;
	margin-bottom: 0.85rem !important;
	text-wrap: balance;
}

@media (min-width: 1080px) {
	.elite-title {
		white-space: nowrap !important;
	}
}

.elite-lead {
	font-size: clamp(0.95rem, 1.15vw, 1.05rem) !important;
	line-height: 1.6 !important;
	color: #9ca3af !important;
	max-width: 680px;
	margin-inline: auto;
}

/* Elite Compact Grid Layout (3 on top row, 2 centered on bottom row) */
.elite-services-grid {
	display: grid;
	grid-template-columns: repeat(6, 1fr);
	gap: 1.25rem;
	max-width: 1180px;
	margin-inline: auto;
}

.elite-service-card {
	grid-column: span 2;
	background: #0d0f15;
	border: 1px solid rgba(255, 255, 255, 0.08);
	border-radius: 16px;
	overflow: hidden;
	display: flex;
	flex-direction: column;
	transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
}

.elite-service-card:hover {
	transform: translateY(-3px);
	border-color: rgba(0, 245, 160, 0.35);
	box-shadow: 0 24px 50px rgba(0, 0, 0, 0.5), 0 0 20px rgba(0, 245, 160, 0.1);
}

/* Center the 2 bottom cards on desktop */
@media (min-width: 961px) {
	.elite-service-card:nth-child(4) {
		grid-column: 2 / span 2;
	}
	.elite-service-card:nth-child(5) {
		grid-column: 4 / span 2;
	}
}

.service-card-media {
	position: relative;
	width: 100%;
	height: 175px;
	overflow: hidden;
	background: #06070a;
}

.service-card-media img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
	transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.elite-service-card:hover .service-card-media img {
	transform: scale(1.05);
}

.media-overlay {
	position: absolute;
	inset: 0;
	background: linear-gradient(180deg, transparent 45%, rgba(13, 15, 21, 0.85) 100%);
	pointer-events: none;
}

.service-card-content {
	padding: 1.15rem 1.25rem 1.25rem;
	display: flex;
	flex-direction: column;
	flex: 1;
}

.card-meta {
	display: flex;
	align-items: center;
	gap: 0.55rem;
	margin-bottom: 0.65rem;
}

.service-badge-pill {
	font-family: ui-monospace, SFMono-Regular, monospace;
	font-size: 0.6rem;
	font-weight: 750;
	color: #00f5a0;
	background: rgba(0, 245, 160, 0.08);
	border: 1px solid rgba(0, 245, 160, 0.22);
	border-radius: 999px;
	padding: 0.2rem 0.55rem;
	letter-spacing: 0.08em;
	display: inline-flex;
}

.service-kicker-text {
	font-family: ui-monospace, monospace;
	font-size: 0.65rem;
	color: #6b7280;
	letter-spacing: 0.06em;
	text-transform: uppercase;
}

.service-card-heading {
	font-size: 1.15rem;
	font-weight: 750;
	color: #ffffff;
	letter-spacing: -0.02em;
	line-height: 1.28;
	margin: 0 0 0.45rem 0;
}

.service-card-desc {
	font-size: 0.86rem;
	line-height: 1.55;
	color: #94a3b8;
	margin: 0 0 1.15rem 0;
	flex: 1;
}

.service-card-cta {
	display: inline-flex;
	align-items: center;
	gap: 0.45rem;
	color: #00f5a0;
	font-size: 0.8rem;
	font-weight: 750;
	text-decoration: none;
	transition: all 0.2s ease;
	width: fit-content;
	margin-top: auto;
}

.service-card-cta:hover {
	gap: 0.65rem;
	color: #22f8ab;
}

/* Tablet & Mobile Breakpoints */
@media (max-width: 960px) and (min-width: 601px) {
	.elite-services-grid {
		grid-template-columns: repeat(2, 1fr);
		gap: 1.15rem;
	}
	.elite-service-card {
		grid-column: span 1 !important;
	}
	.elite-service-card:nth-child(5) {
		grid-column: 1 / -1 !important;
		max-width: 540px;
		margin-inline: auto;
		width: 100%;
	}
}

@media (max-width: 600px) {
	.elite-services-grid {
		grid-template-columns: 1fr;
		gap: 1rem;
	}
	.elite-service-card {
		grid-column: span 1 !important;
	}
	.service-card-media {
		height: 160px;
	}
}
</style>
