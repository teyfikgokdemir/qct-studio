---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalizedUrl, languages, languageNames } from '../i18n';

const lang = 'en';
const url = (path: string) => getLocalizedUrl(lang, path);
const title = 'QCT Studio — Digital Growth Systems for Balkan Businesses';
const description = 'QCT Studio connects multilingual websites, commerce, search visibility, CRM and practical AI for established businesses in Albania, North Macedonia, Kosovo and Serbia.';

const markets = [
  {
    id: 'albania', slug: 'albania', local: 'Shqipëri', name: 'Albania',
    signal: 'Social visibility is high. Owned conversion infrastructure is not.',
    metric: '83.1% use social media · 57.7% have a website',
    source: 'INSTAT enterprise ICT survey, 2024',
    sourceUrl: 'https://www.instat.gov.al/en/themes/science-technology-and-innovation/information-and-communication-technologies-in-enterprises/',
    need: 'Move demand from Instagram, Facebook and WhatsApp into a bilingual, measurable sales system.',
    playbook: ['Hospitality & direct demand', 'Retail & assisted commerce', 'Export-ready B2B websites'],
  },
  {
    id: 'macedonia', slug: 'north-macedonia', local: 'Северна Македонија', name: 'North Macedonia',
    signal: 'Connectivity is mature. Enterprise e-sales still trail the EU.',
    metric: '8.3% of enterprises made e-sales',
    source: 'Western Balkan E-commerce Report, 2024 (2022 data)',
    sourceUrl: 'https://ecommerce.mk/en/western-balkan-ecommerce-report-2024/',
    need: 'Build trust, multilingual conversion and low-burden commerce operations for established SMEs.',
    playbook: ['Verified-trust commerce', 'Multilingual lead systems', 'Exporter RFQ architecture'],
  },
  {
    id: 'kosovo', slug: 'kosovo', local: 'Kosovë', name: 'Kosovo',
    signal: 'Businesses are connected and social-first, but online selling remains limited.',
    metric: '76.1% use social media · 4.8% report online sales',
    source: 'OECD Digital Society / enterprise data, 2022',
    sourceUrl: 'https://www.oecd.org/en/publications/western-balkans-competitiveness-outlook-2024-kosovo_ff74ae0e-en/full-report/component-15.html',
    need: 'Preserve the convenience of messaging while adding owned content, CRM capture and follow-up.',
    playbook: ['Social-to-owned commerce', 'Diaspora demand funnels', 'Mobile-first lead capture'],
  },
  {
    id: 'serbia', slug: 'serbia', local: 'Srbija', name: 'Serbia',
    signal: 'Most firms already have a website. The gap is transactional maturity.',
    metric: '85.0% have a website · 28.4% sold online',
    source: 'Statistical Office of the Republic of Serbia, 2024',
    sourceUrl: 'https://publikacije.stat.gov.rs/G2024/PdfE/G202416019.pdf',
    need: 'Turn existing web presence into measurable sales, local payments, CRM and operational automation.',
    playbook: ['Commerce modernization', 'Conversion-led redesign', 'Practical AI workflows'],
  },
];

const systems = [
  { id: 'acquire', number: '01', label: 'Acquire', title: 'Be found for the problem you actually solve.', copy: 'Market-specific service pages, technical SEO, answer-first content and paid landing pages built around real local intent—not translated keyword lists.', image: '/images/v2/hero-network.webp', items: ['Local-language intent architecture', 'SEO + answer-engine content', 'Paid campaign landing systems'] },
  { id: 'convert', number: '02', label: 'Convert', title: 'Turn attention into a trackable commercial action.', copy: 'Premium websites and commerce journeys that combine trust, local payment realities, WhatsApp assistance, clear policies and event-level measurement.', image: '/images/v2/commerce-system.webp', items: ['Conversion-led websites', 'E-commerce & assisted checkout', 'Forms, booking and WhatsApp routing'] },
  { id: 'operate', number: '03', label: 'Operate', title: 'Make every lead visible, owned and actionable.', copy: 'Lean CRM pipelines, follow-up logic, reporting and human-reviewed AI workflows that reduce manual leakage without adding enterprise-level complexity.', image: '/images/v2/growth-operations.webp', items: ['CRM and source attribution', 'Lead routing and response SLAs', 'Controlled AI-assisted operations'] },
];

const sectors = [
  ['Hospitality & tourism', 'Direct bookings, multilingual discovery, reputation and seasonal demand'],
  ['Retail & commerce', 'Catalogues, checkout, assisted sales, delivery and customer lifecycle'],
  ['B2B & exporters', 'Authority, technical proof, RFQs, distributors and international leads'],
  ['Clinics & services', 'Trust, expertise, appointments, local discovery and consent-aware capture'],
  ['Property & construction', 'Project proof, diaspora demand, qualification and sales pipelines'],
  ['ICT & professional firms', 'Export positioning, cases, account-based pages and CRM follow-up'],
];

const faqs = [
  ['Is this another web-design package?', 'No. The website is one layer of a commercial system. We define the market, offer, trust proof, acquisition pages, conversion events, CRM handoff and post-launch measurement together.'],
  ['Can you guarantee Google rankings or AI citations?', 'No credible partner can. We build the technical, editorial and evidence foundation required for indexability, retrieval and trust, then measure visibility and qualified outcomes by market.'],
  ['Do we need full e-commerce from day one?', 'Not always. Depending on payment, fulfilment, catalogue and team maturity, the right first release may be a store, a catalogue with assisted ordering, an RFQ flow or a booking system.'],
  ['How do you handle four markets and languages?', 'Each language receives its own intent map, native review, stable URL, canonical and reciprocal hreflang cluster. We do not generate thin city pages or mechanically translate the same pitch.'],
  ['Where does AI fit?', 'After the underlying process is stable. We use bounded, reviewable workflows for lead classification, summaries, content support or internal knowledge—not autonomous promises or black-box replacement of staff.'],
];

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
};
---
<BaseLayout title={title} description={description} image="/images/v2/hero-network.webp" lang={lang} isHome={true} v2Home={true}>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <header slot="header" class="v2-header" data-v2-header>
    <a class="v2-brand" href="#top" aria-label="QCT Studio home"><i></i>QCT <b>Studio</b></a>
    <nav data-v2-nav aria-label="Primary navigation">
      <a href="#system">System</a><a href="#markets">Markets</a><a href="#sectors">Sectors</a><a href="#proof">Proof</a><a href="#method">Method</a>
    </nav>
    <div class="v2-header-actions">
      <div class="v2-languages" aria-label="Language selector">
        {Object.entries(languages).map(([code, label]) => <a href={getLocalizedUrl(code, '/')} hreflang={code} lang={code} aria-label={languageNames[code as keyof typeof languageNames]}>{label}</a>)}
      </div>
      <a class="v2-header-cta" href={url('/contact/')}>Start a project <span>→</span></a>
      <button class="v2-menu-button" type="button" data-v2-menu aria-expanded="false" aria-controls="v2-navigation"><span></span><span></span><span class="screen-reader-text">Open menu</span></button>
    </div>
  </header>

  <div id="top" class="v2-shell" data-v2-home>
    <div class="v2-scroll-progress" data-v2-progress></div>
    <section class="hero">
      <div class="hero-media" aria-hidden="true"><img src="/images/v2/hero-network.webp" width="2200" height="943" fetchpriority="high" alt="" /><div class="hero-wash"></div></div>
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-content">
        <div class="hero-kicker">● Digital growth systems for Balkan businesses</div>
        <h1>Turn regional demand into an <em>owned growth system.</em></h1>
        <div class="hero-bottom"><p>We connect market research, multilingual websites, commerce, search visibility, CRM and practical AI—so established businesses can acquire, convert and operate with clarity.</p><div class="hero-actions"><a class="v2-button primary" href="#contact">Map my growth system <span>→</span></a><a class="v2-button ghost" href="#markets">Explore market demand <span>↘</span></a></div></div>
        <div class="hero-status"><span><i></i>Serving Albania · North Macedonia · Kosovo · Serbia</span><span>EN · SQ · MK · SR</span><span>Strategy to operation</span></div>
      </div>
    </section>

    <section class="statement section-pad" data-reveal><div class="section-label"><span>00</span><i></i><b>The shift</b></div><div class="statement-grid"><h2>Your market does not need <em>another attractive homepage.</em></h2><div><p>It needs a system that understands how local buyers discover, verify, message, buy and follow up.</p><p class="muted">Our work begins with commercial friction—not layouts. We identify where demand leaks, then build the smallest credible system that fixes it.</p></div></div></section>

    <section id="markets" class="markets section-pad">
      <div data-reveal><div class="section-label"><span>01</span><i></i><b>Market intelligence</b></div><div class="section-heading"><h2>One region.<br /><em>Four different digital gaps.</em></h2><p>Local demand changes the architecture. Select a market to see the commercial gap our system is designed to close.</p></div></div>
      <div class="market-interface">
        <div class="market-tabs" role="tablist" aria-label="Target markets">{markets.map((market, index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-market-tab={market.id}><span>0{index + 1}</span><b>{market.local}</b><small>{market.name}</small><i>→</i></button>)}</div>
        <div class="market-panels">{markets.map((market, index) => <article class:list={['market-panel', { 'is-active': index === 0 }]} data-market-panel={market.id} role="tabpanel"><div class="market-panel-top"><span>Verified market signal</span><b>DATA</b></div><h3>{market.signal}</h3><div class="market-metric"><strong>{market.metric}</strong><a href={market.sourceUrl} target="_blank" rel="noopener noreferrer">{market.source} ↗</a></div><p>{market.need}</p><div class="market-playbook">{market.playbook.map((item) => <span>✓ {item}</span>)}</div><a class="text-link" href={url(`/markets/${market.slug}/`)}>Explore the {market.name} market system <span>→</span></a></article>)}</div>
      </div>
    </section>

    <section id="system" class="system-section section-pad">
      <div class="section-label"><span>02</span><i></i><b>The QCT growth system</b></div><div class="section-heading wide"><h2>Three layers.<br /><em>One accountable system.</em></h2><p>No channel theatre. Every layer has a defined role, owner and measurable handoff.</p></div>
      <div class="system-tabs" role="tablist">{systems.map((item, index) => <button type="button" role="tab" aria-selected={index === 1 ? 'true' : 'false'} class:list={{ active: index === 1 }} data-system-tab={item.id}><span>{item.number}</span><b>{item.label}</b></button>)}</div>
      <div class="system-panels">{systems.map((item, index) => <article class:list={['system-stage', { 'is-active': index === 1 }]} data-system-panel={item.id}><div class="system-copy"><div class="system-chip">Layer {item.number}</div><h3>{item.title}</h3><p>{item.copy}</p><ul>{item.items.map((entry) => <li>✓ {entry}</li>)}</ul><a class="text-link" href={url('/contact/')}>Design this layer <span>→</span></a></div><div class="system-visual"><img src={item.image} width={item.id === 'acquire' ? 2200 : 1440} height={item.id === 'acquire' ? 943 : 1080} loading="lazy" decoding="async" alt="" /><div class="system-readout"><i></i><span>System status</span><b>Connected</b></div></div></article>)}</div>
    </section>

    <section id="sectors" class="sectors section-pad"><div class="section-label"><span>03</span><i></i><b>Sector playbooks</b></div><div class="section-heading"><h2>Built around <em>commercial reality.</em></h2><p>We focus on sectors where trust, multilingual demand, assisted buying or operational complexity create a real return case.</p></div><div class="sector-list">{sectors.map(([name, value], index) => <article data-reveal><span>0{index + 1}</span><b>{name}</b><p>{value}</p><i>↘</i></article>)}</div></section>

    <section id="proof" class="proof section-pad"><div class="section-label"><span>04</span><i></i><b>Proof architecture</b></div><div class="section-heading wide"><h2>Evidence before <em>agency claims.</em></h2><p>We do not publish invented results. Every case must show the starting problem, exact scope, launch state and attributable outcome window.</p></div><div class="proof-grid"><a class="proof-feature" href="https://ctseg.com.tr/" target="_blank" rel="noopener noreferrer"><div class="proof-art art-one"><span>CTSEG</span><i></i></div><div class="proof-copy"><small>International trade / B2B platform</small><h3>Complex sourcing requirements turned into a verifiable commercial path.</h3><p>Multilingual service architecture, supplier evaluation, product discovery and qualified assessment journeys.</p></div></a><a class="proof-card" href={url('/work/phiaderm/')}><div class="proof-art art-two"><span>PHIADERM</span></div><div class="proof-copy"><small>Commerce / Product discovery</small><h3>Premium product storytelling with a usable sales path.</h3><p>Structured catalogue, education, reassurance and conversion.</p></div></a><a class="proof-card" href={url('/work/misima/')}><div class="proof-art art-three"><span>MISIMA</span></div><div class="proof-copy"><small>Manufacturing / Export</small><h3>Capabilities translated into distributor-ready evidence.</h3><p>Service architecture, production proof and RFQ journeys.</p></div></a></div><p class="proof-note">✓ Commercial results are published only when source data and client permission are available.</p></section>

    <section class="visibility section-pad"><div class="section-label"><span>05</span><i></i><b>SEO · AEO · GEO · AI visibility</b></div><div class="visibility-grid"><div class="visibility-title"><h2>No secret markup.<br /><em>A governed knowledge system.</em></h2><p>Search and AI visibility share the same foundation: accessible content, clear entities, strong internal links, truthful structured data and useful evidence.</p></div><div class="visibility-map" aria-label="QCT entity graph"><div class="core-node"><b>QCT</b><span>Entity</span></div>{['Services','Markets','Evidence','Guides','People','Policies'].map((node, index) => <div class={`orbit-node node-${index + 1}`}>{node}</div>)}</div></div><div class="principles"><article><b>Indexable first</b><p>Core answers live in server-rendered text and stable, crawlable URLs.</p></article><article><b>Real localization</b><p>Self-canonical locale pages with reciprocal hreflang and native review.</p></article><article><b>AI retrieval clarity</b><p>Answer-first passages, sources, authorship, dates and explicit claims.</p></article><article><b>Measured by market</b><p>Visibility, qualified visits, leads and revenue—not anecdotal prompts.</p></article></div></section>

    <section id="method" class="method section-pad"><div class="section-label"><span>06</span><i></i><b>How we build</b></div><div class="section-heading"><h2>From evidence to <em>operating system.</em></h2><p>A staged build that protects budget, proves assumptions and keeps ownership clear.</p></div><ol class="method-list">{[
      ['Diagnose','Market, offer, data and demand-leak audit','We establish facts, constraints, baseline events and commercial priorities before designing.'],
      ['Architect','Information, conversion and measurement model','We define language-market URLs, page roles, trust proof, conversion actions and CRM handoffs.'],
      ['Build','Fast multilingual experience and integrations','We deliver in tested releases with accessibility, performance and structured-data gates.'],
      ['Operate','Measure, learn and automate what is stable','We monitor outcomes, improve priority journeys and add controlled automation only where it pays.'],
    ].map(([label, heading, copy], index) => <li><span>0{index + 1}</span><b>{label}</b><h3>{heading}</h3><p>{copy}</p></li>)}</ol></section>

    <section class="faq section-pad"><div class="section-label"><span>07</span><i></i><b>Decision room</b></div><div class="faq-layout"><div><h2>Questions serious buyers <em>should ask.</em></h2><p>Clear answers before a proposal. No black boxes, no guaranteed rankings and no hidden platform lock-in.</p></div><div class="faq-list">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>0{index + 1}</span><b>{question}</b><i>⌄</i></summary><p>{answer}</p></details>)}</div></div></section>

    <section id="contact" class="contact section-pad"><div class="contact-grid"><div><div class="section-label"><span>08</span><i></i><b>Start with the gap</b></div><h2>Tell us where growth <em>currently breaks.</em></h2></div><div class="contact-card"><p>Not sure whether you need a new website, commerce rebuild, SEO system or CRM? Good. Start with the business problem.</p><a class="v2-button light" href={url('/contact/')}>Book a system mapping call <span>→</span></a><div><span>✓ Clear scope</span><span>✓ Ownership in writing</span><span>✓ No ranking guarantees</span></div></div></div></section>
  </div>

  <footer slot="footer" class="v2-footer"><div class="footer-top"><a class="v2-brand" href="#top"><i></i>QCT <b>Studio</b></a><p>Digital growth systems for established Balkan businesses.</p><a href="#top">Back to top →</a></div><div class="footer-grid"><div><b>Markets</b><a href="#markets">Albania</a><a href="#markets">North Macedonia</a><a href="#markets">Kosovo</a><a href="#markets">Serbia</a></div><div><b>System</b><a href="#system">Acquire</a><a href="#system">Convert</a><a href="#system">Operate</a></div><div><b>Company</b><a href={url('/work/')}>Work</a><a href={url('/about/')}>About</a><a href={url('/contact/')}>Contact</a></div><div><b>Legal</b><a href={url('/privacy-policy/')}>Privacy</a><a href={url('/cookie-policy/')}>Cookies</a><a href={url('/terms-conditions/')}>Terms</a></div></div><div class="footer-bottom"><span>© 2026 QCT Studio</span><span>EN · SQ · MK · SR</span><span>Istanbul · Western Balkans</span></div></footer>
</BaseLayout>
