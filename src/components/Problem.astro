---
import { useTranslations } from '../i18n';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="balkan-launch" class="qct-section qct-problem qct-problem-elite" aria-labelledby="qct-problem-title">
	<div class="container">
		<div class="qct-section__header elite-header">
			<div class="elite-eyebrow-pill">
				<span class="pill-dot"></span>
				<span>{t('WHY QCT STUDIO')}</span>
			</div>
			<h2 id="qct-problem-title" class="qct-section__title elite-title">
				{t("We don't sell websites.")} <span class="text-emerald">{t('We build confidence.')}</span>
			</h2>
			<p class="qct-section__lead elite-lead">
				{t('A website is often the first impression people have of your business.')} {t('If it feels outdated, people notice.')} {t('If it feels trustworthy, they notice that too.')} {t("That's why every decision we make has one goal:")} {t('to help your business look as professional online as it already is offline.')}
			</p>
		</div>

		<div class="qct-problem__grid elite-problem-grid">
			<article class="qct-problem-card elite-prob-card">
				<div class="prob-card-header">
					<span class="prob-card-num">01</span>
					<span class="prob-card-indicator"></span>
				</div>
				<h3>{t('Clear Communication')}</h3>
				<p>{t('No confusing process.')}<br />{t('No unnecessary meetings.')}<br />{t('No technical jargon.')}</p>
			</article>

			<article class="qct-problem-card elite-prob-card">
				<div class="prob-card-header">
					<span class="prob-card-num">02</span>
					<span class="prob-card-indicator"></span>
				</div>
				<h3>{t('Built Around Your Business')}</h3>
				<p>{t('Every business is different.')}<br />{t('Your website should be too.')}</p>
			</article>

			<article class="qct-problem-card elite-prob-card">
				<div class="prob-card-header">
					<span class="prob-card-num">03</span>
					<span class="prob-card-indicator"></span>
				</div>
				<h3>{t('Designed to Last')}</h3>
				<p>{t('We build websites that still feel modern years from now.')}</p>
			</article>

			<article class="qct-problem-card elite-prob-card">
				<div class="prob-card-header">
					<span class="prob-card-num">04</span>
					<span class="prob-card-indicator"></span>
				</div>
				<h3>{t('Long-Term Support')}</h3>
				<p>{t('Launching your website is the beginning, not the end.')}</p>
			</article>
		</div>

		<p class="qct-section__lead elite-lead-bottom">
			{t('We work with businesses across the Balkans that care about how they are seen online.')}
		</p>
	</div>
</section>

<style>
.qct-problem-elite {
	background: #080a0f !important;
	padding: clamp(5rem, 8vw, 7rem) 0;
	border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.elite-header {
	max-width: 900px;
	margin-inline: auto;
	text-align: center;
}

.elite-eyebrow-pill {
	display: inline-flex;
	align-items: center;
	gap: 0.5rem;
	padding: 0.35rem 0.8rem;
	border: 1px solid rgba(255, 255, 255, 0.1);
	background: rgba(255, 255, 255, 0.04);
	border-radius: 999px;
	font-family: ui-monospace, SFMono-Regular, monospace;
	font-size: 0.65rem;
	letter-spacing: 0.14em;
	font-weight: 750;
	color: #9ca3af;
	margin-bottom: 1.25rem;
}

.pill-dot {
	width: 5px;
	height: 5px;
	border-radius: 50%;
	background: #00f5a0;
}

.elite-title {
	font-size: clamp(2.2rem, 4.2vw, 3.8rem) !important;
	font-weight: 850 !important;
	line-height: 1.08 !important;
	letter-spacing: -0.04em !important;
	color: #ffffff !important;
	margin: 0 0 1.2rem !important;
}

.text-emerald {
	color: #00f5a0;
	background: linear-gradient(135deg, #00f5a0 0%, #38bdf8 100%);
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
}

.elite-lead {
	font-size: 1.05rem !important;
	line-height: 1.65 !important;
	color: #9ca3af !important;
	max-width: 720px;
	margin-inline: auto;
}

.elite-problem-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr) !important;
	gap: 1.25rem !important;
	margin-top: 3.5rem !important;
}

.elite-prob-card {
	background: #0d0f15 !important;
	border: 1px solid rgba(255, 255, 255, 0.08) !important;
	border-radius: 12px !important;
	padding: 1.75rem !important;
	min-height: 220px !important;
	display: flex;
	flex-direction: column;
	justify-content: flex-start;
	transition: all 0.25s ease !important;
}

.elite-prob-card:hover {
	border-color: rgba(0, 245, 160, 0.3) !important;
	transform: translateY(-2px);
	box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5) !important;
}

.prob-card-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 1.2rem;
}

.prob-card-num {
	font-family: ui-monospace, SFMono-Regular, monospace;
	font-size: 0.72rem;
	font-weight: 800;
	color: #00f5a0;
	letter-spacing: 0.1em;
}

.prob-card-indicator {
	width: 5px;
	height: 5px;
	border-radius: 50%;
	background: rgba(255, 255, 255, 0.2);
}

.elite-prob-card h3 {
	font-size: 1.15rem !important;
	font-weight: 800 !important;
	color: #ffffff !important;
	letter-spacing: -0.02em !important;
	margin: 0 0 0.75rem 0 !important;
	line-height: 1.25 !important;
}

.elite-prob-card p {
	font-size: 0.88rem !important;
	line-height: 1.6 !important;
	color: #9ca3af !important;
	margin: 0 !important;
}

.elite-lead-bottom {
	text-align: center;
	font-size: 0.95rem !important;
	color: #6b7280 !important;
	margin-top: 2.5rem !important;
}

@media (max-width: 992px) {
	.elite-problem-grid {
		grid-template-columns: repeat(2, 1fr) !important;
	}
}

@media (max-width: 600px) {
	.elite-problem-grid {
		grid-template-columns: 1fr !important;
	}
}
</style>
