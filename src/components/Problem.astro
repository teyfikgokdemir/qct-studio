---
import { useTranslations } from '../i18n';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="balkan-launch" class="qct-section qct-problem" aria-labelledby="qct-problem-title">
	<div class="container">
		<div class="qct-section__header">
			<p class="qct-section__eyebrow">{t('WHY QCT STUDIO')}</p>
			<h2 id="qct-problem-title" class="qct-section__title">
				{t("We don't sell websites.")} {t('We build confidence.')}
			</h2>
			<p class="qct-section__lead">
				{t('A website is often the first impression people have of your business.')} {t('If it feels outdated, people notice.')} {t('If it feels trustworthy, they notice that too.')} {t("That's why every decision we make has one goal:")} {t('to help your business look as professional online as it already is offline.')}
			</p>
		</div>

		<div class="qct-problem__grid">
			<article class="qct-problem-card">
				<span class="qct-problem-card__mark" aria-hidden="true"></span>
				<h3>{t('Clear Communication')}</h3>
				<p>{t('No confusing process.')}<br />{t('No unnecessary meetings.')}<br />{t('No technical jargon.')}</p>
			</article>

			<article class="qct-problem-card">
				<span class="qct-problem-card__mark" aria-hidden="true"></span>
				<h3>{t('Built Around Your Business')}</h3>
				<p>{t('Every business is different.')}<br />{t('Your website should be too.')}</p>
			</article>

			<article class="qct-problem-card">
				<span class="qct-problem-card__mark" aria-hidden="true"></span>
				<h3>{t('Designed to Last')}</h3>
				<p>{t('We build websites that still feel modern years from now.')}</p>
			</article>

			<article class="qct-problem-card">
				<span class="qct-problem-card__mark" aria-hidden="true"></span>
				<h3>{t('Long-Term Support')}</h3>
				<p>{t('Launching your website is the beginning, not the end.')}</p>
			</article>
		</div>

		<p class="qct-section__lead">
			{t('We work with businesses across the Balkans that care about how they are seen online.')}
		</p>
	</div>
</section>

<style>
.qct-problem > .container > .qct-section__header {
	max-width: 1120px;
	margin-inline: auto;
	text-align: center;
}
.qct-problem > .container > .qct-section__header .qct-section__eyebrow {
	text-align: center;
	margin-bottom: 14px;
}
.qct-problem > .container > .qct-section__header .qct-section__title {
	font-size: clamp(2.15rem, 3.25vw, 3.25rem);
	line-height: 1.04;
	letter-spacing: -0.035em;
	max-width: none;
	margin-inline: auto;
}
.qct-problem > .container > .qct-section__header .qct-section__lead {
	font-size: clamp(.98rem, 1.25vw, 1.08rem);
	line-height: 1.65;
	max-width: 900px;
	margin: 1rem auto 0;
	text-align: center;
}
.qct-problem > .container > .qct-section__lead:last-child {
	max-width: 760px;
	margin: 2rem auto 0;
	text-align: center;
}
@media (min-width: 1180px) {
	.qct-problem > .container > .qct-section__header .qct-section__title {
		white-space: nowrap;
	}
}
@media (max-width: 760px) {
	.qct-problem > .container > .qct-section__header .qct-section__title {
		font-size: clamp(2rem, 9vw, 2.65rem);
		white-space: normal;
	}
	.qct-problem > .container > .qct-section__header .qct-section__lead {
		font-size: .98rem;
	}
}
</style>
