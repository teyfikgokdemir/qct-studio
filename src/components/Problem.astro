---
import { useTranslations } from '../i18n';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const tags: Record<string, { principle: string; purpose: string; endurance: string; partnership: string }> = {
	en: { principle: 'PRINCIPLE', purpose: 'PURPOSE', endurance: 'ENDURANCE', partnership: 'PARTNERSHIP' },
	bg: { principle: 'ПРИНЦИП', purpose: 'ЦЕЛ', endurance: 'УСТОЙЧИВОСТ', partnership: 'ПАРТНЬОРСТВО' },
	mk: { principle: 'ПРИНЦИП', purpose: 'ЦЕЛ', endurance: 'ИЗДРЖЛИВОСТ', partnership: 'ПАРТНЕРСТВО' },
	sr: { principle: 'PRINCIP', purpose: 'SVRHA', endurance: 'TRAJNOST', partnership: 'PARTNERSTVO' },
	sq: { principle: 'PARIM', purpose: 'QËLLIM', endurance: 'QËNDRUESHMËRI', partnership: 'PARTNERITET' },
	ro: { principle: 'PRINCIPIU', purpose: 'SCOP', endurance: 'DURABILITATE', partnership: 'PARTENERIAT' },
};
const pTags = tags[lang] ?? tags.en;
---
<section id="balkan-launch" class="qct-section qct-problem qct-problem-elite" aria-labelledby="qct-problem-title">
	<div class="container">
		<div class="qct-section__header elite-header">
			<div class="elite-eyebrow-pill">
				<span class="pill-dot"></span>
				<span>{t('WHY QCT STUDIO')}</span>
			</div>
			<h2 id="qct-problem-title" class="qct-section__title elite-title">
				{t("We don't sell websites.")} <span class="text-emerald">{t('We build confidence.')}</span>
			</h2>
			<p class="qct-section__lead elite-lead">
				{t('A website is often the first impression people have of your business.')} {t('If it feels outdated, people notice.')} {t('If it feels trustworthy, they notice that too.')} {t("That's why every decision we make has one goal:")} {t('to help your business look as professional online as it already is offline.')}
			</p>
		</div>

		<div class="qct-problem__grid elite-problem-grid">
			<article class="qct-problem-card elite-prob-card">
				<div class="prob-card-header">
					<span class="prob-card-indicator"></span>
					<span class="prob-card-tag">{pTags.principle}</span>
				</div>
				<h3>{t('Clear Communication')}</h3>
				<p>{t('No confusing process.')}<br />{t('No unnecessary meetings.')}<br />{t('No technical jargon.')}</p>
			</article>

			<article class="qct-problem-card elite-prob-card">
				<div class="prob-card-header">
					<span class="prob-card-indicator"></span>
					<span class="prob-card-tag">{pTags.purpose}</span>
				</div>
				<h3>{t('Built Around Your Business')}</h3>
				<p>{t('Every business is different.')}<br />{t('Your website should be too.')}</p>
			</article>

			<article class="qct-problem-card elite-prob-card">
				<div class="prob-card-header">
					<span class="prob-card-indicator"></span>
					<span class="prob-card-tag">{pTags.endurance}</span>
				</div>
				<h3>{t('Designed to Last')}</h3>
				<p>{t('We build websites that still feel modern years from now.')}</p>
			</article>

			<article class="qct-problem-card elite-prob-card">
				<div class="prob-card-header">
					<span class="prob-card-indicator"></span>
					<span class="prob-card-tag">{pTags.partnership}</span>
				</div>
				<h3>{t('Long-Term Support')}</h3>
				<p>{t('Launching your website is the beginning, not the end.')}</p>
			</article>
		</div>

		<p class="qct-section__lead elite-lead-bottom">
			{t('We work with businesses across the Balkans that care about how they are seen online.')}
		</p>
	</div>
</section>

<style>
.qct-problem-elite {
	background: #080a0f !important;
	padding: clamp(5rem, 8vw, 7rem) 0;
	border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.elite-header {
	max-width: 900px;
	margin-inline: auto;
	text-align: center;
}

.elite-eyebrow-pill {
	display: inline-flex;
	align-items: center;
	gap: 0.5rem;
	padding: 0.35rem 0.8rem;
	border: 1px solid rgba(255, 255, 255, 0.1);
	background: rgba(255, 255, 255, 0.04);
	border-radius: 999px;
	font-family: ui-monospace, SFMono-Regular, monospace;
	font-size: 0.65rem;
	letter-spacing: 0.14em;
	font-weight: 750;
	color: #9ca3af;
	margin-bottom: 1.25rem;
}

.pill-dot {
	width: 5px;
	height: 5px;
	border-radius: 50%;
	background: #00f5a0;
	box-shadow: 0 0 6px #00f5a0;
}

.elite-title {
	font-size: clamp(1.4rem, 2.3vw, 2.25rem) !important;
	font-weight: 800 !important;
	line-height: 1.25 !important;
	letter-spacing: -0.025em !important;
	color: #ffffff !important;
	margin-bottom: 1.15rem !important;
	text-wrap: balance;
}

@media (min-width: 1100px) {
	.elite-title {
		white-space: nowrap !important;
	}
}

.text-emerald {
	color: #00f5a0 !important;
}

.elite-lead {
	font-size: clamp(1.05rem, 1.4vw, 1.22rem) !important;
	line-height: 1.65 !important;
	color: #9ca3af !important;
	max-width: 780px;
	margin-inline: auto;
}

.elite-problem-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr) !important;
	gap: 1.25rem !important;
	margin-top: 4rem;
}

.elite-prob-card {
	background: #0d0f15 !important;
	border: 1px solid rgba(255, 255, 255, 0.08) !important;
	border-radius: 14px;
	padding: 2rem 1.75rem !important;
	transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	position: relative;
	display: flex;
	flex-direction: column;
}

.elite-prob-card:hover {
	transform: translateY(-4px);
	border-color: rgba(0, 245, 160, 0.35) !important;
	box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(0, 245, 160, 0.1);
}

.prob-card-header {
	display: flex;
	align-items: center;
	gap: 0.5rem;
	margin-bottom: 1.25rem;
}

.prob-card-indicator {
	width: 6px;
	height: 6px;
	border-radius: 50%;
	background: #00f5a0;
	box-shadow: 0 0 8px #00f5a0;
}

.prob-card-tag {
	font-family: ui-monospace, SFMono-Regular, monospace;
	font-size: 0.65rem;
	font-weight: 750;
	letter-spacing: 0.12em;
	color: #6b7280;
}

.elite-prob-card h3 {
	font-size: 1.25rem !important;
	font-weight: 750 !important;
	color: #ffffff !important;
	line-height: 1.25;
	margin-bottom: 0.85rem !important;
	letter-spacing: -0.02em;
}

.elite-prob-card p {
	font-size: 0.95rem !important;
	line-height: 1.6 !important;
	color: #9ca3af !important;
	margin: 0 !important;
}

.elite-lead-bottom {
	text-align: center;
	font-size: 1rem !important;
	color: #6b7280 !important;
	margin-top: 3.5rem !important;
	font-style: italic;
}

@media (max-width: 1024px) {
	.elite-problem-grid {
		grid-template-columns: repeat(2, 1fr) !important;
	}
}

@media (max-width: 640px) {
	.elite-problem-grid {
		grid-template-columns: 1fr !important;
	}
}
</style>
