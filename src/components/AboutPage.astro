---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ServicePage from './service/ServicePage.astro';
import { useTranslations } from '../i18n';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<BaseLayout title={`${t('About')} — QCT Studio`} lang={lang} description={t('Across the Balkans, many established businesses keep improving. Their team gets better. Their services get better. Their reputation gets stronger. The website is often the part that stays behind, showing an older version of the company. QCT Studio exists to close that gap.')} pageType="AboutPage" breadcrumbLabel={t('About')}>
  <Header slot="header" lang={lang} />
  <ServicePage
    lang={lang}
    eyebrow={t('About')}
    title={t('Good businesses improve. Their websites often do not.')}
    lead={t('Across the Balkans, many established businesses keep improving. Their team gets better. Their services get better. Their reputation gets stronger. The website is often the part that stays behind, showing an older version of the company. QCT Studio exists to close that gap.')}
    ctaPrimary={t('Start Your Project')}
    ctaSecondary={t('View Our Work')}
    problem={{
      eyebrow: t('WHY WE STARTED'),
      title: t('We kept seeing the same problem.'),
      intro: [t('A business would be doing well offline, but the website still looked like it belonged to an earlier stage. The company had moved forward. The digital presence had not.')],
      items: [
        { title: t('Clarity first.'), text: t('If the website looks outdated, people assume the business is behind too.') },
        { title: t('Built for real businesses.'), text: t('The work is shaped around companies that already have something real to show, but need a better way to show it online.') },
        { title: t('Long-term value matters.'), text: t('The goal is to build something that still fits when the business moves on to its next stage.') },
      ],
    }}
    benefits={{
      eyebrow: t('HOW WE WORK'),
      title: t('We start with the business, then shape the website around it.'),
      lead: t('We look at what the company sells, who buys it, how people decide and what should happen after someone visits the website. Only then do we design the page structure.'),
      items: [
        { title: t('Business understanding'), text: t('We begin by learning how the company sells, supports and presents itself online.') },
        { title: t('Practical structure'), text: t('Pages, content and actions are planned so people can move through the site without confusion.') },
        { title: t('Quality standards'), text: t('We keep the work focused on pages that are easy to understand, fast to use, simple to maintain and natural on mobile.') },
      ],
    }}
    included={{
      eyebrow: t('WHY THE BALKANS MATTER'),
      title: t('We work where businesses are moving faster than their websites.'),
      lead: t('Across the Balkans, companies are investing, modernising and reaching new customers. Family businesses are becoming more formal. Exports are growing. Tourism is growing. Local brands are getting stronger. The digital side often has not kept up.'),
      items: [
        { title: t('Regional businesses'), text: t('Many businesses are improving quickly, but their online presence still needs to catch up.') },
        { title: t('Cross-border teams'), text: t('Customers expect clear communication, fast pages and a straightforward path to contact.') },
        { title: t('Balkan markets'), text: t('When the digital system is behind, trust has to be rebuilt before any conversation starts.') },
      ],
    }}
    process={{
      eyebrow: t('PROCESS'),
      title: t('A clear process before any design decision.'),
      steps: [
        { number: t('01'), title: t('Understand the business'), text: t('We review the company, its offer, its audience and the current digital setup.') },
        { number: t('02'), title: t('Choose the right path'), text: t('We identify what needs to happen first and where the most practical value is.') },
        { number: t('03'), title: t('Build the system'), text: t('We design and develop pages and flows that support trust, contact and growth.') },
        { number: t('04'), title: t('Keep improving'), text: t('After launch, the work does not stop. We review what is working and what should be improved next.') },
      ],
    }}
    faq={{
      eyebrow: t('FAQ'),
      title: t('Questions we hear most often.'),
      items: [
        { q: t('Why did QCT Studio start?'), a: t('It started from a simple observation. Good businesses were improving, but their websites were still showing the business they used to be.') },
        { q: t('What kind of work does QCT Studio focus on?'), a: t('We focus on websites, e-commerce, WhatsApp Commerce, SEO, GEO and campaign landing pages.') },
        { q: t('Why do Balkan markets matter to your work?'), a: t('They are markets where businesses are investing, modernising and growing, but their digital systems have not always kept pace.') },
        { q: t('How does QCT Studio work with clients?'), a: t('We start by understanding the business first. Products. Services. Customers. Sales process. Only then do we decide what needs to be built.') },
        { q: t('Do you work on long-term projects?'), a: t('Yes. Business changes. The digital presence should change with it instead of being left alone after launch.') },
      ],
    }}
    final={{
      eyebrow: t('READY WHEN YOU ARE'),
      title: t('Start with the part of your digital presence that matters most.'),
      text: t('If your business is ready for a clearer and more serious online presence, we can help you decide what comes next.'),
      cta: t('Start Your Project'),
    }}
  />
  <Footer slot="footer" lang={lang} />
</BaseLayout>
