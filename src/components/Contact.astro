---
interface Props {
  lang: string;
}
const { lang } = Astro.props;

const copy = {
  en: {
    eyebrow: 'Balkan + international digital growth review',
    title: 'Discuss the commercial constraint before choosing the next digital step.',
    lead: 'Share the current website, target market and the point where discovery, enquiries or sales are breaking down. We will use that context to define the most practical first improvement.',
    direct: 'Direct contact',
    guidance: 'What to include',
    items: [
      ['Current situation', 'What the business sells, who it serves and which digital channels it uses today.'],
      ['Target market', 'The country, buyer group or commercial route the business needs to reach.'],
      ['Main constraint', 'Where product discovery, lead follow-up, conversion or internal operations currently slow down.'],
      ['Useful evidence', 'The existing website, catalogue, campaign page or workflow that should be reviewed.'],
    ],
    primary: 'Discuss Your Project',
    secondary: 'Email QCT Studio',
    note: 'No technical specification is required. A concise commercial brief is enough to begin.',
  },
  sq: {
    eyebrow: 'Rishikim i rritjes digjitale',
    title: 'Filloni me pengesën tregtare, jo me një mjet të paracaktuar.',
    lead: 'Ndani faqen aktuale, tregun e synuar dhe pikën ku zbulimi, kërkesat ose shitjet po ngecin. Këtë kontekst do ta përdorim për të përcaktuar hapin e parë më praktik.',
    direct: 'Kontakt i drejtpërdrejtë',
    guidance: 'Çfarë të përfshini',
    items: [
      ['Gjendja aktuale', 'Çfarë shet biznesi, kujt i shërben dhe cilat kanale digjitale përdor sot.'],
      ['Tregu i synuar', 'Vendi, grupi i blerësve ose rruga tregtare që biznesi duhet të arrijë.'],
      ['Pengesa kryesore', 'Ku po ngadalësohen zbulimi i produkteve, ndjekja e kërkesave, konvertimi ose operacionet.'],
      ['Dëshmi të dobishme', 'Faqja, katalogu, landing page ose procesi ekzistues që duhet shqyrtuar.'],
    ],
    primary: 'Kërkoni një rishikim të rritjes digjitale',
    secondary: 'Dërgoni email QCT Studio',
    note: 'Nuk kërkohet specifikim teknik. Mjafton një përmbledhje e qartë tregtare.',
  },
  mk: {
    eyebrow: 'Преглед на дигиталниот раст',
    title: 'Започнете од деловното ограничување, не од однапред избрана алатка.',
    lead: 'Споделете ја тековната веб-страница, целниот пазар и местото каде што запираат откривањето, барањата или продажбата. Тој контекст ќе ни помогне да го утврдиме најпрактичниот прв чекор.',
    direct: 'Директен контакт',
    guidance: 'Што да вклучите',
    items: [
      ['Тековна состојба', 'Што продава бизнисот, кому му служи и кои дигитални канали ги користи денес.'],
      ['Целен пазар', 'Државата, групата купувачи или продажниот пат што треба да се достигне.'],
      ['Главно ограничување', 'Каде се забавуваат откривањето производи, следењето барања, конверзијата или операциите.'],
      ['Корисни докази', 'Постојната веб-страница, каталог, landing page или процес што треба да се разгледа.'],
    ],
    primary: 'Побарајте преглед на дигиталниот раст',
    secondary: 'Испратете е-пошта до QCT Studio',
    note: 'Не е потребна техничка спецификација. Доволен е краток и јасен деловен опис.',
  },
  sr: {
    eyebrow: 'Pregled digitalnog rasta',
    title: 'Počnite od poslovnog ograničenja, ne od unapred izabranog alata.',
    lead: 'Podelite trenutni sajt, ciljno tržište i tačku na kojoj otkrivanje, upiti ili prodaja zastaju. Taj kontekst koristimo da odredimo najpraktičniji prvi korak.',
    direct: 'Direktan kontakt',
    guidance: 'Šta uključiti',
    items: [
      ['Trenutna situacija', 'Šta biznis prodaje, kome služi i koje digitalne kanale danas koristi.'],
      ['Ciljno tržište', 'Država, grupa kupaca ili prodajni put koji biznis treba da dosegne.'],
      ['Glavno ograničenje', 'Gde se usporavaju otkrivanje proizvoda, praćenje upita, konverzija ili operacije.'],
      ['Korisni dokazi', 'Postojeći sajt, katalog, landing stranica ili proces koji treba pregledati.'],
    ],
    primary: 'Zatražite pregled digitalnog rasta',
    secondary: 'Pošaljite email QCT Studio',
    note: 'Tehnička specifikacija nije potrebna. Dovoljan je kratak i jasan poslovni opis.',
  },
  ro: {
    eyebrow: 'Analiză de creștere digitală pentru Balcani + internațional',
    title: 'Discută mai întâi constrângerea comercială, apoi alege următorul pas digital.',
    lead: 'Trimite website-ul actual, piața țintă și punctul în care discovery, solicitările sau vânzările se blochează. Folosim acest context pentru a defini prima îmbunătățire practică.',
    direct: 'Contact direct',
    guidance: 'Ce să incluzi',
    items: [
      ['Situația actuală', 'Ce vinde afacerea, cui se adresează și ce canale digitale folosește astăzi.'],
      ['Piața țintă', 'Țara, grupul de cumpărători sau traseul comercial pe care afacerea trebuie să îl atingă.'],
      ['Constrângerea principală', 'Unde încetinesc product discovery, follow-up-ul lead-urilor, conversia sau operațiunile interne.'],
      ['Dovezi utile', 'Website-ul, catalogul, landing page-ul sau workflow-ul existent care ar trebui analizat.'],
    ],
    primary: 'Discută proiectul',
    secondary: 'Trimite email QCT Studio',
    note: 'Nu este necesară o specificație tehnică. Un brief comercial concis este suficient pentru început.',
  },
  bg: {
    eyebrow: 'Преглед на дигиталния растеж за Балканите и чужбина',
    title: 'Обсъдете първо бизнес предизвикателството, преди да изберете следващата дигитална стъпка.',
    lead: 'Споделете текущия уебсайт, целевия пазар и мястото, където представянето на продукти, запитванията или продажбите срещат затруднения. Ще използваме този контекст, за да определим най-практичното първо подобрение.',
    direct: 'Директен контакт',
    guidance: 'Какво да включите',
    items: [
      ['Текуща ситуация', 'Какво продава бизнесът, кого обслужва и кои дигитални канали използва в момента.'],
      ['Целеви пазар', 'Държавата, целевата група купувачи или търговският път, които бизнесът иска да достигне.'],
      ['Основно затруднение', 'Къде представянето на продукти, отговорът на запитвания, конверсията или вътрешните операции се забавят.'],
      ['Полезни материали', 'Съществуващият уебсайт, каталог, целева страница или работен процес, които да разгледаме.'],
    ],
    primary: 'Обсъдете проекта си',
    secondary: 'Изпратете имейл на QCT Studio',
    note: 'Не е необходима предварителна техническа спецификация. Кратко и ясно търговско описание е напълно достатъчно.',
  },
};

const c = copy[lang as keyof typeof copy] ?? copy.en;
const reviewSubject = encodeURIComponent('QCT Studio digital growth review');
const reviewBody = encodeURIComponent('Current website:\nTarget market:\nMain commercial constraint:\nUseful links or context:\n');
const reviewUrl = `mailto:info@qctstudio.com?subject=${reviewSubject}&body=${reviewBody}`;
---
<section id="contact" class="qct-section qct-contact" aria-labelledby="qct-contact-title">
  <div class="container">
    <div class="qct-contact__grid">
      <div class="qct-contact__content">
        <p class="qct-section__eyebrow">{c.eyebrow}</p>
        <h2 id="qct-contact-title" class="qct-section__title">{c.title}</h2>
        <p class="qct-section__lead">{c.lead}</p>
        <p class="qct-contact__note">{c.note}</p>
        <div class="qct-contact__actions">
          <a class="qct-button qct-button--primary" href={reviewUrl} data-qct-cta="contact" data-cta-location="contact_primary">{c.primary}</a>
          <a class="qct-button qct-button--secondary" href="mailto:info@qctstudio.com" data-qct-cta="email" data-cta-location="contact_secondary">{c.secondary}</a>
        </div>
        <div class="qct-contact__direct">
          <span>{c.direct}</span>
          <a href="mailto:info@qctstudio.com" data-qct-cta="email" data-cta-location="contact_direct">info@qctstudio.com</a>
        </div>
      </div>

      <div class="qct-contact-review" aria-labelledby="qct-contact-guidance">
        <p class="qct-contact-review__eyebrow" id="qct-contact-guidance">{c.guidance}</p>
        <div class="qct-contact-review__list">
          {c.items.map(([title, description]) => (
            <article>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .qct-contact {
    background: #07080b;
    padding: clamp(60px, 8vw, 100px) 0;
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .qct-contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
  @media (min-width: 960px) {
    .qct-contact__grid {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: start;
    }
  }
  .qct-section__eyebrow {
    color: #00f5a0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: 0.85rem;
    text-transform: uppercase;
  }
  .qct-section__title {
    color: #ffffff;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 0 0 1.25rem 0;
  }
  .qct-section__lead {
    color: #9ca3af;
    font-size: 1.1rem;
    line-height: 1.65;
    margin: 0;
    max-width: 680px;
  }
  .qct-contact__note {
    color: #6b7280;
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 1.25rem 0 0;
    max-width: 680px;
  }
  .qct-contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .qct-contact__actions .qct-button--primary {
    background: #00f5a0;
    color: #07080b;
    font-weight: 800;
    padding: 0.9rem 2rem;
    border-radius: 9999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 25px rgba(0, 245, 160, 0.35);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .qct-contact__actions .qct-button--primary:hover {
    background: #22f8ab;
    transform: translateY(-2px);
    box-shadow: 0 0 35px rgba(0, 245, 160, 0.55);
  }
  .qct-contact__actions .qct-button--secondary {
    background: rgba(255, 255, 255, 0.05);
    color: #f3f4f6;
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-weight: 600;
    padding: 0.9rem 2rem;
    border-radius: 9999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }
  .qct-contact__actions .qct-button--secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }
  .qct-contact__direct {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: grid;
    gap: 0.4rem;
    margin-top: 2.25rem;
    padding-top: 1.4rem;
  }
  .qct-contact__direct span,
  .qct-contact-review__eyebrow {
    color: #00f5a0;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .qct-contact__direct a {
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s;
  }
  .qct-contact__direct a:hover {
    color: #00f5a0;
  }
  .qct-contact-review {
    background: #0c0e14;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: clamp(1.5rem, 3vw, 2.4rem);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }
  .qct-contact-review__eyebrow {
    margin: 0 0 1.25rem;
  }
  .qct-contact-review__list {
    display: grid;
    gap: 0;
  }
  .qct-contact-review article {
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    display: grid;
    gap: 0.45rem;
    padding: 1.25rem 0;
  }
  .qct-contact-review article:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .qct-contact-review h3 {
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
  }
  .qct-contact-review p {
    color: #9ca3af;
    line-height: 1.6;
    margin: 0;
    font-size: 0.92rem;
  }
  @media (max-width: 640px) {
    .qct-contact__grid {
      gap: 1.5rem;
    }
    .qct-contact__actions {
      align-items: stretch;
      flex-direction: column;
      margin-top: 1.35rem;
    }
    .qct-contact__actions .qct-button {
      width: 100%;
      min-height: 48px;
    }
    .qct-contact__note {
      font-size: 0.88rem;
      line-height: 1.55;
      margin-top: 1rem;
    }
    .qct-contact__direct {
      margin-top: 1.4rem;
      padding-top: 1rem;
    }
    .qct-contact-review {
      padding: 1.25rem;
    }
    .qct-contact-review article {
      padding: 1rem 0;
    }
  }
</style>
