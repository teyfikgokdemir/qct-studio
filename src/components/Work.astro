---
import { useTranslations, getLocalizedUrl } from '../i18n';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const url = (path: string) => getLocalizedUrl(lang, path);

const workItems = [
	{
		modifier: 'qct-work-card--editorial',
		scene: 'editorial',
		badge: '01 // ARCHITECTURE',
		industry: t('Business Websites'),
		type: '',
		description: t('Professional websites built around your business, not around a template.'),
	},
	{
		modifier: 'qct-work-card--storefront',
		scene: 'storefront',
		badge: '02 // STOREFRONT',
		industry: t('E-commerce'),
		type: '',
		description: t('Online stores designed to make buying simple and managing products easy.'),
	},
	{
		modifier: 'qct-work-card--operations',
		scene: 'operations',
		badge: '03 // AI AUTOMATION',
		industry: t('AI Automation'),
		type: '',
		description: t('Automations that save time, reduce repetitive work and improve everyday operations.'),
	},
];

const labelSets: Record<string, string[]> = {
	en: ['Capability Concepts', 'Explore Capability', 'Overview', 'Services', 'Established business', 'Clear structure', 'Collection', 'Product', 'Cart', 'Checkout', 'Intake', 'Team review', 'Approved', 'CRM', 'Task handoff'],
	sq: ['Koncepte të Aftësive', 'Shiko Aftësinë', 'Përmbledhje', 'Shërbime', 'Biznes i konsoliduar', 'Strukturë e qartë', 'Koleksioni', 'Produkti', 'Shporta', 'Pagesa', 'Pranimi', 'Shqyrtim nga ekipi', 'Miratuar', 'CRM', 'Kalimi i detyrës'],
	mk: ['Концепти на Услуги', 'Истражете ја Услугата', 'Преглед', 'Услуги', 'Етаблирана компанија', 'Јасна структура', 'Колекција', 'Производ', 'Кошничка', 'Наплата', 'Прием', 'Проверка од тимот', 'Одобрено', 'CRM', 'Предавање задача'],
	sr: ['Koncepti Usluga', 'Istražite Uslugu', 'Pregled', 'Usluge', 'Etablirana kompanija', 'Jasna struktura', 'Kolekcija', 'Proizvod', 'Korpa', 'Plaćanje', 'Prijem', 'Pregled tima', 'Odobreno', 'CRM', 'Predaja zadatka'],
};
const L = labelSets[lang] ?? labelSets.en;
---
<section id="work" class="qct-section qct-work qct-work-elite" aria-labelledby="qct-work-title">
	<div class="container">
		<div class="qct-section__header qct-section__header--split">
			<div>
				<div class="elite-eyebrow-pill">
					<span class="pill-dot"></span>
					<span>{L[0]}</span>
				</div>
				<h2 id="qct-work-title" class="qct-section__title">
					{t('Every project starts with a business.')}<br />
					<span class="text-emerald">{t('Not a template.')}</span>
				</h2>
			</div>
			<p class="qct-section__lead elite-work-lead">
				{t('Every company has different goals.')}<br />
				{t('Different customers.')}<br />
				{t('Different challenges.')}<br />
				{t('Different opportunities.')}<br />
				{t('That is why we never start with a design.')}<br />
				{t('We start by understanding the business.')}
			</p>
		</div>

		<div class="qct-work-showcase" data-work-showcase>
			<div class="qct-work__grid" aria-live="polite">
				{workItems.map((item, index) => (
					<article class={`qct-work-card ${item.modifier}${index === 0 ? ' is-active' : ''}`} data-work-panel={index}>
						<div class="qct-work-card__preview" aria-hidden="true">
							{item.scene === 'editorial' && (
								<div class="qct-work-editorial">
									<header class="qct-work-editorial__bar"><i></i><b>QCT</b><nav><span>{L[2]}</span><span>{L[3]}</span></nav></header>
									<div class="qct-work-editorial__hero"><small>{L[4]}</small><strong>{L[5]}</strong><p></p><button type="button" tabindex="-1">{L[3]}</button></div>
									<div class="qct-work-editorial__columns"><i></i><i></i><i></i></div>
									<aside class="qct-work-editorial__mobile"><b>QCT</b><i></i><i></i><i></i></aside>
								</div>
							)}
							{item.scene === 'storefront' && (
								<div class="qct-work-store">
									<header><strong>{L[6]}</strong><span>{L[8]}</span></header>
									<div class="qct-work-store__products">
										<article><i></i><small>{L[7]}</small></article>
										<article><i></i><small>{L[7]}</small></article>
										<article><i></i><small>{L[7]}</small></article>
										<article><i></i><small>{L[7]}</small></article>
									</div>
									<aside class="qct-work-store__cart"><strong>{L[8]}</strong><i></i><i></i><button type="button" tabindex="-1">{L[9]}</button></aside>
								</div>
							)}
							{item.scene === 'operations' && (
								<div class="qct-work-ops">
									<section class="qct-work-ops__intake"><small>{L[10]}</small><strong>{item.industry}</strong><i></i></section>
									<section class="qct-work-ops__review"><small>{L[11]}</small><strong>{L[12]}</strong><i></i></section>
									<div class="qct-work-ops__routes">
										<section><strong>{L[13]}</strong><small>{L[12]}</small></section>
										<section><strong>{L[14]}</strong><small>{L[12]}</small></section>
									</div>
								</div>
							)}
						</div>

						<div class="qct-work-card__meta">
							<span class="elite-work-badge">{item.badge}</span>
							<p>{item.industry}</p>
							<span>{item.type}</span>
						</div>

						<div class="qct-work-card__body">
							<p>{item.description}</p>
						</div>

						<a class="qct-work-card__link elite-work-link" href={url('/contact/')}>
							<span>{L[1]}</span>
							<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
								<path d="M2.5 7H11.5M11.5 7L7.5 3M11.5 7L7.5 11" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</a>
					</article>
				))}
			</div>
			<div class="qct-work-showcase__controls">
				<button type="button" data-work-previous aria-label={workItems[2].industry}>&#8592;</button>
				<div class="qct-work-showcase__steps" role="group" aria-label={L[0]}>
					{workItems.map((item, index) => (
						<button type="button" data-work-control={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-label={item.industry}><span>{item.industry}</span></button>
					))}
				</div>
				<button type="button" data-work-next aria-label={workItems[1].industry}>&#8594;</button>
			</div>
		</div>

		<p class="qct-section__lead elite-work-lead-bottom">
			{t('Every project is planned, designed and developed specifically for the business behind it.')}
		</p>
	</div>
</section>

<style>
.qct-work-elite {
	background: #07080b !important;
	color: #f3f4f6 !important;
	padding: clamp(5rem, 8vw, 7.5rem) 0;
	border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.elite-eyebrow-pill {
	display: inline-flex;
	align-items: center;
	gap: 0.5rem;
	padding: 0.35rem 0.8rem;
	border: 1px solid rgba(255, 255, 255, 0.1);
	background: rgba(255, 255, 255, 0.04);
	border-radius: 999px;
	font-family: ui-monospace, SFMono-Regular, monospace;
	font-size: 0.65rem;
	letter-spacing: 0.14em;
	font-weight: 750;
	color: #9ca3af;
	margin-bottom: 1.25rem;
}

.pill-dot {
	width: 5px;
	height: 5px;
	border-radius: 50%;
	background: #00f5a0;
}

.text-emerald {
	color: #00f5a0;
	background: linear-gradient(135deg, #00f5a0 0%, #38bdf8 100%);
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
}

.qct-work-elite h2 {
	font-size: clamp(2.2rem, 4vw, 3.8rem) !important;
	font-weight: 850 !important;
	line-height: 1.05 !important;
	letter-spacing: -0.04em !important;
	color: #ffffff !important;
}

.elite-work-lead {
	color: #9ca3af !important;
	font-size: 1.05rem !important;
	line-height: 1.65 !important;
}

.qct-work-elite .qct-work-card {
	background: #0d0f15 !important;
	border: 1px solid rgba(255, 255, 255, 0.08) !important;
	border-radius: 14px !important;
	padding: 1.75rem !important;
	transition: all 0.25s ease !important;
}

.qct-work-elite .qct-work-card:hover {
	border-color: rgba(0, 245, 160, 0.35) !important;
	box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 24px rgba(0, 245, 160, 0.08) !important;
}

.elite-work-badge {
	font-family: ui-monospace, SFMono-Regular, monospace;
	font-size: 0.65rem;
	font-weight: 800;
	color: #00f5a0;
	letter-spacing: 0.1em;
	margin-bottom: 0.5rem;
	display: block;
}

.qct-work-elite .qct-work-card__meta p {
	color: #ffffff !important;
	font-size: 1.25rem !important;
	font-weight: 800 !important;
	margin: 0 !important;
}

.qct-work-elite .qct-work-card__body p {
	color: #9ca3af !important;
	font-size: 0.9rem !important;
	line-height: 1.6 !important;
	margin: 0.75rem 0 1.25rem !important;
}

.elite-work-link {
	display: inline-flex;
	align-items: center;
	gap: 0.45rem;
	font-family: ui-monospace, SFMono-Regular, monospace;
	font-size: 0.8rem;
	font-weight: 750;
	color: #00f5a0 !important;
	text-decoration: none;
	transition: gap 0.2s ease;
}

.elite-work-link:hover {
	gap: 0.75rem;
}

.elite-work-lead-bottom {
	text-align: center;
	color: #6b7280 !important;
	font-size: 0.95rem !important;
	margin-top: 3rem !important;
}
</style>
