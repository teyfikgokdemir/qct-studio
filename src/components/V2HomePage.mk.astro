---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalizedUrl, languages, languageNames } from '../i18n';

export interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const url = (path: string) => getLocalizedUrl(lang, path);
const title = 'QCT Studio — Системи за дигитален раст за балкански бизниси';
const description = 'QCT Studio поврзува повеќејазични веб-страници, трговија, видливост во пребарување, CRM и практична вештачка интелигенција за етаблирани бизниси во Албанија, Северна Македонија, Косово и Србија.';

const markets = [
  {
    id: 'albania', slug: 'albania', local: 'Shqipëri', name: 'Албанија',
    signal: 'Видливоста на социјалните мрежи е висока. Сопствената инфраструктура за конверзија не е.',
    metric: '83,1% користат социјални мрежи · 57,7% имаат веб-страница',
    source: 'INSTAT анкета за ИКТ во претпријатија, 2024',
    sourceUrl: 'https://www.instat.gov.al/en/themes/science-technology-and-innovation/information-and-communication-technologies-in-enterprises/',
    need: 'Пренесете ја побарувачката од Instagram, Facebook и WhatsApp во двојазичен, мерлив продажен систем.',
    playbook: ['Угостителство и директна побарувачка', 'Малопродажба и асистирана трговија', 'B2B веб-страници подготвени за извоз'],
  },
  {
    id: 'macedonia', slug: 'north-macedonia', local: 'Северна Македонија', name: 'Северна Македонија',
    signal: 'Поврзаноста е зрела. Е-продажбата кај компаниите сè уште заостанува зад ЕУ.',
    metric: '8,3% од претпријатијата реализирале е-продажба',
    source: 'Western Balkan E-commerce Report, 2024 (податоци од 2022)',
    sourceUrl: 'https://ecommerce.mk/en/western-balkan-ecommerce-report-2024/',
    need: 'Изградете доверба, повеќејазична конверзија и трговски операции со ниско оперативно оптоварување за етаблирани МСП.',
    playbook: ['Трговија со верификувана доверба', 'Повеќејазични системи за лидови', 'RFQ архитектура за извозници'],
  },
  {
    id: 'kosovo', slug: 'kosovo', local: 'Kosovë', name: 'Косово',
    signal: 'Бизнисите се поврзани и ориентирани кон социјални канали, но онлајн продажбата останува ограничена.',
    metric: '76,1% користат социјални мрежи · 4,8% пријавуваат онлајн продажба',
    source: 'OECD Digital Society / податоци за претпријатија, 2022',
    sourceUrl: 'https://www.oecd.org/en/publications/western-balkans-competitiveness-outlook-2024-kosovo_ff74ae0e-en/full-report/component-15.html',
    need: 'Задржете ја удобноста на комуникацијата преку пораки, но додајте сопствена содржина, CRM прибирање податоци и системско следење.',
    playbook: ['Трговија од социјални кон сопствени канали', 'Инки за побарувачка од дијаспората', 'Mobile-first прибирање лидови'],
  },
  {
    id: 'serbia', slug: 'serbia', local: 'Srbija', name: 'Србија',
    signal: 'Повеќето компании веќе имаат веб-страница. Јазот е во трансакциската зрелост.',
    metric: '85,0% имаат веб-страница · 28,4% продавале онлајн',
    source: 'Републички завод за статистика на Србија, 2024',
    sourceUrl: 'https://publikacije.stat.gov.rs/G2024/PdfE/G202416019.pdf',
    need: 'Претворете го постојното веб-присуство во мерлива продажба, локални плаќања, CRM и оперативна автоматизација.',
    playbook: ['Модернизација на трговијата', 'Редизајн воден од конверзија', 'Практични AI работни текови'],
  },
];

const systems = [
  { id: 'acquire', number: '01', label: 'Привлечи', title: 'Бидете пронајдени за проблемот што навистина го решавате.', copy: 'Пазарно специфични страници за услуги, техничко SEO, содржина што прво дава одговор и landing страници за платени кампањи изградени околу реална локална намера — не околу преведени листи со клучни зборови.', image: '/images/v2/hero-network.webp', items: ['Архитектура на намера на локален јазик', 'SEO + содржина за answer engines', 'Landing системи за платени кампањи'] },
  { id: 'convert', number: '02', label: 'Конвертирај', title: 'Претворете го вниманието во следлива комерцијална акција.', copy: 'Премиум веб-страници и трговски патеки што комбинираат доверба, локални реалности за плаќање, WhatsApp асистенција, јасни политики и мерење на ниво на настан.', image: '/images/v2/commerce-system.webp', items: ['Веб-страници водени од конверзија', 'Е-трговија и асистирано плаќање', 'Формулари, резервации и WhatsApp рутирање'] },
  { id: 'operate', number: '03', label: 'Операционализирај', title: 'Направете секој лид да биде видлив, ваш и применлив.', copy: 'Lean CRM канали, логика за follow-up, известување и AI работни текови со човечка проверка што го намалуваат рачното губење можности без да додаваат enterprise-комплексност.', image: '/images/v2/growth-operations.webp', items: ['CRM и атрибуција на извор', 'Рутирање лидови и SLA за одговор', 'Контролирани операции поддржани со AI'] },
];

const sectors = [
  ['Угостителство и туризам', 'Директни резервации, повеќејазична откриеност, репутација и сезонска побарувачка'],
  ['Малопродажба и трговија', 'Каталози, наплата, асистирана продажба, достава и животен циклус на клиентот'],
  ['B2B и извозници', 'Авторитет, технички докази, RFQ, дистрибутери и меѓународни лидови'],
  ['Клиники и услуги', 'Доверба, експертиза, закажувања, локална откриеност и прибирање податоци со почитување согласност'],
  ['Недвижности и градежништво', 'Доказ за проекти, побарувачка од дијаспората, квалификација и продажни канали'],
  ['ИКТ и професионални фирми', 'Извозно позиционирање, студии на случај, account-based страници и CRM follow-up'],
];

const faqs = [
  ['Дали ова е уште еден пакет за веб-дизајн?', 'Не. Веб-страницата е само еден слој од комерцијален систем. Заедно ги дефинираме пазарот, понудата, доказите за доверба, страниците за аквизиција, конверзиските настани, CRM предавањето и мерењето по лансирањето.'],
  ['Можете ли да гарантирате рангирање на Google или цитирање од AI?', 'Не може ниту еден кредибилен партнер. Ние ја градиме техничката, уредувачката и доказната основа потребна за индексирање, пронаоѓање и доверба, а потоа ја мериме видливоста и квалификуваните резултати по пазар.'],
  ['Дали ни треба целосна е-трговија од првиот ден?', 'Не секогаш. Во зависност од плаќањето, исполнувањето на нарачки, каталогот и зрелоста на тимот, вистинското прво издание може да биде продавница, каталог со асистирано нарачување, RFQ тек или систем за резервации.'],
  ['Како работите со четири пазари и јазици?', 'Секој јазик добива сопствена мапа на намера, native review, стабилен URL, canonical и реципрочен hreflang кластер. Не генерираме плитки градски страници и не го преведуваме истиот продажен аргумент механички.'],
  ['Каде се вклопува AI?', 'Откако основниот процес ќе биде стабилен. Користиме ограничени, проверливи работни текови за класификација на лидови, резимеа, поддршка за содржина или интерно знаење — не автономни ветувања или black-box замена на персонал.'],
];

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
};
---
<BaseLayout title={title} description={description} image="/images/v2/hero-network.webp" lang={lang} isHome={true} v2Home={true}>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <header slot="header" class="v2-header" data-v2-header>
    <a class="v2-brand" href="#top" aria-label="Почетна на QCT Studio"><i></i>QCT <b>Studio</b></a>
    <nav data-v2-nav aria-label="Главна навигација">
      <a href="#system">Систем</a><a href="#markets">Пазари</a><a href="#sectors">Сектори</a><a href="#proof">Докази</a><a href="#method">Метод</a>
    </nav>
    <div class="v2-header-actions">
      <div class="v2-languages" aria-label="Избор на јазик">
        <span class="v2-languages-label">Јазик</span>
        <div class="v2-languages-list">
          {Object.entries(languages).map(([code, label]) => <a class:list={{ active: code === lang }} href={getLocalizedUrl(code, '/')} hreflang={code} lang={code} aria-current={code === lang ? 'page' : undefined} aria-label={languageNames[code as keyof typeof languageNames]}>{label}</a>)}
        </div>
      </div>
      <a class="v2-header-cta" href={url('/contact/')}>Започнете проект <span>→</span></a>
      <button class="v2-menu-button" type="button" data-v2-menu aria-expanded="false" aria-controls="v2-navigation"><span></span><span></span><span class="screen-reader-text">Отвори мени</span></button>
    </div>
  </header>

  <div id="top" class="v2-shell" data-v2-home>
    <div class="v2-scroll-progress" data-v2-progress></div>
    <section class="hero">
      <div class="hero-media" aria-hidden="true"><img src="/images/v2/hero-network.webp" width="2200" height="943" fetchpriority="high" alt="" /><div class="hero-wash"></div></div>
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-content">
        <div class="hero-kicker">● Системи за дигитален раст за балкански бизниси</div>
        <h1>Претворете ја регионалната побарувачка во <em>сопствен систем за раст.</em></h1>
        <div class="hero-bottom"><p>Ги поврзуваме пазарното истражување, повеќејазичните веб-страници, трговијата, видливоста во пребарување, CRM и практичната вештачка интелигенција — за етаблираните бизниси да привлекуваат, конвертираат и работат со јасност.</p><div class="hero-actions"><a class="v2-button primary" href={url('/regional-growth-diagnostic/')}>Мапирај го мојот систем за раст <span>→</span></a><a class="v2-button ghost" href="#markets">Истражете ја пазарната побарувачка <span>↘</span></a></div></div>
        <div class="hero-status"><span><i></i>Работиме со Албанија · Северна Македонија · Косово · Србија</span><span>EN · SQ · MK · SR</span><span>Од стратегија до операција</span></div>
      </div>
    </section>

    <section class="statement section-pad" data-reveal><div class="section-label"><i></i><b>Промената</b></div><div class="statement-grid"><h2>На вашиот пазар не му треба <em>уште една привлечна почетна страница.</em></h2><div><p>Му треба систем што разбира како локалните купувачи откриваат, проверуваат, пишуваат, купуваат и продолжуваат со комуникација.</p><p class="muted">Нашата работа започнува со комерцијалните пречки — не со layout-и. Идентификуваме каде истекува побарувачката, а потоа го градиме најмалиот кредибилен систем што го решава тоа.</p></div></div></section>

    <section id="markets" class="markets section-pad">
      <div data-reveal><div class="section-label"><i></i><b>Пазарна интелигенција</b></div><div class="section-heading"><h2>Еден регион.<br /><em>Четири различни дигитални јазови.</em></h2><p>Локалната побарувачка ја менува архитектурата. Изберете пазар за да го видите комерцијалниот јаз што нашиот систем е дизајниран да го затвори.</p></div></div>
      <div class="market-interface">
        <div class="market-tabs" role="tablist" aria-label="Целни пазари">{markets.map((market, index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-market-tab={market.id}><span>0{index + 1}</span><b>{market.local}</b><small>{market.name}</small><i>→</i></button>)}</div>
        <div class="market-panels">{markets.map((market, index) => <article class:list={['market-panel', { 'is-active': index === 0 }]} data-market-panel={market.id} role="tabpanel"><div class="market-panel-top"><span>Верификуван пазарен сигнал</span><b>ПОДАТОЦИ</b></div><h3>{market.signal}</h3><div class="market-metric"><strong>{market.metric}</strong><a href={market.sourceUrl} target="_blank" rel="noopener noreferrer">{market.source} ↗</a></div><p>{market.need}</p><div class="market-playbook">{market.playbook.map((item) => <span>✓ {item}</span>)}</div><a class="text-link" href={url(`/markets/${market.slug}/`)}>Истражете го пазарниот систем за {market.name} <span>→</span></a></article>)}</div>
      </div>
    </section>

    <section id="system" class="system-section section-pad">
      <div class="section-label"><i></i><b>QCT систем за раст</b></div><div class="section-heading wide"><h2>Три слоја.<br /><em>Еден одговорен систем.</em></h2><p>Без театар околу канали. Секој слој има дефинирана улога, сопственик и мерливо предавање.</p></div>
      <div class="system-tabs" role="tablist">{systems.map((item, index) => <button type="button" role="tab" aria-selected={index === 1 ? 'true' : 'false'} class:list={{ active: index === 1 }} data-system-tab={item.id}><span>{item.number}</span><b>{item.label}</b></button>)}</div>
      <div class="system-panels">{systems.map((item, index) => <article class:list={['system-stage', { 'is-active': index === 1 }]} data-system-panel={item.id}><div class="system-copy"><div class="system-chip">Слој {item.number}</div><h3>{item.title}</h3><p>{item.copy}</p><ul>{item.items.map((entry) => <li>✓ {entry}</li>)}</ul><a class="text-link" href={url('/contact/')}>Дизајнирајте го овој слој <span>→</span></a></div><div class="system-visual"><img src={item.image} width={item.id === 'acquire' ? 2200 : 1440} height={item.id === 'acquire' ? 943 : 1080} loading="lazy" decoding="async" alt="" /><div class="system-readout"><i></i><span>Статус на системот</span><b>Поврзан</b></div></div></article>)}</div>
    </section>

    <section id="sectors" class="sectors section-pad"><div class="section-label"><i></i><b>Секторски playbooks</b></div><div class="section-heading"><h2>Изградено околу <em>комерцијалната реалност.</em></h2><p>Се фокусираме на сектори каде довербата, повеќејазичната побарувачка, асистираното купување или оперативната комплексност создаваат реална основа за поврат.</p></div><div class="sector-list">{sectors.map(([name, value], index) => <article data-reveal><span>0{index + 1}</span><b>{name}</b><p>{value}</p><i>↘</i></article>)}</div></section>

    <section id="proof" class="proof section-pad"><div class="section-label"><i></i><b>Архитектура на докази</b></div><div class="section-heading wide"><h2>Докази пред <em>агенциски тврдења.</em></h2><p>Не објавуваме измислени резултати. Секој случај мора да го покаже почетниот проблем, точниот опфат, состојбата при лансирање и временскиот прозорец на атрибутивниот исход.</p></div><div class="proof-grid"><a class="proof-feature" href="https://ctseg.com.tr/" target="_blank" rel="noopener noreferrer"><div class="proof-art art-one"><span>CTSEG</span><i></i></div><div class="proof-copy"><small>Меѓународна трговија / B2B платформа</small><h3>Комплексните барања за sourcing претворени во проверлива комерцијална патека.</h3><p>Повеќејазична архитектура на услуги, евалуација на добавувачи, откривање производи и патеки за квалификувана проценка.</p></div></a><a class="proof-card" href={url('/work/phiaderm/')}><div class="proof-art art-two"><span>PHIADERM</span></div><div class="proof-copy"><small>Трговија / Откривање производи</small><h3>Премиум раскажување за производ со употреблива продажна патека.</h3><p>Структуриран каталог, едукација, уверување и конверзија.</p></div></a><a class="proof-card" href={url('/work/misima/')}><div class="proof-art art-three"><span>MISIMA</span></div><div class="proof-copy"><small>Производство / Извоз</small><h3>Капацитетите преточени во докази подготвени за дистрибутери.</h3><p>Архитектура на услуги, производствен доказ и RFQ патеки.</p></div></a></div><p class="proof-note">✓ Комерцијалните резултати се објавуваат само кога се достапни изворни податоци и дозвола од клиентот.</p></section>

    <section class="visibility section-pad"><div class="section-label"><i></i><b>SEO · AEO · GEO · AI видливост</b></div><div class="visibility-grid"><div class="visibility-title"><h2>Нема тајно markup решение.<br /><em>Има управуван систем на знаење.</em></h2><p>Видливоста во пребарување и AI ја делат истата основа: пристапна содржина, јасни ентитети, силни интерни врски, вистинити структурирани податоци и корисни докази.</p></div><div class="visibility-map" aria-label="QCT граф на ентитети"><div class="core-node"><b>QCT</b><span>Ентитет</span></div>{['Услуги','Пазари','Докази','Водичи','Луѓе','Политики'].map((node, index) => <div class={`orbit-node node-${index + 1}`}>{node}</div>)}</div></div><div class="principles"><article><b>Прво индексирање</b><p>Клучните одговори се во server-rendered текст и стабилни URL-адреси што може да се crawluvaat.</p></article><article><b>Вистинска локализација</b><p>Локализирани страници со self-canonical, реципрочен hreflang и native review.</p></article><article><b>Јасност за AI retrieval</b><p>Пасуси што прво одговараат, извори, авторство, датуми и експлицитни тврдења.</p></article><article><b>Мерено по пазар</b><p>Видливост, квалификувани посети, лидови и приход — не анегдотски prompts.</p></article></div></section>

    <section id="method" class="method section-pad"><div class="section-label"><i></i><b>Како градиме</b></div><div class="section-heading"><h2>Од докази до <em>оперативен систем.</em></h2><p>Фазна изградба што го штити буџетот, ги проверува претпоставките и ја држи сопственоста јасна.</p></div><ol class="method-list">{[
      ['Дијагностика','Аудит на пазар, понуда, податоци и истекување на побарувачка','Пред да дизајнираме, ги утврдуваме фактите, ограничувањата, базните настани и комерцијалните приоритети.'],
      ['Архитектура','Модел за информации, конверзија и мерење','Ги дефинираме URL-адресите по јазик и пазар, улогите на страниците, доказите за доверба, конверзиските акции и CRM предавањата.'],
      ['Изградба','Брзо повеќејазично искуство и интеграции','Испорачуваме во тестирани изданија со проверки за пристапност, перформанси и структурирани податоци.'],
      ['Операции','Мерете, учете и автоматизирајте го она што е стабилно','Ги следиме резултатите, ги подобруваме приоритетните патеки и додаваме контролирана автоматизација само таму каде што носи поврат.'],
