---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import CapabilityMarquee from '../components/CapabilityMarquee.astro';
import ArchitectureComparison from '../components/ArchitectureComparison.astro';
import ProjectEstimator from '../components/ProjectEstimator.astro';
import Problem from '../components/Problem.astro';
import Services from '../components/Services.astro';
import InsightsPreview from '../components/InsightsPreview.astro';
import Contact from '../components/Contact.astro';
import { getPageSeo } from '../i18n/seo';

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const seo = lang === 'en'
  ? {
      title: 'High-Performance Web Engineering, Astro Architecture & Dynamic SEO | QCT Studio',
      description: 'QCT Studio engineers ultra-fast Astro web platforms, headless commerce, WhatsApp conversion funnels and Dynamic SEO ready for Google and AI search discovery.',
    }
  : lang === 'sr'
    ? {
        title: 'QCT Studio — Vrhunski sajtovi, e-commerce i digitalni inženjering',
        description: 'QCT Studio projektuje ultra-brze veb platforme, headless e-commerce, konverzione prodavnice i Dinamički SEO spreman za Google i AI pretragu.',
      }
    : getPageSeo('home', lang);
---
<BaseLayout title={seo.title} description={seo.description} image="/qct-studio-og.jpg" lang={lang} isHome={true}>
<Header slot="header" lang={lang} />
<Hero lang={lang} />
<CapabilityMarquee lang={lang} />
<ArchitectureComparison lang={lang} />
<ProjectEstimator lang={lang} />
<Problem lang={lang} />
<Services lang={lang} />
<InsightsPreview lang={lang as 'en' | 'sq' | 'mk' | 'sr' | 'ro' | 'bg'} />
<Contact lang={lang} />
<Footer slot="footer" lang={lang} />
</BaseLayout>
