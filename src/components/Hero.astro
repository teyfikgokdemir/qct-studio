---
import { useTranslations } from '../i18n';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="qct-hero">
<div class="container qct-hero__inner">
<h1 class="qct-hero__title">{t('Websites, E-commerce & AI Automation for the Balkans')}</h1>
<p class="qct-hero__subtitle">
{t('QCT Studio helps businesses in Albania, Kosovo, North Macedonia and Turkey launch fast, multilingual, high-performing digital experiences.')}
</p>
<div class="qct-hero__cta">
<a href="#contact" class="qct-btn qct-btn--primary">{t('Get Started')}</a>
<a href="#services" class="qct-btn qct-btn--secondary">{t('Our Services')}</a>
</div>
</div>
</section>
<style>
.qct-hero {
padding-block: 6rem 4rem;
text-align: center;
}
.qct-hero__inner {
max-width: 760px;
margin: 0 auto;
}
.qct-hero__title {
font-size: clamp(2rem, 5vw, 3.25rem);
line-height: 1.15;
margin-bottom: 1.25rem;
}
.qct-hero__subtitle {
font-size: 1.15rem;
opacity: 0.8;
margin-bottom: 2.5rem;
line-height: 1.6;
}
.qct-hero__cta {
display: flex;
justify-content: center;
gap: 1rem;
flex-wrap: wrap;
}
.qct-btn {
padding: 0.75rem 1.75rem;
border-radius: 999px;
text-decoration: none;
font-weight: 600;
font-size: 0.95rem;
}
.qct-btn--primary {
background: var(--qct-accent);
color: #0d0d0d;
}
.qct-btn--secondary {
border: 1px solid rgba(255, 255, 255, 0.25);
color: var(--qct-fg);
}
</style>
