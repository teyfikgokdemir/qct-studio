---

<section class="hero-elite" aria-labelledby="qct-hero-title">
  <!-- Subtle technical grid background -->
  <div class="hero-elite__grid-bg" aria-hidden="true"></div>

  <div class="container hero-elite__layout">
    <div class="hero-elite__content">
      <!-- Status Badge -->
      <div class="hero-elite__badge">
        <span class="hero-elite__pulse"></span>
        <span class="hero-elite__badge-text">{copy.eyebrow}</span>
        <span class="hero-elite__badge-sep">/</span>
        <span class="hero-elite__badge-tag">EDITION 2026</span>
      </div>

      <!-- Main Headline -->
      <h1 id="qct-hero-title" class="hero-elite__heading">
        <span class="hero-elite__heading-main">{copy.titleA}</span>
        <span class="hero-elite__heading-accent">{copy.titleB}</span>
      </h1>

      <p class="hero-elite__lead">{copy.lead}</p>

      <!-- Action Buttons -->
      <div class="hero-elite__actions">
        <a class="btn-elite btn-elite--primary" href="#project-estimator" data-qct-cta="calculator" data-cta-location="hero">
          <span>{copy.primary}</span>
          <svg class="btn-elite__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a class="btn-elite btn-elite--ghost" href={url('/work/')} data-qct-cta="work" data-cta-location="hero">
          <span>{copy.secondary}</span>
          <svg class="btn-elite__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Verified Benchmarks Bar -->
      <div class="hero-elite__proof">
        <div class="proof-metric">
          <span class="proof-metric__label">{copy.from}</span>
          <span class="proof-metric__val proof-metric__val--emerald">{copy.fromPrice}</span>
        </div>
        <div class="proof-divider" aria-hidden="true"></div>
        <div class="proof-metric">
          <span class="proof-metric__label">{copy.campaign}</span>
          <span class="proof-metric__val">{copy.campaignMain}</span>
          <span class="proof-metric__sub">{copy.campaignSub}</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Precision Telemetry Console -->
    <div class="hero-elite__console" aria-label={copy.console}>
      <div class="hud-box">
        <!-- HUD Header -->
        <div class="hud-box__header">
          <div class="hud-box__status">
            <span class="hud-status-dot"></span>
            <span class="hud-status-name">{copy.console}</span>
          </div>
          <div class="hud-box__badge">
            <span class="hud-live-tag">{copy.live}</span>
            <span class="hud-market">{copy.market}</span>
          </div>
        </div>

        <!-- Telemetry Live Metrics Grid -->
        <div class="hud-metrics">
          <div class="hud-metric-card hud-metric-card--highlight">
            <div class="hud-metric-card__top">
              <span class="hud-metric-label">CORE WEB VITALS</span>
              <span class="hud-metric-tag">PASSED</span>
            </div>
            <div class="hud-metric-number">100<small>/100</small></div>
            <div class="hud-metric-desc">PageSpeed & A11y Rating</div>
            <div class="hud-progress-bar"><div class="hud-progress-fill" style="width: 100%;"></div></div>
          </div>

          <div class="hud-metric-card">
            <div class="hud-metric-card__top">
              <span class="hud-metric-label">EDGE TTFB</span>
              <span class="hud-metric-tag hud-metric-tag--cyan">&lt; 28ms</span>
            </div>
            <div class="hud-metric-number">0.24<small>s</small></div>
            <div class="hud-metric-desc">Avg. Full Render Time</div>
            <div class="hud-progress-bar"><div class="hud-progress-fill hud-progress-fill--cyan" style="width: 96%;"></div></div>
          </div>
        </div>

        <!-- Architecture Pipeline Flow -->
        <div class="hud-pipeline">
          <div class="hud-pipeline__step">
            <span class="hud-step-num">01</span>
            <span class="hud-step-title">{copy.website}</span>
            <span class="hud-step-meta">Static + Island</span>
          </div>
          <div class="hud-pipeline__arrow" aria-hidden="true">→</div>
          <div class="hud-pipeline__step">
            <span class="hud-step-num">02</span>
            <span class="hud-step-title">{copy.search}</span>
            <span class="hud-step-meta">GEO & JSON-LD</span>
          </div>
          <div class="hud-pipeline__arrow" aria-hidden="true">→</div>
          <div class="hud-pipeline__step hud-pipeline__step--accent">
            <span class="hud-step-num">03</span>
            <span class="hud-step-title">{copy.commerce}</span>
            <span class="hud-step-meta">WhatsApp & Direct</span>
          </div>
        </div>

        <!-- Realtime Telemetry Feed -->
        <div class="hud-stream">
          <div class="hud-stream__line">
            <span class="stream-code">200 OK</span>
            <span class="stream-route">GET /architecture</span>
            <span class="stream-stat">14ms · 0KB JS</span>
          </div>
          <div class="hud-stream__line">
            <span class="stream-code stream-code--geo">GEO/AI</span>
            <span class="stream-route">Schema Graph Verified</span>
            <span class="stream-stat">ChatGPT + Perplexity</span>
          </div>
          <div class="hud-stream__line">
            <span class="stream-code stream-code--green">CONV</span>
            <span class="stream-route">{copy.metric2}</span>
            <span class="stream-stat">Instant Checkout</span>
          </div>
        </div>

        <!-- HUD Footer -->
        <div class="hud-box__footer">
          <span class="hud-footer-stack">{copy.proof1}</span>
          <span class="hud-footer-hash">HASH: 99.99% UPTIME</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.hero-elite {
  position: relative;
  background-color: #07080b;
  color: #f3f4f6;
  padding: clamp(5.5rem, 8.5vw, 8rem) 0 clamp(3.5rem, 5vw, 5.5rem);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
  isolation: isolate;
}

/* Subtle Technical Grid Background */
.hero-elite__grid-bg {
  position: absolute;
  inset: 0;
  background-image: 
    linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(circle at 60% 40%, black 25%, transparent 75%);
  pointer-events: none;
  z-index: -1;
}

.hero-elite__layout {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(420px, 0.9fr);
  gap: clamp(2.5rem, 5vw, 5rem);
  align-items: center;
}

/* Badge */
.hero-elite__badge {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  padding: 0.35rem 0.85rem;
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 9999px;
  margin-bottom: 1.85rem;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.68rem;
  letter-spacing: 0.12em;
}

.hero-elite__pulse {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #00f5a0;
  box-shadow: 0 0 10px #00f5a0, 0 0 0 3px rgba(0, 245, 160, 0.2);
}

.hero-elite__badge-text {
  font-weight: 700;
  color: #e5e7eb;
}

.hero-elite__badge-sep {
  color: rgba(255, 255, 255, 0.25);
}

.hero-elite__badge-tag {
  color: #00f5a0;
  font-weight: 600;
}

/* Headings */
.hero-elite__heading {
  margin: 0;
  font-size: clamp(2.2rem, 3.8vw, 3.6rem);
  line-height: 1.1;
  letter-spacing: -0.03em;
  font-weight: 800;
  max-width: 28ch;
  text-wrap: balance;
}

.hero-elite__heading-main {
  display: block;
  color: #ffffff;
}

.hero-elite__heading-accent {
  display: block;
  color: #00f5a0;
  background: linear-gradient(135deg, #00f5a0 0%, #38bdf8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-elite__lead {
  font-size: clamp(1.02rem, 1.15vw, 1.15rem);
  line-height: 1.65;
  color: #9ca3af;
  margin: 1.5rem 0 0;
  max-width: 620px;
}

/* Actions */
.hero-elite__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
  margin-top: 2rem;
}

.btn-elite {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  min-height: 52px;
  padding: 0 1.5rem;
  border-radius: 8px;
  font-size: 0.88rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  text-decoration: none;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.btn-elite--primary {
  background: #00f5a0;
  color: #07080b;
  border: 1px solid #00f5a0;
  box-shadow: 0 0 20px rgba(0, 245, 160, 0.25);
}

.btn-elite--primary:hover {
  background: #1affb0;
  transform: translateY(-2px);
  box-shadow: 0 4px 28px rgba(0, 245, 160, 0.4);
}

.btn-elite--ghost {
  background: rgba(255, 255, 255, 0.04);
  color: #e5e7eb;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.btn-elite--ghost:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.28);
  color: #ffffff;
  transform: translateY(-2px);
}

.btn-elite__icon {
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.btn-elite:hover .btn-elite__icon {
  transform: translateX(2px);
}

/* Benchmarks Bar */
.hero-elite__proof {
  display: flex;
  align-items: center;
  gap: 1.75rem;
  margin-top: 2.25rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  max-width: 620px;
}

.proof-metric {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.proof-metric__label {
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: 0.62rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #6b7280;
  font-weight: 700;
}

.proof-metric__val {
  font-size: 1.25rem;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: -0.02em;
}

.proof-metric__val--emerald {
  color: #00f5a0;
}

.proof-metric__sub {
  font-size: 0.7rem;
  color: #6b7280;
}

.proof-divider {
  width: 1px;
  height: 38px;
  background: rgba(255, 255, 255, 0.1);
}

/* Telemetry Console (HUD) */
.hero-elite__console {
  position: relative;
}

.hud-box {
  background: #0d0f15;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 14px;
  padding: 1.35rem;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  position: relative;
}

.hud-box__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 0.95rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.hud-box__status {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.hud-status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #00f5a0;
  box-shadow: 0 0 8px #00f5a0;
}

.hud-status-name {
  font-family: ui-monospace, SFMono-Regular, monospace;
