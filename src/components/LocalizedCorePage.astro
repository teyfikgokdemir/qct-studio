const {lang,page}=Astro.props;
const data={
 ro:{
  about:{title:'Despre QCT Studio — Partener digital pentru Balcani',description:'QCT Studio construiește site-uri, e-commerce, vizibilitate și sisteme digitale pentru companii din Balcani.',eyebrow:'DESPRE QCT STUDIO',h1:'Un studio mic, construit pentru muncă digitală serioasă.',lead:'QCT Studio a fost fondat la Istanbul de Teyfik Gökdemir pentru companii care au evoluat în realitate, dar a căror prezență digitală a rămas în urmă.',cards:[['Business înainte de design','Începem cu oferta, clientul, piața și procesul comercial înainte de a lua decizii de design.'],['Sisteme conectate','Site-ul, căutarea, e-commerce-ul, WhatsApp și automatizarea sunt planificate ca un singur parcurs.'],['Lucru măsurabil','Analytics, conversiile și calitatea solicitărilor sunt tratate ca parte a livrării, nu ca adaos.']],cta:'Discutați un proiect'},
  'ai-automation':{title:'Automatizare AI pentru procese de business — QCT Studio',description:'Automatizări AI practice pentru lead routing, follow-up, CRM și sarcini repetitive, cu control uman asupra deciziilor importante.',eyebrow:'AI AUTOMATION',h1:'Automatizare practică pentru procese care consumă timp.',lead:'Începem cu workflow-ul, nu cu instrumentul. Identificăm pașii repetitivi, regulile, excepțiile și punctele unde o persoană trebuie să rămână în control.',cards:[['Lead routing','Clasificarea și direcționarea solicitărilor către persoana sau pipeline-ul potrivit.'],['Follow-up și handoff','Task-uri, notificări și pași următori pregătiți consecvent.'],['CRM și operațiuni','Datele aprobate pot fi sincronizate între instrumentele potrivite fără a ascunde responsabilitatea umană.']],cta:'Discutați workflow-ul'},
  careers:{title:'Cariere la QCT Studio — Lucru digital cu responsabilitate',description:'QCT Studio caută oameni responsabili, clari în comunicare și interesați de muncă digitală utilă pentru companii din Balcani.',eyebrow:'CARIERE',h1:'O echipă mică pentru oameni care își asumă munca.',lead:'Ne interesează judecata, comunicarea și standardele constante mai mult decât titlurile. Lucrăm remote și păstrăm deciziile aproape de proiect.',cards:[['Responsabilitate','Oamenii de aici își asumă problema din fața lor și nu așteaptă să fie împinși.'],['Comunicare clară','Scrisul clar și update-urile utile reduc buclele inutile și mențin proiectul vizibil.'],['Curiozitate și judecată','Întrebările bune și capacitatea de a prioritiza contează mai mult decât a pretinde că știi tot.']],cta:'Contact pentru carieră'},
  contact:{title:'Contact QCT Studio — Discutați proiectul digital',description:'Contactați QCT Studio pentru website, e-commerce, SEO, GEO, Dynamic SEO, landing pages și automatizare AI în Balcani.',eyebrow:'CONTACT',h1:'Începeți cu contextul comercial.',lead:'Trimiteți numele companiei, site-ul dacă există, piața țintă, ce trebuie îmbunătățit și intervalul dorit. Un prim mesaj clar este suficient.',cards:[['Proiecte','Website, e-commerce, SEO/GEO, Dynamic SEO, landing pages, WhatsApp Commerce și automatizare.'],['Piață și limbă','Spuneți-ne țara, orașul și limbile relevante pentru parcursul clientului.'],['Pasul următor','Răspundem cu cel mai practic pas: o discuție, o estimare de scope sau informațiile care lipsesc.']],cta:'Trimiteți un mesaj'},
  'cookie-policy':{title:'Politica de cookie-uri — QCT Studio',description:'Informații clare despre cookie-uri, stocarea în browser, analytics și controalele disponibile pe site-ul QCT Studio.',eyebrow:'COOKIE POLICY',h1:'Cum poate folosi acest site cookie-uri.',lead:'Cookie-urile și stocarea din browser pot susține funcțiile esențiale, măsurarea performanței și preferințele de bază.',cards:[['Cookie-uri esențiale','Pot susține securitatea, încărcarea paginilor, formularele și funcțiile necesare funcționării site-ului.'],['Analytics','Dacă analytics este activ, datele de utilizare pot fi folosite pentru a înțelege performanța și comportamentul agregat.'],['Servicii terțe','Hostingul, analytics sau instrumentele integrate pot seta propriile cookie-uri în funcție de serviciul folosit.']],cta:'Contact pentru întrebări'},
  'e-commerce':{title:'Dezvoltare e-commerce pentru Balcani — QCT Studio',description:'Magazine online mobile-first cu structură clară de produs, checkout de încredere și analytics pentru companii din Balcani.',eyebrow:'E-COMMERCE',h1:'Magazine care fac cumpărarea mai simplă și administrarea mai clară.',lead:'Un magazin pierde vânzări mult înainte de checkout dacă informația despre produs, livrarea, încrederea sau experiența mobilă creează ezitare.',cards:[['Structură de produs','Categorii, filtre și pagini de produs organizate pentru comparație și descoperire.'],['Checkout clar','Pași, opțiuni de plată și informații de livrare explicate înainte de angajament.'],['Administrare practică','Produsele, stocul, imaginile și conținutul trebuie să poată fi actualizate fără fricțiune tehnică inutilă.']],cta:'Discutați magazinul'},
  'meta-ads-landing-pages':{title:'Landing Pages pentru Meta Ads — QCT Studio',description:'Landing pages focalizate, aliniate cu mesajul reclamelor și construite pentru conversie, mobile UX și măsurare.',eyebrow:'META ADS LANDING PAGES',h1:'O reclamă bună merită o destinație construită pentru conversie.',lead:'Trimiterea tuturor campaniilor pe homepage creează fricțiune. Construim pagini dedicate care păstrează mesajul, reduc distragerile și fac următorul pas evident.',cards:[['Message match','Vizitatorul recunoaște imediat oferta și contextul reclamei.'],['Un obiectiv clar','Fiecare pagină prioritizează o acțiune comercială principală.'],['Pregătită pentru măsurare','Analytics, testarea și optimizarea ulterioară sunt planificate din start.']],cta:'Discutați campania'},
  'privacy-policy':{title:'Politica de confidențialitate — QCT Studio',description:'Informații despre datele pe care QCT Studio le poate primi prin website, solicitări de proiect și mesaje de carieră.',eyebrow:'CONFIDENȚIALITATE',h1:'Informații clare despre date și comunicare.',lead:'Putem primi date trimise prin e-mail sau formulare, detalii despre proiect, informații tehnice de bază și date de utilizare dacă analytics este activ.',cards:[['Cum folosim datele','Pentru a răspunde solicitărilor, a înțelege proiectele, a gestiona mesajele și a îmbunătăți site-ul.'],['Ce nu facem','Nu vindem date personale și nu folosim solicitările pentru marketing fără bază sau permisiune.'],['Drepturile dvs.','Puteți solicita informații, corectare sau ștergere acolo unde este aplicabil.']],cta:'Întrebări despre confidențialitate'},
