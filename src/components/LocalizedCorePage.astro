  services:{title:'Servicii de creștere digitală — QCT Studio',description:'Website design, e-commerce, WhatsApp Commerce, SEO/GEO, Dynamic SEO, landing pages și automatizare AI pentru companii din Balcani.',eyebrow:'SERVICII',h1:'Un sistem conectat, nu servicii izolate.',lead:'Fiecare serviciu poate funcționa independent, dar cele mai bune rezultate apar când descoperirea, site-ul, conversia și follow-up-ul sunt planificate împreună.',cards:[['Website & E-commerce','Experiențe premium pentru încredere, cumpărare și administrare.'],['SEO, GEO, AEO & AIO','Fundație tehnică și optimizare continuă pentru căutare clasică și AI.'],['Landing Pages & WhatsApp','Trasee mai clare de la campanii la solicitări și conversații.']],cta:'Alegeți punctul de pornire'},
  'terms-conditions':{title:'Termeni și condiții — QCT Studio',description:'Termeni în limbaj clar privind utilizarea site-ului QCT Studio, informațiile publicate, linkurile externe și acordurile de proiect.',eyebrow:'TERMENI ȘI CONDIȚII',h1:'Ce puteți aștepta când folosiți acest site.',lead:'Site-ul oferă informații despre QCT Studio și serviciile sale. Scope-ul, calendarul, livrabilele și condițiile comerciale ale unui proiect sunt confirmate separat în scris.',cards:[['Informații publice','Conținutul este menținut actualizat unde este practic, dar serviciile și detaliile se pot modifica.'],['Acorduri de proiect','Fiecare proiect are propriul scope și propriile condiții confirmate înainte de lucru.'],['Linkuri externe','Site-urile terțe sunt în afara controlului QCT Studio după ce părăsiți acest domeniu.']],cta:'Întrebări despre termeni'},
  'website-design':{title:'Website Design pentru companii din Balcani — QCT Studio',description:'Site-uri premium, rapide și responsive pentru companii care au nevoie de mai multă încredere, claritate și conversie.',eyebrow:'WEBSITE DESIGN',h1:'Un site care reprezintă compania pe care ați devenit-o.',lead:'Un business poate evolua ani de zile în timp ce site-ul rămâne în urmă. Reproiectăm experiența în jurul clienților, ofertei și următorului pas comercial.',cards:[['Poziționare clară','Primul ecran trebuie să explice rapid cine sunteți, pentru cine și de ce contează.'],['Mobile-first','Layout, CTA-uri și formulare planificate pentru decizii rapide pe ecrane mici.'],['Fundație tehnică','Performanță, structură semantică, SEO de bază și analytics pregătite pentru creștere.']],cta:'Discutați noul site'},
  'whatsapp-commerce':{title:'WhatsApp Commerce pentru vânzări și solicitări — QCT Studio',description:'Conectați site-ul, campaniile și produsele cu trasee WhatsApp mai clare pentru solicitări, suport și vânzări.',eyebrow:'WHATSAPP COMMERCE',h1:'Transformați mesajele într-un proces comercial mai clar.',lead:'WhatsApp poate aduce lead-uri, dar poate crea haos dacă fiecare conversație începe fără context. Pregătim pagini, CTA-uri și fluxuri care fac mesajul mai util din primul moment.',cards:[['Intrări clare','Butoanele și paginile trimit clientul în conversația potrivită cu context relevant.'],['Întrebări mai bune','Produsele, prețurile, disponibilitatea și livrarea sunt explicate înainte de chat.'],['Follow-up mai simplu','Fluxurile pot pregăti rezumate, task-uri și direcționare fără a elimina contactul uman.']],cta:'Discutați fluxul WhatsApp'}
