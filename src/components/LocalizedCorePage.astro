  'terms-conditions':{title:'Общи условия — QCT Studio',description:'Условия на ясен език за използването на сайта, публикуваната информация, външните връзки и проектните договорености.',eyebrow:'ОБЩИ УСЛОВИЯ',h1:'Какво можете да очаквате при използване на този сайт.',lead:'Сайтът предоставя информация за QCT Studio и услугите му. Scope, срокове, deliverables и търговски условия на всеки проект се потвърждават отделно писмено.',cards:[['Публична информация','Съдържанието се поддържа актуално, когато е практично, но услугите и детайлите могат да се променят.'],['Проектни договорености','Всеки проект има собствен scope и условия, потвърдени преди началото на работата.'],['Външни връзки','Сайтовете на трети страни са извън контрола на QCT Studio след напускане на този домейн.']],cta:'Въпроси за условията'},
  'website-design':{title:'Website Design за компании на Балканите — QCT Studio',description:'Премиум, бързи и responsive сайтове за компании, които се нуждаят от повече доверие, яснота и конверсии.',eyebrow:'WEBSITE DESIGN',h1:'Сайт, който представя компанията, в която сте се превърнали.',lead:'Един бизнес може да се развива с години, докато сайтът му изостава. Препроектираме изживяването около клиента, офертата и следващата търговска стъпка.',cards:[['Ясно позициониране','Първият екран трябва бързо да обяснява кои сте, за кого сте и защо има значение.'],['Mobile-first','Layout, CTA и форми, планирани за бързи решения на малък екран.'],['Техническа основа','Performance, semantic структура, базово SEO и analytics, готови за растеж.']],cta:'Обсъдете новия сайт'},
  'whatsapp-commerce':{title:'WhatsApp Commerce за продажби и запитвания — QCT Studio',description:'Свържете сайта, кампаниите и продуктите с по-ясни WhatsApp пътеки за запитвания, поддръжка и продажби.',eyebrow:'WHATSAPP COMMERCE',h1:'Превърнете съобщенията в по-ясен търговски процес.',lead:'WhatsApp може да носи lead-ове, но създава хаос, ако всеки разговор започва без контекст. Подготвяме страници, CTA и потоци, които правят първото съобщение по-полезно.',cards:[['Ясни входни точки','Бутоните и страниците изпращат клиента в правилния разговор с подходящ контекст.'],['По-добри въпроси','Продукти, цени, наличност и доставка се изясняват преди чата.'],['По-лесен follow-up','Потоците могат да подготвят резюмета, задачи и насочване без да премахват човешкия контакт.']],cta:'Обсъдете WhatsApp потока'}
 }
}[lang][page];
const url=(p:string)=>getLocalizedUrl(lang,p);
---
<BaseLayout title={data.title} description={data.description} lang={lang} pageType="WebPage" breadcrumbLabel={data.eyebrow}>
 <Header slot="header" lang={lang}/>
 <section class="lc hero container"><p class="eyebrow">{data.eyebrow}</p><h1>{data.h1}</h1><p class="lead">{data.lead}</p><a class="primary" href={page==='contact'?'mailto:info@qctstudio.com':url('/contact/')}>{data.cta}</a></section>
 <section class="lc section soft"><div class="container grid">{data.cards.map(([h,p])=><article><h2>{h}</h2><p>{p}</p></article>)}</div></section>
 <section class="lc final container"><h2>{data.h1}</h2><p>{data.lead}</p><a class="primary" href={page==='contact'?'mailto:info@qctstudio.com':url('/contact/')}>{data.cta}</a></section>
 <Footer slot="footer" lang={lang}/>
</BaseLayout>
<style>
.lc{text-align:center}.hero{padding:clamp(5rem,9vw,8rem) 0 4.5rem}.eyebrow{font-size:.72rem;font-weight:800;letter-spacing:.16em;color:var(--qct-color-accent,#e75757)}.hero h1,.final h2{font-size:clamp(2.25rem,4.8vw,4.8rem);line-height:.98;letter-spacing:-.05em;max-width:1100px;margin:.8rem auto;text-wrap:balance}.lead,.final p{max-width:820px;margin:1.2rem auto 2rem;line-height:1.75;opacity:.74}.primary{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:.9rem 1.35rem;border-radius:999px;background:var(--qct-color-accent,#e75757);color:#fff;text-decoration:none;font-weight:760}.section{padding:clamp(4rem,7vw,6rem) 0}.soft{background:rgba(255,255,255,.025);border-block:1px solid rgba(255,255,255,.08)}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.grid article{text-align:left;padding:1.6rem;border:1px solid rgba(255,255,255,.1);border-radius:20px;background:rgba(255,255,255,.02)}.grid h2{font-size:1.2rem;margin:0 0 .7rem}.grid p{line-height:1.65;opacity:.74;margin:0}.final{padding:clamp(4rem,8vw,7rem) 0}.final h2{font-size:clamp(2rem,3.8vw,3.7rem)}@media(max-width:800px){.grid{grid-template-columns:1fr}.hero h1{font-size:clamp(2.1rem,10vw,3rem)}}
</style>