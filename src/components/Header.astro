---
import { useTranslations, getLocalizedUrl, getPathWithoutLocale, languages, languageNames } from '../i18n';

interface Props {
  lang: string;
  languagePath?: string;
}
const { lang, languagePath } = Astro.props;
const t = useTranslations(lang);
const url = (path: string) => getLocalizedUrl(lang, path);

// Path of the current page with any locale prefix stripped, e.g. "/sq/about/" -> "/about/".
// Used so the language switcher links to the translated version of THIS page, not just home.
const currentPath = languagePath ?? getPathWithoutLocale(Astro.url.pathname);
const pricingLabel: Record<string, string> = { en: 'Pricing', sq: 'Çmimet', mk: 'Цени', sr: 'Cene', ro: 'Prețuri', bg: 'Цени' };
const isInsightsPath = /^\/insights(?:\/|$)/.test(currentPath);
const isWorkPath = /^\/work(?:\/|$)/.test(currentPath);
const isDiagnosticPath = /^\/regional-growth-diagnostic(?:\/|$)/.test(currentPath);
const switchLanguages = Object.entries(languages).filter(([code]) => {
  if (isDiagnosticPath) return ['en','sq','mk','sr','ro','bg'].includes(code);
  if (isInsightsPath) return ['en','sq','mk','sr','ro','bg'].includes(code);
  if (isWorkPath) return ['en','sq','mk','sr','ro','bg'].includes(code);
  return true;
});
const hasRegionalWork = ['en','sq','mk','sr','ro','bg'].includes(lang);
const hasRegionalInsights = ['en','sq','mk','sr','ro','bg'].includes(lang);
---
<header id="masthead" class="site-header" data-site-header>
	<div class="mobile-menu-backdrop" data-mobile-backdrop hidden></div>
	<div class="site-header__inner container">
		<div class="site-branding">
			<a class="site-title" href={url('/')} rel="home">{t('QCT Studio')}</a>
		</div>

		<button class="site-menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" data-menu-toggle>
			<span class="screen-reader-text">{t('Open menu')}</span>
			<span class="site-menu-toggle__bar"></span>
			<span class="site-menu-toggle__bar"></span>
		</button>

		<nav id="site-navigation" class="main-navigation" aria-label={t('Primary menu')} aria-hidden="true">
			<div class="mobile-nav-head">
				<span class="mobile-nav-title">{t('Menu')}</span>
				<button class="mobile-nav-close" type="button" aria-label={t('Close menu')} data-mobile-close>
					<span aria-hidden="true">✕</span>
				</button>
			</div>
			<ul class="primary-menu">
				<li><a href={url('/')}>{t('Home')}</a></li>
				<li class="menu-item-has-children">
					<button class="submenu-toggle" type="button" aria-expanded="false" data-submenu-toggle>
						<span>{t('Services')}</span>
					</button>
					<ul class="sub-menu">
						<li><a href={url('/services/')}>{t('Services overview')}</a></li>
						<li><a href={url('/website-design/')}>{t('Website Design')}</a></li>
						<li><a href={url('/e-commerce/')}>{t('E-commerce')}</a></li>
						<li><a href={url('/whatsapp-commerce/')}>{t('WhatsApp Commerce')}</a></li>
						<li><a href={url('/seo-performance/')}>{t('SEO & Performance')}</a></li>
						<li><a href={url('/dynamic-seo/')}>{t('Dynamic SEO')}</a></li>
						<li><a href={url('/meta-ads-landing-pages/')}>{t('Meta Ads Landing Pages')}</a></li>
						<li><a href={url('/ai-automation/')}>{t('AI Automation')}</a></li>
					</ul>
				</li>
{hasRegionalWork && (				<li class="menu-item-has-children">
					<button class="submenu-toggle" type="button" aria-expanded="false" data-submenu-toggle>
						<span>{t('Work')}</span>
					</button>
					<ul class="sub-menu">
						<li><a href={url('/work/')}>{t('View Our Work')}</a></li>
						<li><a href={url('/contact/')}>{t('Talk to Our Team')}</a></li>
					</ul>
				</li>)}
				<li><a href={url('/pricing/')}>{pricingLabel[lang] ?? 'Pricing'}</a></li>
{hasRegionalInsights && <li><a href={url('/insights/')}>{t('Insights')}</a></li>}
				<li><a href={url('/about/')}>{t('About')}</a></li>
				<li><a href={url('/careers/')}>{t('Careers')}</a></li>
				<li><a href={url('/contact/')}>{t('Contact')}</a></li>
			</ul>
			<div class="site-language-switcher">
				<span class="site-language-switcher__icon" aria-hidden="true">
					<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9S14.5 18.4 12 21M12 3C9.5 5.6 8.2 8.6 8.2 12s1.3 6.4 3.8 9"></path></svg>
				</span>
				{switchLanguages.map(([code, label]) => (
					<a
						href={getLocalizedUrl(code, currentPath)}
						aria-current={code === lang ? 'true' : undefined}
						hreflang={code}
						lang={code}
						aria-label={`${languageNames[code as keyof typeof languageNames]} (${label})`}
					>{label}</a>
				))}
			</div>
		</nav>
	</div>
</header>

<style>
	.mobile-nav-head {
		display: none;
	}

	@media (max-width: 999px) {
		.mobile-nav-head {
			display: flex;
		}
	}
.site-language-switcher__icon{display:inline-grid;place-items:center;width:16px;height:16px;color:currentColor;opacity:.58;flex:0 0 16px}.site-language-switcher__icon svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
</style>
