---
import { useTranslations, getLocalizedUrl, getPathWithoutLocale, languages, languageNames } from '../i18n';
import Logo from './Logo.astro';

interface Props {
  lang: string;
  languagePath?: string;
}
const { lang, languagePath } = Astro.props;
const t = useTranslations(lang);
const url = (path: string) => getLocalizedUrl(lang, path);

const currentPath = languagePath ?? getPathWithoutLocale(Astro.url.pathname);
const pricingLabel: Record<string, string> = { en: 'Pricing', sq: 'Çmimet', mk: 'Цени', sr: 'Cene', ro: 'Prețuri', bg: 'Цени' };
const architectureLabel: Record<string, string> = {
  en: 'Architecture',
  sq: 'Arkitektura',
  mk: 'Архитектура',
  sr: 'Arhitektura',
  ro: 'Arhitectură',
  bg: 'Архитектура',
};
const ctaLabel: Record<string, string> = {
  en: 'ESTIMATE ↘',
  sq: 'VLERËSO ↘',
  mk: 'ПРОЦЕНИ ↘',
  sr: 'PROCENI ↘',
  ro: 'ESTIMEAZĂ ↘',
  bg: 'ОЦЕНИ ↘',
};
const isInsightsPath = /^\/insights(?:\/|$)/.test(currentPath);
const switchLanguages = Object.entries(languages).filter(([code]) => {
  if (isInsightsPath) return ['en','sq','mk','sr','ro','bg'].includes(code);
  return true;
});
const hasRegionalInsights = ['en','sq','mk','sr','ro','bg'].includes(lang);
---
<header id="masthead" class="site-header qct-elite-dock" data-site-header>
	<div class="mobile-menu-backdrop" data-mobile-backdrop hidden></div>
	
	<!-- Floating Island Dock Capsule -->
	<div class="site-header__inner qct-dock-capsule">
		<!-- Brand Logo -->
		<div class="site-branding">
			<a class="site-title" href={url('/')} rel="home" aria-label="QCT Studio Home">
				<Logo size="md" />
			</a>
		</div>

		<!-- Desktop Navigation Menu (Inside Capsule) -->
		<nav class="desktop-dock-nav" aria-label={t('Primary menu')}>
			<ul class="primary-menu qct-dock-links">
				<li><a href={url('/#architecture')}>{architectureLabel[lang] ?? 'Architecture'}</a></li>
				<li><a href={url('/#services')}>{t('Services')}</a></li>
				<li><a href={url('/dynamic-seo/')}>{t('Dynamic SEO')}</a></li>
				<li><a href={url('/pricing/')}>{pricingLabel[lang] ?? 'Pricing'}</a></li>
				{hasRegionalInsights && <li><a href={url('/insights/')}>{t('Insights')}</a></li>}
			</ul>
		</nav>

		<!-- Right Action Dock (Language Dropdown + CTA + Mobile Toggle) -->
		<div class="qct-dock-actions">
			<!-- Language Dropdown Pill (Desktop) -->
			<div class="qct-lang-dropdown" data-lang-dropdown>
				<button class="qct-lang-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Change language">
					<svg class="lang-globe-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="2" y1="12" x2="22" y2="12"></line>
						<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
					</svg>
					<span class="lang-current-code">{lang.toUpperCase()}</span>
					<svg class="lang-chevron-icon" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="6 9 12 15 18 9"></polyline>
					</svg>
				</button>
				<div class="qct-lang-menu" role="menu">
					{switchLanguages.map(([code, label]) => (
						<a
							class={`qct-lang-item ${code === lang ? 'is-active' : ''}`}
							href={getLocalizedUrl(code, currentPath)}
							hreflang={code}
							lang={code}
							role="menuitem"
						>
							<span class="lang-item-code">{code.toUpperCase()}</span>
							<span class="lang-item-name">{languageNames[code as keyof typeof languageNames]}</span>
							{code === lang && <span class="lang-item-dot" aria-hidden="true"></span>}
						</a>
					))}
				</div>
			</div>

			<!-- Desktop CTA Pill -->
			<a class="header-cta-pill qct-pill-cta desktop-only-cta" href={url('/#project-estimator')}>
				<span class="header-cta-pulse"></span>
				<span>{ctaLabel[lang] ?? 'ESTIMATE ↘'}</span>
			</a>

			<!-- Mobile Toggle Button -->
			<button class="site-menu-toggle qct-menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" data-menu-toggle>
				<span class="screen-reader-text">{t('Open menu')}</span>
				<span class="site-menu-toggle__bar"></span>
				<span class="site-menu-toggle__bar"></span>
			</button>
		</div>
	</div>

	<!-- Mobile Full Drawer (Direct Child of Masthead: Free from capsule containing block) -->
	<nav id="site-navigation" class="main-navigation mobile-nav-drawer" aria-label={t('Primary menu')}>
		<div class="mobile-nav-head">
			<div class="mobile-brand-wrap">
				<Logo size="sm" />
			</div>
			<button class="mobile-nav-close" type="button" aria-label={t('Close menu')} data-mobile-close>
				<span aria-hidden="true">✕</span>
			</button>
		</div>

		<ul class="primary-menu mobile-nav-links">
			<li><a href={url('/#architecture')}>{architectureLabel[lang] ?? 'Architecture'}</a></li>
			<li><a href={url('/#services')}>{t('Services')}</a></li>
			<li><a href={url('/dynamic-seo/')}>{t('Dynamic SEO')}</a></li>
			<li><a href={url('/pricing/')}>{pricingLabel[lang] ?? 'Pricing'}</a></li>
			{hasRegionalInsights && <li><a href={url('/insights/')}>{t('Insights')}</a></li>}
		</ul>

		<!-- Mobile Language Grid -->
		<div class="mobile-lang-section">
			<span class="mobile-lang-label">LANGUAGE</span>
			<div class="mobile-lang-grid">
				{switchLanguages.map(([code]) => (
					<a
						class={code === lang ? 'mobile-lang-pill is-active' : 'mobile-lang-pill'}
						href={getLocalizedUrl(code, currentPath)}
						hreflang={code}
						lang={code}
					>
						<span class="m-code">{code.toUpperCase()}</span>
						<span class="m-name">{languageNames[code as keyof typeof languageNames]}</span>
					</a>
				))}
			</div>
		</div>

		<!-- Mobile Bottom CTA -->
		<div class="mobile-cta-wrap">
			<a class="header-cta-pill qct-pill-cta" href={url('/#project-estimator')}>
				<span class="header-cta-pulse"></span>
				<span>{ctaLabel[lang] ?? 'ESTIMATE ↘'}</span>
			</a>
		</div>
	</nav>
</header>

<script is:inline>
(() => {
	// Language dropdown toggle for desktop
	const dropdown = document.querySelector('[data-lang-dropdown]');
	if (!dropdown) return;
	const trigger = dropdown.querySelector('.qct-lang-trigger');
	if (!trigger) return;

	trigger.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = dropdown.classList.toggle('is-open');
		trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
	});

	document.addEventListener('click', (e) => {
		if (!dropdown.contains(e.target)) {
			dropdown.classList.remove('is-open');
			trigger.setAttribute('aria-expanded', 'false');
		}
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && dropdown.classList.contains('is-open')) {
			dropdown.classList.remove('is-open');
			trigger.setAttribute('aria-expanded', 'false');
			trigger.focus();
		}
	});
})();
</script>

<style>
	/* Floating Island Dock Container */
	.qct-elite-dock {
		position: sticky;
		top: 1rem;
		z-index: 1000;
		background: transparent !important;
		border: none !important;
		padding: 0 1rem;
		pointer-events: none;
	}

	.qct-dock-capsule {
		pointer-events: auto;
		max-width: 1140px;
		height: 62px;
		margin: 0 auto;
		padding: 0 0.85rem 0 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: rgba(10, 12, 17, 0.82) !important;
		backdrop-filter: blur(28px) saturate(180%) !important;
		-webkit-backdrop-filter: blur(28px) saturate(180%) !important;
		border: 1px solid rgba(255, 255, 255, 0.1) !important;
		border-radius: 9999px !important;
		box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.12) !important;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.site-branding a {
		text-decoration: none;
		display: flex;
		align-items: center;
	}

	/* Desktop Navigation Links (Center) */
	.desktop-dock-nav {
		display: flex;
		align-items: center;
	}

	.qct-dock-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.qct-dock-links li a {
		color: #94a3b8 !important;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		font-size: 0.84rem !important;
		font-weight: 550 !important;
		letter-spacing: 0.01em;
		padding: 0.45rem 0.95rem !important;
		border-radius: 9999px;
		text-decoration: none !important;
		transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
		display: inline-flex;
		align-items: center;
	}

	.qct-dock-links li a:hover {
		color: #ffffff !important;
		background: rgba(255, 255, 255, 0.07) !important;
	}

	/* Action Dock (Right) */
	.qct-dock-actions {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
	}

	/* Language Dropdown (Desktop) */
	.qct-lang-dropdown {
		position: relative;
	}

	.qct-lang-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		height: 36px;
		padding: 0 0.75rem;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 9999px;
		color: #94a3b8;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		cursor: pointer;
		transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.qct-lang-trigger:hover,
	.qct-lang-dropdown.is-open .qct-lang-trigger,
	.qct-lang-dropdown:focus-within .qct-lang-trigger {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.18);
		color: #ffffff;
	}

	.lang-globe-icon {
		color: #00f5a0;
	}

	.lang-chevron-icon {
		transition: transform 0.2s ease;
		opacity: 0.65;
	}

	.qct-lang-dropdown.is-open .lang-chevron-icon {
		transform: rotate(180deg);
	}

	.qct-lang-menu {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		min-width: 175px;
		background: rgba(13, 15, 21, 0.96);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 14px;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.05);
		padding: 0.4rem;
		display: flex;
		flex-direction: column;
		gap: 2px;
		opacity: 0;
		visibility: hidden;
		transform: translateY(6px);
		pointer-events: none;
		transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 100;
	}

	.qct-lang-dropdown:hover .qct-lang-menu,
	.qct-lang-dropdown.is-open .qct-lang-menu,
	.qct-lang-dropdown:focus-within .qct-lang-menu {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		pointer-events: auto;
	}

	.qct-lang-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 0.75rem;
		border-radius: 8px;
		color: #94a3b8;
		text-decoration: none;
		font-size: 0.8rem;
		transition: all 0.15s ease;
	}

	.lang-item-code {
		font-family: ui-monospace, monospace;
		font-weight: 700;
		font-size: 0.72rem;
		color: #64748b;
		margin-right: 0.5rem;
	}

	.lang-item-name {
		flex-grow: 1;
		font-weight: 500;
		color: #cbd5e1;
	}

	.lang-item-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #00f5a0;
		box-shadow: 0 0 8px #00f5a0;
	}

	.qct-lang-item:hover {
		background: rgba(255, 255, 255, 0.06);
		color: #ffffff;
	}

	.qct-lang-item:hover .lang-item-name {
		color: #ffffff;
	}

	.qct-lang-item.is-active {
		background: rgba(0, 245, 160, 0.08);
	}

	.qct-lang-item.is-active .lang-item-code {
		color: #00f5a0;
	}

	.qct-lang-item.is-active .lang-item-name {
		color: #00f5a0;
		font-weight: 600;
	}

	/* Glowing CTA Pill */
	.qct-pill-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 38px;
		padding: 0 1.15rem;
		background: #00f5a0 !important;
		color: #07080b !important;
		border: 1px solid #00f5a0 !important;
		border-radius: 9999px;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-decoration: none;
		box-shadow: 0 0 20px rgba(0, 245, 160, 0.35);
		transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
		white-space: nowrap;
	}

	.qct-pill-cta:hover {
		background: #26fbb1 !important;
		box-shadow: 0 0 28px rgba(0, 245, 160, 0.55);
		transform: translateY(-1px);
	}

	.header-cta-pulse {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #07080b;
	}

	/* Mobile Toggle (Hidden on Desktop) */
	.qct-menu-toggle {
		display: none;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 9999px;
		width: 38px;
		height: 38px;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 4px;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.qct-menu-toggle:hover {
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.2);
	}

	.site-menu-toggle__bar {
		width: 18px;
		height: 2px;
		background: #ffffff;
		border-radius: 2px;
		transition: all 0.2s;
	}

	/* Mobile Drawer (Hidden on Desktop) */
	.mobile-nav-drawer {
		display: none;
	}

	/* Responsive Breakpoints (< 1000px) */
	@media (max-width: 999px) {
		.qct-elite-dock {
			top: 0.6rem;
			padding: 0 0.75rem;
		}

		.qct-dock-capsule {
			height: 54px;
			padding: 0 0.75rem 0 1rem;
		}

		.desktop-dock-nav,
		.desktop-only-cta,
		.qct-lang-dropdown {
			display: none !important;
		}

		.qct-menu-toggle {
			display: flex;
		}

		/* Mobile Drawer Overlay: Fixed to True Viewport */
		.mobile-nav-drawer {
			display: flex;
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			width: 100% !important;
			max-width: 100vw !important;
			height: 100dvh !important;
			background: rgba(10, 12, 17, 0.98) !important;
			backdrop-filter: blur(28px) saturate(180%) !important;
			-webkit-backdrop-filter: blur(28px) saturate(180%) !important;
			flex-direction: column;
			align-items: stretch;
			padding: 0;
			transform: translateY(-8px);
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
			z-index: 9999;
			overflow-y: auto;
			pointer-events: none;
		}

		.mobile-nav-drawer.is-open {
			transform: translateY(0);
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
		}

		.mobile-nav-head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 1.25rem 1.5rem;
			border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		}

		.mobile-nav-close {
			background: rgba(255, 255, 255, 0.05);
			border: 1px solid rgba(255, 255, 255, 0.1);
			border-radius: 50%;
			width: 34px;
			height: 34px;
			display: flex;
			align-items: center;
			justify-content: center;
			color: #ffffff;
			font-size: 0.9rem;
			cursor: pointer;
		}

		.mobile-nav-links {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			padding: 1.25rem 1rem;
			gap: 0.35rem;
			list-style: none;
			margin: 0;
		}

		.mobile-nav-links li a {
			font-size: 1rem !important;
			padding: 0.85rem 1.15rem !important;
			border-radius: 12px;
			color: #94a3b8 !important;
			text-decoration: none !important;
			display: block;
			transition: all 0.2s ease;
		}

		.mobile-nav-links li a:hover {
			color: #ffffff !important;
			background: rgba(255, 255, 255, 0.06) !important;
		}

		/* Mobile Language Switcher Section */
		.mobile-lang-section {
			display: flex;
			flex-direction: column;
			padding: 0 1.25rem;
			margin-top: 0.5rem;
		}

		.mobile-lang-label {
			font-family: ui-monospace, monospace;
			font-size: 0.65rem;
			font-weight: 700;
			color: #64748b;
			letter-spacing: 0.15em;
			margin-bottom: 0.75rem;
		}

		.mobile-lang-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 0.5rem;
		}

		.mobile-lang-pill {
			display: flex;
			flex-direction: column;
			padding: 0.6rem 0.8rem;
			background: rgba(255, 255, 255, 0.03);
			border: 1px solid rgba(255, 255, 255, 0.07);
			border-radius: 10px;
			text-decoration: none;
			transition: all 0.2s ease;
		}

		.mobile-lang-pill .m-code {
			font-family: ui-monospace, monospace;
			font-size: 0.72rem;
			font-weight: 800;
			color: #94a3b8;
		}

		.mobile-lang-pill .m-name {
			font-size: 0.75rem;
			color: #64748b;
			margin-top: 2px;
		}

		.mobile-lang-pill.is-active {
			background: rgba(0, 245, 160, 0.1);
			border-color: rgba(0, 245, 160, 0.3);
		}

		.mobile-lang-pill.is-active .m-code,
		.mobile-lang-pill.is-active .m-name {
			color: #00f5a0;
		}

		/* Mobile CTA Section */
		.mobile-cta-wrap {
			display: block;
			padding: 1.5rem 1.25rem 2rem;
			margin-top: auto;
		}

		.mobile-cta-wrap .qct-pill-cta {
			width: 100%;
			height: 44px;
			justify-content: center;
			font-size: 0.8rem;
		}
	}
</style>
