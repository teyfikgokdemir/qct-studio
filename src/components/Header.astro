---
import { useTranslations, languages, getHomeUrl } from '../i18n';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const langCodes = Object.keys(languages);
---
<header class="qct-header">
<div class="container qct-header__inner">
<a href={getHomeUrl(lang)} class="qct-header__logo">QCT Studio</a>
<nav class="qct-header__nav">
<a href="#services">{t('Services')}</a>
<a href="#about">{t('About')}</a>
<a href="#contact">{t('Contact')}</a>
</nav>
<div class="qct-header__lang">
{langCodes.map((code) => {
  const isActive = code === lang;
  const linkClass = isActive ? 'qct-header__lang-link active' : 'qct-header__lang-link';
  return <a href={getHomeUrl(code)} class={linkClass}>{code.toUpperCase()}</a>;
})}
</div>
</div>
</header>
<style>
.qct-header {
position: sticky;
top: 0;
z-index: 50;
background: rgba(13, 13, 13, 0.85);
backdrop-filter: blur(8px);
border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
.qct-header__inner {
display: flex;
align-items: center;
justify-content: space-between;
padding-block: 1rem;
gap: 1.5rem;
}
.qct-header__logo {
color: var(--qct-fg);
font-weight: 700;
text-decoration: none;
letter-spacing: 0.02em;
}
.qct-header__nav {
display: flex;
gap: 1.5rem;
}
.qct-header__nav a {
color: var(--qct-fg);
text-decoration: none;
font-size: 0.95rem;
opacity: 0.85;
}
.qct-header__nav a:hover {
opacity: 1;
color: var(--qct-accent);
}
.qct-header__lang {
display: flex;
gap: 0.75rem;
}
.qct-header__lang-link {
color: var(--qct-fg);
text-decoration: none;
font-size: 0.85rem;
opacity: 0.6;
}
.qct-header__lang-link:hover {
opacity: 1;
}
.qct-header__lang-link.active {
opacity: 1;
color: var(--qct-accent);
font-weight: 600;
}
</style>
