---
import { useTranslations, getLocalizedUrl, getPathWithoutLocale, languages, languageNames } from '../i18n';

interface Props {
  lang: string;
  languagePath?: string;
}
const { lang, languagePath } = Astro.props;
const t = useTranslations(lang);
const url = (path: string) => getLocalizedUrl(lang, path);

// Path of the current page with any locale prefix stripped, e.g. "/sq/about/" -> "/about/".
// Used so the language switcher links to the translated version of THIS page, not just home.
const currentPath = languagePath ?? getPathWithoutLocale(Astro.url.pathname);
const normalizePath = (path: string) => path === '/' ? '/' : `/${path.split('/').filter(Boolean).join('/')}/`;
const normalizedCurrentPath = normalizePath(currentPath);
const isCurrent = (path: string) => normalizedCurrentPath === normalizePath(path);
const isWorkSection = normalizedCurrentPath.startsWith('/work/');
const servicePaths = ['/services/', '/website-design/', '/e-commerce/', '/whatsapp-commerce/', '/seo-performance/', '/meta-ads-landing-pages/', '/ai-automation/'];
const isServicesSection = servicePaths.some((path) => isCurrent(path));
---
<header id="masthead" class="site-header" data-site-header>
	<div class="site-header__inner container">
		<div class="site-branding">
			<a class="site-title" href={url('/')} rel="home">{t('QCT Studio')}</a>
		</div>

		<button class="site-menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" data-menu-toggle>
			<span class="screen-reader-text">{t('Open menu')}</span>
			<span class="site-menu-toggle__bar"></span>
			<span class="site-menu-toggle__bar"></span>
		</button>

		<nav id="site-navigation" class="main-navigation" aria-label={t('Primary menu')}>
			<ul class="primary-menu">
				<li><a href={url('/')} aria-current={isCurrent('/') ? 'page' : undefined}>{t('Home')}</a></li>
				<li><a href={url('/about/')} aria-current={isCurrent('/about/') ? 'page' : undefined}>{t('About')}</a></li>
				<li class="menu-item-has-children">
					<button class="submenu-toggle" type="button" aria-expanded="false" data-submenu-toggle data-current={isWorkSection ? 'true' : undefined}>
						<span>{t('Work')}</span>
					</button>
					<ul class="sub-menu">
						<li><a href={url('/work/')} aria-current={isCurrent('/work/') ? 'page' : undefined}>{t('View Our Work')}</a></li>
						<li><a href={url('/contact/')} aria-current={isCurrent('/contact/') ? 'page' : undefined}>{t('Talk to Our Team')}</a></li>
					</ul>
				</li>
				<li class="menu-item-has-children">
					<button class="submenu-toggle" type="button" aria-expanded="false" data-submenu-toggle data-current={isServicesSection ? 'true' : undefined}>
						<span>{t('Services')}</span>
					</button>
					<ul class="sub-menu">
						<li><a href={url('/services/')} aria-current={isCurrent('/services/') ? 'page' : undefined}>{t('Services overview')}</a></li>
						<li><a href={url('/website-design/')} aria-current={isCurrent('/website-design/') ? 'page' : undefined}>{t('Website Design')}</a></li>
						<li><a href={url('/e-commerce/')} aria-current={isCurrent('/e-commerce/') ? 'page' : undefined}>{t('E-commerce')}</a></li>
						<li><a href={url('/whatsapp-commerce/')} aria-current={isCurrent('/whatsapp-commerce/') ? 'page' : undefined}>{t('WhatsApp Commerce')}</a></li>
						<li><a href={url('/seo-performance/')} aria-current={isCurrent('/seo-performance/') ? 'page' : undefined}>{t('SEO & Performance')}</a></li>
						<li><a href={url('/meta-ads-landing-pages/')} aria-current={isCurrent('/meta-ads-landing-pages/') ? 'page' : undefined}>{t('Meta Ads Landing Pages')}</a></li>
						<li><a href={url('/ai-automation/')} aria-current={isCurrent('/ai-automation/') ? 'page' : undefined}>{t('AI Automation')}</a></li>
					</ul>
				</li>
				<li><a href={url('/careers/')} aria-current={isCurrent('/careers/') ? 'page' : undefined}>{t('Careers')}</a></li>
				<li><a href={url('/contact/')} aria-current={isCurrent('/contact/') ? 'page' : undefined}>{t('Contact')}</a></li>
			</ul>

			<div class="site-language-switcher">
				{Object.entries(languages).map(([code, label]) => (
					<a
						href={getLocalizedUrl(code, currentPath)}
						aria-current={code === lang ? 'true' : undefined}
						hreflang={code}
						lang={code}
						aria-label={`${languageNames[code as keyof typeof languageNames]} (${label})`}
					>{label}</a>
				))}
			</div>
		</nav>
	</div>
</header>
<button class="site-menu-backdrop" type="button" tabindex="-1" aria-hidden="true" data-menu-backdrop></button>
