---
import { marketLanguages, type MarketLang } from '../../../data/marketHubs';

export function getStaticPaths() {
  return marketLanguages.filter((lang) => lang !== 'en').map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props { lang: MarketLang }
const { lang } = Astro.props;

return Astro.redirect(`/${lang}/#project-estimator`, 301);
---
