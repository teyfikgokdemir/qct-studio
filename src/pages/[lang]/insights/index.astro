---
import InsightsPage from '../../../components/InsightsPage.astro';
import { languages } from '../../../i18n';

export function getStaticPaths() {
  return Object.keys(languages).filter((lang) => lang !== 'en').map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
---
<InsightsPage lang={lang} />
