---
import InsightPost from '../../../../components/InsightPost.astro';
import { insights } from '../../../../data/insights';


export function getStaticPaths() {
  return ['sq', 'mk', 'sr'].flatMap((lang) => insights.map((article) => ({ params: { lang, slug: article.slug }, props: { lang, article } })));
}
const { lang, article } = Astro.props;
---
<InsightPost lang={lang} article={article} />
