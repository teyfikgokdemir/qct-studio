---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Page Not Found — QCT Studio"
  description="The page you requested could not be found."
  lang="en"
  noindex={true}
  pageType="WebPage"
>
  <Header slot="header" lang="en" languagePath="/" />

  <section class="qct-error-page">
    <div class="qct-error-page__glow" aria-hidden="true"></div>
    <div class="container qct-error-page__container">
      <div class="qct-error-page__badge">
        <span class="qct-error-page__dot"></span>
        <span class="qct-error-page__code">404 ERROR</span>
      </div>
      <h1 class="qct-error-page__title">This page could not be found.</h1>
      <p class="qct-error-page__lead">The address may have changed, or the page may no longer exist.</p>

      <div class="qct-error-page__actions">
        <a class="qct-btn-primary" href="/">Return home</a>
        <a class="qct-btn-ghost" href="/#services">View services</a>
        <a class="qct-btn-ghost" href="/#contact">Contact QCT Studio</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .qct-error-page {
    min-height: 75vh;
    display: grid;
    place-items: center;
    padding: clamp(8rem, 14vw, 12rem) 0 6rem;
    text-align: center;
    background: #07080b !important;
    position: relative;
    overflow: hidden;
  }

  .qct-error-page__glow {
    position: absolute;
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    width: min(800px, 90vw);
    height: 400px;
    background: radial-gradient(circle at 50% 50%, rgba(0, 245, 160, 0.06), transparent 70%);
    pointer-events: none;
  }

  .qct-error-page__container {
    position: relative;
    z-index: 1;
    max-width: 740px;
  }

  .qct-error-page__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid rgba(0, 245, 160, 0.25);
    background: rgba(0, 245, 160, 0.05);
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }

  .qct-error-page__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00f5a0;
    box-shadow: 0 0 8px #00f5a0;
  }

  .qct-error-page__code {
    margin: 0;
    color: #00f5a0;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .qct-error-page__title {
    margin: 0 auto;
    color: #ffffff;
    font-size: clamp(2.1rem, 3.8vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 800;
  }

  .qct-error-page__lead {
    max-width: 540px;
    margin: 1.25rem auto 0;
    color: #94a3b8;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .qct-error-page__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2.5rem;
  }

  .qct-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1.5rem;
    background: #00f5a0;
    color: #07080b;
    border-radius: 9999px;
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
    box-shadow: 0 0 20px rgba(0, 245, 160, 0.3);
    transition: all 0.2s ease;
  }

  .qct-btn-primary:hover {
    background: #22f8ab;
    box-shadow: 0 0 30px rgba(0, 245, 160, 0.5);
    transform: translateY(-2px);
  }

  .qct-btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1.4rem;
    background: rgba(255, 255, 255, 0.04);
    color: #cbd5e1;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    font-size: 0.84rem;
    font-weight: 650;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .qct-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
    transform: translateY(-2px);
  }
</style>
